@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthService Auth
@inject IJSRuntime JS
@implements IDisposable

<div class="layout @(_sidebarOpen ? "menu-open" : "")">
    <div class="sidebar-overlay" @onclick="ToggleSidebar"></div>

    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo">⚡</div>
            <div class="sidebar-title">انرژی‌کال</div>
            <div class="sidebar-sub">سیستم پایش هوشمند</div>
        </div>
        @if (Auth.IsLoggedIn)
        {
            <div class="sidebar-user">
                <span class="user-name">@Auth.CurrentUser!.Username</span>
                <span class="user-role">@Auth.CurrentUser.Role</span>
            </div>
        }
        <nav class="sidebar-nav">
            <a href="/dashboard" class="nav-item @(IsActive("/dashboard") ? "active" : "")">
                <span class="nav-icon">🏠</span>
                <span class="nav-text">داشبورد اصلی</span>
            </a>
            @if (Auth.IsInRole("Admin"))
            {
                @foreach (var cat in _categories)
                {
                    var anyActive = cat.Paths.Any(p => Nav.Uri.Contains(p));
                    var isOpen = _openCategories.Contains(cat.Key);
                    <button class="nav-cat @(anyActive ? "nav-cat--active" : "")" @onclick="() => ToggleCategory(cat.Key)" type="button">
                        <span class="nav-cat-icon">@cat.Icon</span>
                        <span class="nav-cat-text">@cat.Label</span>
                        <span class="nav-cat-chevron @(isOpen ? "nav-cat-chevron--open" : "")">◀</span>
                    </button>
                    <div class="nav-sub @(isOpen ? "nav-sub--open" : "")">
                        @foreach (var link in cat.Links)
                        {
                            <a href="@link.Href" class="nav-item nav-sub-item @(IsActive(link.Href) ? "active" : "")">
                                <span class="nav-icon">@link.Icon</span><span class="nav-text">@link.Text</span>
                            </a>
                        }
                    </div>
                }

                @if (Auth.CurrentUser?.Role == "SuperAdmin")
                {
                    var sysCat = _sysCategory;
                    var sysActive = sysCat.Paths.Any(p => Nav.Uri.Contains(p));
                    var sysOpen = _openCategories.Contains(sysCat.Key);
                    <button class="nav-cat @(sysActive ? "nav-cat--active" : "")" @onclick="() => ToggleCategory(sysCat.Key)" type="button">
                        <span class="nav-cat-icon">@sysCat.Icon</span>
                        <span class="nav-cat-text">@sysCat.Label</span>
                        <span class="nav-cat-chevron @(sysOpen ? "nav-cat-chevron--open" : "")">◀</span>
                    </button>
                    <div class="nav-sub @(sysOpen ? "nav-sub--open" : "")">
                        @foreach (var link in sysCat.Links)
                        {
                            <a href="@link.Href" class="nav-item nav-sub-item @(IsActive(link.Href) ? "active" : "")">
                                <span class="nav-icon">@link.Icon</span><span class="nav-text">@link.Text</span>
                            </a>
                        }
                    </div>
                }
            }
            else if (Auth.IsLoggedIn)
            {
                <a href="/centers" class="nav-item @(IsActive("/centers") ? "active" : "")">
                    <span class="nav-icon">🏢</span><span class="nav-text">مراکز</span>
                </a>
                <a href="/billing" class="nav-item @(IsActive("/billing") ? "active" : "")">
                    <span class="nav-icon">🧾</span><span class="nav-text">صورتحساب</span>
                </a>
            }
        </nav>
        <div class="sidebar-footer">
            @if (Auth.IsLoggedIn)
            {
                <button class="btn btn-logout" @onclick="Logout">خروج</button>
            }
            <div class="sidebar-version">v3.0</div>
        </div>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <button class="hamburger" @onclick="ToggleSidebar" aria-label="منو">
                <span></span><span></span><span></span>
            </button>
            <div class="topbar-title">@_pageTitle</div>
            <div class="topbar-datetime">
                <span class="topbar-clock" id="clock-display">--:--:--</span>
                <span class="topbar-date" id="date-display">----/--/--</span>
            </div>
        </header>

        <div class="content-area">
            @Body
        </div>
    </main>

    @* Bottom Navigation — Mobile *@
    <nav class="bottom-nav">
        <a href="/dashboard" class="bottom-nav-item @(IsActive("/dashboard") ? "active" : "")">
            <span class="bn-icon">🏠</span>
            <span class="bn-label">خانه</span>
        </a>
        @if (Auth.IsInRole("Admin"))
        {
            <a href="/devices" class="bottom-nav-item @(IsActive("/devices") ? "active" : "")">
                <span class="bn-icon">📟</span>
                <span class="bn-label">دستگاه‌ها</span>
            </a>
            <a href="/alarms" class="bottom-nav-item @(IsActive("/alarms") ? "active" : "")">
                <span class="bn-icon">🔔</span>
                <span class="bn-label">هشدارها</span>
            </a>
            <a href="/billing" class="bottom-nav-item @(IsActive("/billing") ? "active" : "")">
                <span class="bn-icon">🧾</span>
                <span class="bn-label">صورتحساب</span>
            </a>
        }
        else
        {
            <a href="/centers" class="bottom-nav-item @(IsActive("/centers") ? "active" : "")">
                <span class="bn-icon">🏢</span>
                <span class="bn-label">مراکز</span>
            </a>
            <a href="/billing" class="bottom-nav-item @(IsActive("/billing") ? "active" : "")">
                <span class="bn-icon">🧾</span>
                <span class="bn-label">صورتحساب</span>
            </a>
        }
    </nav>
</div>

<Toast />

@code {
    private bool _sidebarOpen = false;
    private string _pageTitle = "داشبورد";
    private HashSet<string> _openCategories = new();

    private bool IsCategoryOpen(string key) => _openCategories.Contains(key);

    private void ToggleCategory(string key)
    {
        if (!_openCategories.Remove(key)) _openCategories.Add(key);
    }

    private record NavLink(string Icon, string Text, string Href);
    private record NavCategory(string Icon, string Label, string Key, string[] Paths, NavLink[] Links);

    private List<NavCategory> _categories => new()
    {
        new("🏛️", "مدیریت مکان", "loc",
            new string[] { "/regions", "/provinces", "/cities", "/centers" },
            new NavLink[] {
                new("🗺️", "مناطق", "/regions"),
                new("📍", "استان‌ها", "/provinces"),
                new("🏙️", "شهرها", "/cities"),
                new("🏢", "مراکز", "/centers")
            }),
        new("📟", "مدیریت دستگاه", "dev",
            new string[] { "/device-groups", "/devices", "/config" },
            new NavLink[] {
                new("📁", "گروه دستگاه", "/device-groups"),
                new("📟", "مدیریت دستگاه‌ها", "/devices"),
                new("⚙", "تنظیمات دستگاه", "/config")
            }),
        new("🔔", "پایش و هشدار", "mon",
            new string[] { "/monitoring", "/alarms", "/reports", "/limits" },
            new NavLink[] {
                new("📊", "پایش انرژی", "/monitoring"),
                new("🔔", "مدیریت هشدارها", "/alarms"),
                new("📈", "گزارش مصرف", "/reports"),
                new("⛔", "محدودیت مصرف", "/limits")
            }),
        new("🧾", "صورتحساب", "bil",
            new string[] { "/billing", "/billing/tariffs" },
            new NavLink[] {
                new("💰", "مدیریت تعرفه‌ها", "/billing/tariffs"),
                new("🧾", "صورتحساب", "/billing")
            }),
        new("📰", "مدیریت محتوا", "cnt",
            new string[] { "/news/manage", "/sliders/manage" },
            new NavLink[] {
                new("📰", "مدیریت اخبار", "/news/manage"),
                new("🖼", "مدیریت اسلایدر", "/sliders/manage")
            })
    };

    private NavCategory _sysCategory => new("👥", "مدیریت سیستم", "sys",
        new string[] { "/users" },
        new NavLink[] { new("👥", "مدیریت کاربران", "/users") });

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        Auth.StateChanged += OnAuthStateChanged;
        UpdateTitle();
        await Task.Delay(100);
        if (!Auth.IsLoggedIn && IsProtectedPage())
            Nav.NavigateTo("/login", true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var width = await JS.InvokeAsync<int>("getViewportWidth");
            if (width < 768) _sidebarOpen = false;
            StateHasChanged();
        }
    }

    private bool IsActive(string path)
    {
        var uri = Nav.Uri.TrimEnd('/');
        var p = path.TrimEnd('/');
        return uri == p || uri.StartsWith(p + "/") || uri.Contains("/" + p + "/");
    }

    private bool IsProtectedPage()
    {
        var uri = Nav.Uri;
        return uri.Contains("/dashboard") || uri.Contains("/monitoring") || uri.Contains("/centers") || uri.Contains("/devices") || uri.Contains("/config")
            || uri.Contains("/alarms") || uri.Contains("/billing") || uri.Contains("/reports")
            || uri.Contains("/limits") || uri.Contains("/news") || uri.Contains("/sliders")
            || uri.Contains("/regions") || uri.Contains("/provinces") || uri.Contains("/cities")
            || uri.Contains("/device-groups") || uri.Contains("/users");
    }

    private void OnAuthStateChanged() => StateHasChanged();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _sidebarOpen = false;
        UpdateTitle();
        if (!Auth.IsLoggedIn && IsProtectedPage())
            Nav.NavigateTo("/login", true);
        StateHasChanged();
    }

    private void UpdateTitle()
    {
        var uri = Nav.Uri;
        if (uri.Contains("/users")) _pageTitle = "مدیریت کاربران";
        else if (uri.Contains("/regions")) _pageTitle = "مناطق";
        else if (uri.Contains("/provinces")) _pageTitle = "استان‌ها";
        else if (uri.Contains("/cities")) _pageTitle = "شهرها";
        else if (uri.Contains("/device-groups")) _pageTitle = "گروه‌های دستگاه";
        else if (uri.Contains("/news/manage")) _pageTitle = "مدیریت اخبار";
        else if (uri.Contains("/sliders")) _pageTitle = "اسلایدر";
        else if (uri.Contains("/billing/tariffs")) _pageTitle = "تعرفه‌ها";
        else if (uri.Contains("/billing")) _pageTitle = "صورتحساب";
        else if (uri.Contains("/centers")) _pageTitle = "مراکز";
        else if (uri.Contains("/devices")) _pageTitle = "دستگاه‌ها";
        else if (uri.Contains("/config")) _pageTitle = "تنظیمات";
        else if (uri.Contains("/alarms")) _pageTitle = "هشدارها";
        else if (uri.Contains("/reports")) _pageTitle = "گزارش مصرف";
        else if (uri.Contains("/limits")) _pageTitle = "محدودیت مصرف";
        else if (uri.Contains("/monitoring")) _pageTitle = "پایش انرژی";
        else if (uri.Contains("/dashboard")) _pageTitle = "داشبورد";
        else _pageTitle = "داشبورد";
    }

    private async Task Logout() => await Auth.LogoutAsync();

    private async Task ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
        await JS.InvokeVoidAsync("closeSummary");
    }
    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Auth.StateChanged -= OnAuthStateChanged;
    }
}
