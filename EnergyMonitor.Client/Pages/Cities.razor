@page "/cities"
@using System.Net.Http.Json
@inject HttpClient Http
@inject AuthService Auth
@inject ToastService Toast

@if (Auth.IsInRole("Admin"))
{
<div class="page-container">
    <div class="page-toolbar">
        <h2>مدیریت شهرها</h2>
        <button class="btn btn-primary" @onclick="OpenCreate">+ شهر جدید</button>
    </div>

    <PrereqAlert Met="(_provinces.Count > 0)"
        Title="هنوز استانی ثبت نشده"
        Text="برای ثبت شهر، ابتدا باید یک استان ایجاد کنید. به صفحه استان‌ها بروید و استان مورد نظر را ثبت کنید."
        LinkText="رفتن به مدیریت استان‌ها"
        LinkHref="/provinces" />

    <HelpBox>
        <p><strong>شهر</strong> سومین سطح جغرافیایی است. هر شهر به یک استان متصل می‌شود.</p>
        <div class="hlp-step"><span class="hlp-step-num">۱</span><span class="hlp-step-text">ابتدا <strong>استان</strong> مربوطه را قبلاً ایجاد کرده باشید.</span></div>
        <div class="hlp-step"><span class="hlp-step-num">۲</span><span class="hlp-step-text">نام شهر و استان مربوطه را انتخاب کنید — کد به صورت خودکار تولید می‌شود.</span></div>
        <div class="hlp-step"><span class="hlp-step-num">۳</span><span class="hlp-step-text">پس از ثبت شهرها، به بخش <strong>مراکز</strong> بروید و مرکز را به این شهر متصل کنید.</span></div>
        <div class="hlp-tip">💡 یک استان می‌تواند چندین شهر داشته باشد.</div>
    </HelpBox>

    @if (_loading) { <div class="loading-state"><div class="spinner"></div></div> }
    else if (_items.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🏙️</div>
            <div class="empty-title">شهری ثبت نشده</div>
        </div>
    }
    else
    {
        <div class="card-list">
            @foreach (var item in _items)
            {
                <div class="card-item">
                    <div class="card-hdr">
                        <strong>@item.Name</strong>
                        <span class="card-tag @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "فعال" : "غیرفعال")</span>
                    </div>
                    <div class="card-body">
                        <div class="card-row"><span>کد</span><span class="ltr">@item.Code</span></div>
                        <div class="card-row"><span>استان</span><span>@item.ProvinceName</span></div>
                    </div>
                    <div class="card-actions">
                        <button class="card-btn primary" @onclick="() => OpenEdit(item)">ویرایش</button>
                        <button class="card-btn danger" @onclick="() => ConfirmDelete(item)">حذف</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation>
            <div class="modal-hdr">
                <h3>@(_editingId == Guid.Empty ? "شهر جدید" : "ویرایش شهر")</h3>
                <button class="modal-close" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-row"><label>استان</label><select class="form-input" @bind="_form.ProvinceId"><option value="">انتخاب کنید</option>@foreach (var p in _provinces) { <option value="@p.Id">@p.Name</option> }</select></div>
                <div class="form-row"><label>نام</label><input @bind="_form.Name" class="form-input" /></div>
                <div class="form-row"><label>کد</label><input @bind="_form.Code" class="form-input ltr" disabled /></div>
                <div class="form-row"><label>فعال</label><label class="tgl"><input type="checkbox" @bind="_form.IsActive" /><span class="sl"></span></label></div>
            </div>
            <div class="modal-ftr">
                <button class="btn btn-secondary" @onclick="CloseModal">انصراف</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@_saving">@(_saving ? "..." : "ذخیره")</button>
            </div>
        </div>
    </div>
}

@if (_deleteTarget is not null)
{
    <div class="modal-overlay" @onclick="() => _deleteTarget = null">
        <div class="modal-card" @onclick:stopPropagation>
            <div class="modal-hdr"><h3>حذف شهر</h3><button class="modal-close" @onclick="() => _deleteTarget = null">&times;</button></div>
            <div class="modal-body"><p>آیا از حذف <strong>@_deleteTarget.Name</strong> اطمینان دارید؟</p></div>
            <div class="modal-ftr">
                <button class="btn btn-secondary" @onclick="() => _deleteTarget = null">انصراف</button>
                <button class="btn btn-danger" @onclick="DeleteItem">حذف</button>
            </div>
        </div>
    </div>
}
}
else
{
    <div style="text-align:center;padding:4rem 1rem;color:#888">
        <h3>🔒 دسترسی محدود</h3>
        <p>فقط مدیران می‌توانند به این بخش دسترسی داشته باشند.</p>
        <a href="/dashboard" class="btn-link">بازگشت به داشبورد</a>
    </div>
}

@code {
    private List<CityItem> _items = new();
    private List<ProvinceItem> _provinces = new();
    private bool _loading = true, _saving, _showModal;
    private Guid _editingId;
    private CityForm _form = new();
    private CityItem? _deleteTarget;

    protected override async Task OnInitializedAsync() { if (Auth.IsInRole("Admin")) await Load(); }
    private async Task Load()
    {
        _loading = true; StateHasChanged();
        try
        {
            var provincesTask = Http.GetFromJsonAsync<List<ProvinceItem>>("api/v2/provinces");
            var citiesTask = Http.GetFromJsonAsync<List<CityItem>>("api/v2/cities");
            await Task.WhenAll(provincesTask, citiesTask);
            _provinces = provincesTask.Result ?? new();
            _items = citiesTask.Result?.Select(c =>
            {
                var prov = _provinces.FirstOrDefault(p => p.Id == c.ProvinceId);
                return new CityItem { Id = c.Id, Name = c.Name, Code = c.Code, ProvinceId = c.ProvinceId, ProvinceName = prov?.Name ?? "---", IsActive = c.IsActive };
            }).ToList() ?? new();
        }
        catch { Toast.ShowError("خطا در دریافت اطلاعات"); }
        finally { _loading = false; StateHasChanged(); }
    }
    private void OpenCreate() { _editingId = Guid.Empty; _form = new CityForm { Code = NextCityCode() }; _showModal = true; }
    private void OpenEdit(CityItem c) { _editingId = c.Id; _form = new CityForm { Name = c.Name, Code = c.Code, ProvinceId = c.ProvinceId, IsActive = c.IsActive }; _showModal = true; }
    private string NextCityCode() { var m = 0; foreach (var x in _items) { if (x.Code.StartsWith("C-") && int.TryParse(x.Code[2..], out var n) && n > m) m = n; } return $"C-{m + 1:D3}"; }
    private void CloseModal() => _showModal = false;
    private void ConfirmDelete(CityItem c) => _deleteTarget = c;
    private async Task Save()
    {
        _saving = true;
        try
        {
            HttpResponseMessage resp;
            if (_editingId == Guid.Empty) resp = await Http.PostAsJsonAsync("api/v2/cities", _form);
            else resp = await Http.PutAsJsonAsync($"api/v2/cities/{_editingId}", _form);
            if (resp.IsSuccessStatusCode) { _showModal = false; Toast.ShowSuccess("ذخیره شد"); await Load(); }
            else { var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); Toast.ShowError(err?.GetValueOrDefault("error") ?? "خطا"); }
        }
        catch { Toast.ShowError("خطا در ارتباط با سرور"); }
        finally { _saving = false; }
    }
    private async Task DeleteItem()
    {
        if (_deleteTarget is null) return;
        try { await Http.DeleteAsync($"api/v2/cities/{_deleteTarget.Id}"); _deleteTarget = null; Toast.ShowSuccess("حذف شد"); await Load(); }
        catch { Toast.ShowError("خطا در حذف"); }
    }

    public class CityItem { public Guid Id { get; set; } public string Name { get; set; } = ""; public string Code { get; set; } = ""; public Guid ProvinceId { get; set; } public string ProvinceName { get; set; } = ""; public bool IsActive { get; set; } = true; }
    public class CityForm { public string Name { get; set; } = ""; public string Code { get; set; } = ""; public Guid ProvinceId { get; set; } public bool IsActive { get; set; } = true; }
    public class ProvinceItem { public Guid Id { get; set; } public string Name { get; set; } = ""; public string Code { get; set; } = ""; }
}
