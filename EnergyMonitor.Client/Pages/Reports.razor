@page "/reports"
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthService Auth
@inject ToastService Toast

<div class="page-container">
    <div class="page-toolbar">
        <h2>گزارش‌ها</h2>
    </div>

    <PrereqAlert Met="(_centers.Count > 0)"
        Title="هنوز مرکزی ثبت نشده"
        Text="برای مشاهده گزارش، ابتدا باید یک مرکز ایجاد کنید."
        LinkText="رفتن به مدیریت مراکز"
        LinkHref="/centers" />

    <HelpBox>
        <p><strong>گزارش‌ها</strong> مصرف انرژی را بر اساس مرکز و بازه زمانی نمایش می‌دهند.</p>
        <div class="hlp-step"><span class="hlp-step-num">۱</span><span class="hlp-step-text">مرکز مورد نظر را انتخاب کنید.</span></div>
        <div class="hlp-step"><span class="hlp-step-num">۲</span><span class="hlp-step-text">بازه زمانی (از تاریخ / تا تاریخ) را انتخاب کنید.</span></div>
        <div class="hlp-step"><span class="hlp-step-num">۳</span><span class="hlp-step-text">روی دکمه جستجو کلیک کنید تا گزارش نمایش داده شود.</span></div>
        <div class="hlp-tip">💡 می‌توانید گزارش را به صورت PDF خروجی بگیرید.</div>
    </HelpBox>

    <div class="rpt-filters">
        <div class="rpt-filters-row">
            <div class="rpt-fg">
                <label class="rpt-fl">مرکز</label>
                <select class="form-select" value="@_selectedCenterId" @onchange="OnCenterChange">
                    @foreach (var c in _centers)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="rpt-fg">
                <label class="rpt-fl">از تاریخ</label>
                <input data-jdp class="rpt-fi" id="rptFrom" value="@_rptFrom" />
            </div>
            <div class="rpt-fg">
                <label class="rpt-fl">تا تاریخ</label>
                <input data-jdp class="rpt-fi" id="rptTo" value="@_rptTo" />
            </div>
            <div class="rpt-fg rpt-fg-btn">
                <button class="rpt-btn" @onclick="LoadData" disabled="@_loading">
                    @if (_loading) { <span class="spinner-sm"></span> } else { <span>📊</span> }
                    <span>@(_loading ? "در حال بارگذاری..." : "نمایش گزارش")</span>
                </button>
            </div>
        </div>
    </div>

    @if (_error != null)
    {
        <div class="rpt-empty">
            <div class="rpt-empty-icon">⚠️</div>
            <div class="rpt-empty-title">خطا در بارگذاری</div>
            <div class="rpt-empty-hint">@_error</div>
        </div>
    }
    else if (_loaded && (_dailyData == null || _dailyData.Count == 0))
    {
        <div class="rpt-empty">
            <div class="rpt-empty-icon">📭</div>
            <div class="rpt-empty-title">داده‌ای وجود ندارد</div>
            <div class="rpt-empty-hint">برای بازه انتخابی هیچ مصرفی ثبت نشده است</div>
        </div>
    }
    else if (_dailyData != null && _dailyData.Count > 0)
    {
        <div class="rpt-kpis">
            <div class="rpt-kpi">
                <div class="rpt-kpi-icon">⚡</div>
                <div class="rpt-kpi-body">
                    <div class="rpt-kpi-val">@_totalKWh.ToString("N1")</div>
                    <div class="rpt-kpi-lbl">مصرف کل (kWh)</div>
                </div>
            </div>
            <div class="rpt-kpi">
                <div class="rpt-kpi-icon" style="background:var(--blue-bg);color:var(--blue)">📊</div>
                <div class="rpt-kpi-body">
                    <div class="rpt-kpi-val">@_avgDaily.ToString("N1")</div>
                    <div class="rpt-kpi-lbl">میانگین روزانه (kWh)</div>
                </div>
            </div>
            <div class="rpt-kpi">
                <div class="rpt-kpi-icon" style="background:var(--red-bg);color:var(--red)">🔥</div>
                <div class="rpt-kpi-body">
                    <div class="rpt-kpi-val">@_peakDayKWh.ToString("N1")</div>
                    <div class="rpt-kpi-lbl">پیک روزانه (kWh)</div>
                    <div class="rpt-kpi-sub">@_peakDayDate</div>
                </div>
            </div>
            <div class="rpt-kpi">
                <div class="rpt-kpi-icon" style="background:var(--green-bg);color:var(--green)">📅</div>
                <div class="rpt-kpi-body">
                    <div class="rpt-kpi-val">@_dayCount</div>
                    <div class="rpt-kpi-lbl">تعداد روزها</div>
                </div>
            </div>
        </div>

        <div class="rpt-card">
            <div class="rpt-card-hdr">
                <span class="rpt-card-hdr-icon">📈</span>
                <h3>روند مصرف روزانه</h3>
                <span class="rpt-card-hdr-unit">kWh</span>
            </div>
            <div class="rpt-chart-wrap">
                <canvas id="rptDailyChart"></canvas>
            </div>
        </div>

        <div class="rpt-card">
            <div class="rpt-card-hdr">
                <span class="rpt-card-hdr-icon">🔌</span>
                <h3>تفکیک فازها</h3>
                <span class="rpt-card-hdr-unit">kWh</span>
            </div>
            @{
                var totalA = _dailyData.Sum(d => d.phaseAKWh);
                var totalB = _dailyData.Sum(d => d.phaseBKWh);
                var totalC = _dailyData.Sum(d => d.phaseCKWh);
                var totalAll = totalA + totalB + totalC;
                var pctA = totalAll > 0 ? totalA / totalAll * 100 : 0;
                var pctB = totalAll > 0 ? totalB / totalAll * 100 : 0;
                var pctC = totalAll > 0 ? totalC / totalAll * 100 : 0;
            }
            <div class="rpt-phase-summary">
                <div class="rpt-phase-stat">
                    <div class="rpt-ps-dot" style="background:#f97316;box-shadow:0 0 8px rgba(249,115,22,.4)"></div>
                    <div class="rpt-ps-body">
                        <div class="rpt-ps-val">@totalA.ToString("N1")</div>
                        <div class="rpt-ps-lbl">فاز A</div>
                    </div>
                    <div class="rpt-ps-pct">@pctA.ToString("F1")%</div>
                </div>
                <div class="rpt-phase-stat">
                    <div class="rpt-ps-dot" style="background:#3b82f6;box-shadow:0 0 8px rgba(59,130,246,.4)"></div>
                    <div class="rpt-ps-body">
                        <div class="rpt-ps-val">@totalB.ToString("N1")</div>
                        <div class="rpt-ps-lbl">فاز B</div>
                    </div>
                    <div class="rpt-ps-pct">@pctB.ToString("F1")%</div>
                </div>
                <div class="rpt-phase-stat">
                    <div class="rpt-ps-dot" style="background:#ef4444;box-shadow:0 0 8px rgba(239,68,68,.4)"></div>
                    <div class="rpt-ps-body">
                        <div class="rpt-ps-val">@totalC.ToString("N1")</div>
                        <div class="rpt-ps-lbl">فاز C</div>
                    </div>
                    <div class="rpt-ps-pct">@pctC.ToString("F1")%</div>
                </div>
            </div>
            <div class="rpt-phase-stacked">
                <div class="rpt-psb-track">
                    <div class="rpt-psb-seg" style="flex:@(pctA);background:#f97316" title="فاز A: @pctA.ToString("F1")%"></div>
                    <div class="rpt-psb-seg" style="flex:@(pctB);background:#3b82f6" title="فاز B: @pctB.ToString("F1")%"></div>
                    <div class="rpt-psb-seg" style="flex:@(pctC);background:#ef4444" title="فاز C: @pctC.ToString("F1")%"></div>
                </div>
                <div class="rpt-psb-labels">
                    <span><span class="rpt-psb-dot" style="background:#f97316"></span>فاز A @pctA.ToString("F1")%</span>
                    <span><span class="rpt-psb-dot" style="background:#3b82f6"></span>فاز B @pctB.ToString("F1")%</span>
                    <span><span class="rpt-psb-dot" style="background:#ef4444"></span>فاز C @pctC.ToString("F1")%</span>
                </div>
            </div>
            <div class="rpt-phase-totals">
                <table>
                    <thead>
                        <tr><th>فاز</th><th>مصرف کل (kWh)</th><th>میانگین روزانه</th><th>سهم</th></tr>
                    </thead>
                    <tbody>
                        <tr><td><span class="rpt-psb-dot" style="background:#f97316"></span>فاز A</td><td>@totalA.ToString("N1")</td><td>@(_dayCount > 0 ? (totalA / _dayCount).ToString("N1") : "—")</td><td>@pctA.ToString("F1")%</td></tr>
                        <tr><td><span class="rpt-psb-dot" style="background:#3b82f6"></span>فاز B</td><td>@totalB.ToString("N1")</td><td>@(_dayCount > 0 ? (totalB / _dayCount).ToString("N1") : "—")</td><td>@pctB.ToString("F1")%</td></tr>
                        <tr><td><span class="rpt-psb-dot" style="background:#ef4444"></span>فاز C</td><td>@totalC.ToString("N1")</td><td>@(_dayCount > 0 ? (totalC / _dayCount).ToString("N1") : "—")</td><td>@pctC.ToString("F1")%</td></tr>
                    </tbody>
                    <tfoot>
                        <tr><td><strong>جمع</strong></td><td><strong>@totalAll.ToString("N1")</strong></td><td><strong>@(_dayCount > 0 ? (totalAll / _dayCount).ToString("N1") : "—")</strong></td><td><strong>100%</strong></td></tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="rpt-card">
            <div class="rpt-card-hdr">
                <span class="rpt-card-hdr-icon">📅</span>
                <h3>مقایسه ماهانه</h3>
            </div>
            <div class="rpt-monthly-controls">
                <div class="rpt-fg">
                    <label class="rpt-fl">سال</label>
                    <select class="form-select" value="@_selectedYear" @onchange="OnYearChange">
                        @for (int y = _currentYear; y >= _currentYear - 5; y--)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>
                <div class="rpt-fg">
                    <label class="rpt-fl">مقایسه با</label>
                    <select class="form-select" value="@(_compareYear?.ToString() ?? "")" @onchange="OnCompareYearChange">
                        <option value="">ندارد</option>
                        @for (int y = _currentYear - 1; y >= _currentYear - 5; y--)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>
            </div>
            @if (_monthlyData != null && _monthlyData.Count > 0)
            {
                <div class="rpt-chart-wrap" style="height:200px">
                    <canvas id="rptMonthlyChart"></canvas>
                </div>
            }
        </div>

        <div class="rpt-card">
            <div class="rpt-card-hdr">
                <span class="rpt-card-hdr-icon">⚖️</span>
                <h3>مقایسه دو بازه</h3>
            </div>
            <div class="rpt-compare-grid">
                <div class="rpt-compare-col">
                    <div class="rpt-compare-label">بازه اول</div>
                    <div class="rpt-fg">
                        <label class="rpt-fl">از</label>
                        <input data-jdp class="rpt-fi" id="cmpFrom1" value="@_cmpFrom1" />
                    </div>
                    <div class="rpt-fg">
                        <label class="rpt-fl">تا</label>
                        <input data-jdp class="rpt-fi" id="cmpTo1" value="@_cmpTo1" />
                    </div>
                </div>
                <div class="rpt-compare-vs">
                    <span>VS</span>
                </div>
                <div class="rpt-compare-col">
                    <div class="rpt-compare-label">بازه دوم</div>
                    <div class="rpt-fg">
                        <label class="rpt-fl">از</label>
                        <input data-jdp class="rpt-fi" id="cmpFrom2" value="@_cmpFrom2" />
                    </div>
                    <div class="rpt-fg">
                        <label class="rpt-fl">تا</label>
                        <input data-jdp class="rpt-fi" id="cmpTo2" value="@_cmpTo2" />
                    </div>
                </div>
            </div>
            <button class="rpt-btn rpt-btn-sm" @onclick="Compare" disabled="@_loadingCompare">
                @(_loadingCompare ? "..." : "مقایسه کن")
            </button>

            @if (_comparisonData != null)
            {
                <div class="rpt-cmp-result">
                    <div class="rpt-cmp-row rpt-cmp-hdr">
                        <span></span><span>مصرف (kWh)</span><span>میانگین روزانه</span>
                    </div>
                    <div class="rpt-cmp-row">
                        <span>بازه اول</span>
                        <span class="rpt-cmp-val">@_comparisonData.period1.totalKWh.ToString("N1")</span>
                        <span class="rpt-cmp-val">@(_comparisonData.period1.totalKWh / _dayCount > 0 ? (_comparisonData.period1.totalKWh / _dayCount).ToString("N1") : "—")</span>
                    </div>
                    <div class="rpt-cmp-row">
                        <span>بازه دوم</span>
                        <span class="rpt-cmp-val">@_comparisonData.period2.totalKWh.ToString("N1")</span>
                        <span class="rpt-cmp-val">@(_comparisonData.period2.totalKWh / _dayCount > 0 ? (_comparisonData.period2.totalKWh / _dayCount).ToString("N1") : "—")</span>
                    </div>
                    <div class="rpt-cmp-row rpt-cmp-total">
                        <span>تفاوت</span>
                        <span class="rpt-cmp-val @(_comparisonData.deltaKWh >= 0 ? "up" : "down")">
                            @(_comparisonData.deltaKWh >= 0 ? "↑" : "↓") @Math.Abs(_comparisonData.deltaKWh).ToString("N1")
                        </span>
                        <span class="rpt-cmp-val @(_comparisonData.deltaPercent >= 0 ? "up" : "down")">
                            @(_comparisonData.deltaPercent >= 0 ? "+" : "")@_comparisonData.deltaPercent.ToString("F1")%
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="rpt-card">
            <div class="rpt-card-hdr">
                <span class="rpt-card-hdr-icon">🔥</span>
                <h3>اوج مصرف</h3>
            </div>
            @if (_peakData != null && _peakData.peakKWh > 0)
            {
                <div class="rpt-peak">
                    <div class="rpt-peak-val">@_peakData.peakKWh.ToString("N2") <small>kWh</small></div>
                    <div class="rpt-peak-date">@_peakData.peakDate</div>
                    <div class="rpt-peak-hour">ساعت @_peakData.peakHour:00</div>
                </div>
            }
            else
            {
                <div class="rpt-empty-sm">داده‌ای برای اوج مصرف وجود ندارد</div>
            }
        </div>

        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
            <button class="rpt-btn rpt-btn-outline" @onclick="ExportCsv">
                📥 خروجی CSV
            </button>
        </div>
    }
</div>

@code {
    private List<CenterRef> _centers = new();
    private Guid _selectedCenterId;
    private bool _loading, _loaded, _loadingCompare;
    private string _rptFrom = "", _rptTo = "";
    private string? _error;
    private int _currentYear, _selectedYear;
    private int? _compareYear;
    private string _cmpFrom1 = "", _cmpTo1 = "", _cmpFrom2 = "", _cmpTo2 = "";

    private List<DailyItem> _dailyData;
    private List<MonthlyItem> _monthlyData;
    private PeakItem _peakData;
    private ComparisonData _comparisonData;

    private double _totalKWh, _avgDaily, _peakDayKWh;
    private string _peakDayDate = "";
    private int _dayCount;
    private bool _chartScriptsLoaded;

    protected override async Task OnInitializedAsync()
    {
        try { _centers = await Http.GetFromJsonAsync<List<CenterRef>>("api/v2/centers") ?? new(); } catch { }
        if (!Auth.IsInRole("SuperAdmin") && Auth.CurrentUser?.CenterIds.Count > 0)
        {
            var allowed = Auth.CurrentUser.CenterIds;
            _centers = _centers.Where(c => allowed.Contains(c.Id)).ToList();
        }
        if (_centers.Count > 0) { _selectedCenterId = _centers[0].Id; } else { _error = "هیچ مرکزی یافت نشد"; _loaded = true; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_chartScriptsLoaded)
        {
            // Load Chart.js + charts.js dynamically (same pattern as Dashboard)
            try { await JS.InvokeVoidAsync("eval",
                @"function loadScript(a){return new Promise(function(b,c){var d=document.createElement('script');d.src=a;d.onload=b;d.onerror=c;document.head.appendChild(d)})}
                  loadScript('js/chart.umd.min.js').then(function(){return loadScript('js/charts.js')}).then(function(){window._chartReady=true}).catch(function(){});"); } catch { }
            _chartScriptsLoaded = true;
            await Task.Delay(500);

            var pc = new PersianCalendar();
            var iranTz = TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran");
            var iranNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, iranTz);
            _currentYear = pc.GetYear(iranNow);
            _selectedYear = _currentYear;
            _rptFrom = $"{_currentYear:D4}/01/01";
            _rptTo = $"{pc.GetYear(iranNow):D4}/{pc.GetMonth(iranNow):D2}/{pc.GetDayOfMonth(iranNow):D2}";
            _cmpFrom1 = _rptFrom;
            _cmpTo1 = _rptTo;
            _cmpFrom2 = $"{_currentYear - 1:D4}/01/01";
            _cmpTo2 = $"{_currentYear - 1:D4}/12/29";
            StateHasChanged();
            try { await JS.InvokeVoidAsync("initJalaliDatepicker"); } catch { }
            if (_centers.Count > 0) await LoadData();
        }
    }

    private async Task OnCenterChange(ChangeEventArgs e)
    {
        _selectedCenterId = Guid.Parse(e.Value?.ToString() ?? "");
        await LoadData();
    }

    private async Task OnYearChange(ChangeEventArgs e)
    {
        _selectedYear = int.Parse(e.Value?.ToString() ?? _currentYear.ToString());
        await LoadMonthly();
    }

    private async Task OnCompareYearChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _compareYear = string.IsNullOrEmpty(val) ? null : int.Parse(val);
        await LoadMonthly();
    }

    private async Task LoadData()
    {
        _error = null;
        _dailyData = null; _peakData = null; _comparisonData = null; _monthlyData = null;
        _loaded = false;
        _loading = true; StateHasChanged();
        try
        {
            var from = await JS.InvokeAsync<string>("getDateInput", "rptFrom");
            var to = await JS.InvokeAsync<string>("getDateInput", "rptTo");
            if (string.IsNullOrEmpty(from)) from = _rptFrom;
            if (string.IsNullOrEmpty(to)) to = _rptTo;
            var url = $"api/v2/reports/{_selectedCenterId}/daily?from={from}&to={to}";
            _dailyData = await Http.GetFromJsonAsync<List<DailyItem>>(url);
            _peakData = await Http.GetFromJsonAsync<PeakItem>($"api/v2/reports/{_selectedCenterId}/peak?from={from}&to={to}");
            _loaded = true;

            if (_dailyData != null && _dailyData.Count > 0)
            {
                _totalKWh = _dailyData.Sum(d => d.totalKWh);
                _dayCount = _dailyData.Count;
                _avgDaily = _totalKWh / _dayCount;
                var peak = _dailyData.OrderByDescending(d => d.totalKWh).First();
                _peakDayKWh = peak.totalKWh;
                _peakDayDate = peak.date;
            }

            StateHasChanged();
            if (_dailyData != null && _dailyData.Count > 0)
            {
                await Task.Delay(50);
                await RenderDailyChart();
                await LoadMonthly();
            }
        }
        catch (Exception ex) { _error = ex.Message; _loaded = true; }
        _loading = false; StateHasChanged();
    }

    private async Task RenderDailyChart()
    {
        try { await JS.InvokeVoidAsync("eval", "window._chartReady ? true : null"); } catch { return; }

        var labels = _dailyData.Select(d => d.date.Substring(5)).ToArray();
        var totalDs = _dailyData.Select(d => d.totalKWh).ToArray();
        var phaseADs = _dailyData.Select(d => d.phaseAKWh).ToArray();
        var phaseBDs = _dailyData.Select(d => d.phaseBKWh).ToArray();
        var phaseCDs = _dailyData.Select(d => d.phaseCKWh).ToArray();

        var datasets = new object[]
        {
            new { label = "جمع کل", data = totalDs },
            new { label = "فاز A", data = phaseADs },
            new { label = "فاز B", data = phaseBDs },
            new { label = "فاز C", data = phaseCDs }
        };
        try { await JS.InvokeVoidAsync("createOrUpdateChart", "rptDailyChart", labels, datasets, "kWh"); } catch { }
    }

    private async Task LoadMonthly()
    {
        if (_dailyData == null || _dailyData.Count == 0) return;
        _monthlyData = null; StateHasChanged();
        try
        {
            var url = $"api/v2/reports/{_selectedCenterId}/monthly?year={_selectedYear}";
            if (_compareYear.HasValue) url += $"&compareTo={_compareYear.Value}";
            _monthlyData = await Http.GetFromJsonAsync<List<MonthlyItem>>(url);
            StateHasChanged();
            if (_monthlyData != null && _monthlyData.Count > 0)
            {
                await Task.Delay(50);
                await RenderMonthlyChart();
            }
        }
        catch { }
    }

    private async Task RenderMonthlyChart()
    {
        try { await JS.InvokeVoidAsync("eval", "window._chartReady ? true : null"); } catch { return; }

        var monthNames = new[] { "فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند" };
        var labels = _monthlyData.Select(m => monthNames[m.month - 1]).ToArray();
        var currentDs = _monthlyData.Select(m => m.totalKWh).ToArray();

        var datasets = new List<object> { new { label = _selectedYear.ToString(), data = currentDs } };
        if (_compareYear.HasValue && _monthlyData.Any(m => m.compareToKWh.HasValue))
        {
            var compareDs = _monthlyData.Select(m => m.compareToKWh ?? 0).ToArray();
            datasets.Add(new { label = _compareYear.Value.ToString(), data = compareDs });
        }

        try { await JS.InvokeVoidAsync("createOrUpdateChart", "rptMonthlyChart", labels, datasets.ToArray(), "kWh"); } catch { }
    }

    private async Task Compare()
    {
        _loadingCompare = true; _comparisonData = null; StateHasChanged();
        try
        {
            var f1 = await JS.InvokeAsync<string>("getDateInput", "cmpFrom1");
            var t1 = await JS.InvokeAsync<string>("getDateInput", "cmpTo1");
            var f2 = await JS.InvokeAsync<string>("getDateInput", "cmpFrom2");
            var t2 = await JS.InvokeAsync<string>("getDateInput", "cmpTo2");
            if (string.IsNullOrEmpty(f1)) f1 = _cmpFrom1;
            if (string.IsNullOrEmpty(t1)) t1 = _cmpTo1;
            if (string.IsNullOrEmpty(f2)) f2 = _cmpFrom2;
            if (string.IsNullOrEmpty(t2)) t2 = _cmpTo2;
            var url = $"api/v2/reports/{_selectedCenterId}/comparison?from1={f1}&to1={t1}&from2={f2}&to2={t2}";
            _comparisonData = await Http.GetFromJsonAsync<ComparisonData>(url);
        }
        catch { }
        _loadingCompare = false; StateHasChanged();
    }

    private async Task ExportCsv()
    {
        try
        {
            var from = await JS.InvokeAsync<string>("getDateInput", "rptFrom");
            var to = await JS.InvokeAsync<string>("getDateInput", "rptTo");
            if (string.IsNullOrEmpty(from)) from = _rptFrom;
            if (string.IsNullOrEmpty(to)) to = _rptTo;
            var bytes = await Http.GetByteArrayAsync($"api/v2/reports/{_selectedCenterId}/export?from={from}&to={to}");
            await JS.InvokeVoidAsync("downloadFile", $"consumption_{_selectedCenterId}.csv", "text/csv", bytes);
        }
        catch { }
    }

    public class CenterRef { public Guid Id { get; set; } public string Name { get; set; } = ""; }
    public class DailyItem { public string date { get; set; } = ""; public double totalKWh { get; set; } public double phaseAKWh { get; set; } public double phaseBKWh { get; set; } public double phaseCKWh { get; set; } }
    public class MonthlyItem { public int month { get; set; } public int year { get; set; } public double totalKWh { get; set; } public double? compareToKWh { get; set; } }
    public class PeakItem { public double peakKWh { get; set; } public string peakDate { get; set; } = ""; public int peakHour { get; set; } }
    public class ComparisonData { public PeriodData period1 { get; set; } = new(); public PeriodData period2 { get; set; } = new(); public double deltaKWh { get; set; } public double deltaPercent { get; set; } }
    public class PeriodData { public string from { get; set; } = ""; public string to { get; set; } = ""; public double totalKWh { get; set; } }
}
