@page "/device-groups"
@using System.Net.Http.Json
@inject HttpClient Http
@inject AuthService Auth
@inject ToastService Toast

@if (Auth.IsInRole("Admin"))
{
<div class="dgrp-container">
    <div class="dgrp-top">
        <div class="dgrp-top-l">
            <span class="dgrp-icon">📁</span>
            <h2 class="dgrp-title">مدیریت گروه‌های دستگاه</h2>
        </div>
        <div class="dgrp-top-r">
            <button class="dgrp-btn dgrp-btn-help" @onclick="() => _showHelp = true" title="راهنما">❓</button>
            <button class="dgrp-btn dgrp-btn-add" @onclick="OpenCreate">+ گروه جدید</button>
        </div>
    </div>

    @if (_centers.Count == 0)
    {
        <div class="dgrp-prereq">
            <div class="dgrp-prereq-icon">⚠️</div>
            <div class="dgrp-prereq-b">
                <div class="dgrp-prereq-t">هنوز مرکزی ثبت نشده</div>
                <div class="dgrp-prereq-d">برای ثبت گروه دستگاه، ابتدا باید یک مرکز ایجاد کنید. به صفحه مراکز بروید.</div>
                <a class="dgrp-prereq-a" href="/centers">← رفتن به مدیریت مراکز</a>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="dgrp-loading"><div class="dgrp-spinner"></div></div>
    }
    else if (_items.Count == 0 && _centers.Count > 0)
    {
        <div class="dgrp-empty">
            <div class="dgrp-empty-icon">📁</div>
            <div class="dgrp-empty-t">گروهی ثبت نشده</div>
            <div class="dgrp-empty-d">روی «+ گروه جدید» کلیک کنید تا اولین گروه را ایجاد کنید.</div>
        </div>
    }
    else
    {
        <div class="dgrp-grid">
            @foreach (var item in _items)
            {
                <div class="dgrp-card @(item.IsActive ? "dgrp-card--on" : "dgrp-card--off")">
                    <div class="dgrp-card-bar"></div>
                    <div class="dgrp-card-body">
                        <div class="dgrp-card-top">
                            <span class="dgrp-card-name">@item.Name</span>
                            <span class="dgrp-card-badge @(item.IsActive ? "dgrp-badge-on" : "dgrp-badge-off")">@(item.IsActive ? "فعال" : "غیرفعال")</span>
                        </div>
                        <div class="dgrp-card-meta">
                            <span class="dgrp-card-meta-lbl">مرکز:</span>
                            <span class="dgrp-card-meta-val">@item.CenterName</span>
                        </div>
                    </div>
                    <div class="dgrp-card-acts">
                        <button class="dgrp-btn-sm dgrp-btn-edit" @onclick="() => OpenEdit(item)">ویرایش</button>
                        <button class="dgrp-btn-sm dgrp-btn-del" @onclick="() => ConfirmDelete(item)">حذف</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Help modal *@
@if (_showHelp)
{
    <div class="dgrp-overlay" @onclick="() => _showHelp = false">
        <div class="dgrp-modal dgrp-modal-help" @onclick:stopPropagation>
            <div class="dgrp-mh">
                <span class="dgrp-mh-icon">📘</span>
                <span class="dgrp-mh-t">راهنمای مدیریت گروه‌های دستگاه</span>
                <button class="dgrp-mh-x" @onclick="() => _showHelp = false">&times;</button>
            </div>
            <div class="dgrp-mb">
                <p class="dgrp-mb-intro"><strong>گروه دستگاه</strong> برای دسته‌بندی دستگاه‌های اندازه‌گیری در یک مرکز استفاده می‌شود.</p>
                <div class="dgrp-mb-step"><span class="dgrp-step-n">۱</span><span>مطمئن شوید <strong>مرکز</strong> مربوطه قبلاً ایجاد شده باشد.</span></div>
                <div class="dgrp-mb-step"><span class="dgrp-step-n">۲</span><span>نام گروه و مرکز مربوطه را انتخاب کنید.</span></div>
                <div class="dgrp-mb-step"><span class="dgrp-step-n">۳</span><span>پس از ثبت گروه، به بخش <strong>دستگاه‌ها</strong> بروید و دستگاه را به این گروه متصل کنید.</span></div>
                <div class="dgrp-mb-tip">💡 گروه‌ها به سازماندهی دستگاه‌ها در مراکز بزرگ کمک می‌کنند.</div>
            </div>
            <div class="dgrp-mf">
                <button class="dgrp-btn dgrp-btn-help" @onclick="() => _showHelp = false">متوجه شدم</button>
            </div>
        </div>
    </div>
}

@* Create / Edit modal *@
@if (_showModal)
{
    <div class="dgrp-overlay" @onclick="CloseModal">
        <div class="dgrp-modal dgrp-modal-form" @onclick:stopPropagation>
            <div class="dgrp-mh">
                <span class="dgrp-mh-t">@(_editingId == Guid.Empty ? "گروه جدید" : "ویرایش گروه")</span>
                <button class="dgrp-mh-x" @onclick="CloseModal">&times;</button>
            </div>
            <div class="dgrp-mb">
                <div class="dgrp-fg">
                    <label class="dgrp-fl">مرکز</label>
                    <select class="dgrp-fi" @bind="_form.CenterId">
                        <option value="@Guid.Empty">انتخاب کنید</option>
                        @foreach (var c in _centers)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="dgrp-fg">
                    <label class="dgrp-fl">نام گروه</label>
                    <input @bind="_form.Name" class="dgrp-fi" placeholder="مثلاً گروه صنعتی A" />
                </div>
                <div class="dgrp-fg">
                    <label class="dgrp-fl">وضعیت</label>
                    <label class="dgrp-tgl">
                        <input type="checkbox" @bind="_form.IsActive" />
                        <span class="dgrp-tgl-sl"></span>
                        <span class="dgrp-tgl-lbl">@(_form.IsActive ? "فعال" : "غیرفعال")</span>
                    </label>
                </div>
            </div>
            <div class="dgrp-mf">
                <button class="dgrp-btn dgrp-btn-cancel" @onclick="CloseModal">انصراف</button>
                <button class="dgrp-btn dgrp-btn-save" @onclick="Save" disabled="@_saving">@(_saving ? "..." : "ذخیره")</button>
            </div>
        </div>
    </div>
}

@* Delete confirm modal *@
@if (_deleteTarget is not null)
{
    <div class="dgrp-overlay" @onclick="() => _deleteTarget = null">
        <div class="dgrp-modal dgrp-modal-form" @onclick:stopPropagation>
            <div class="dgrp-mh">
                <span class="dgrp-mh-t dgrp-mh-t-del">حذف گروه</span>
                <button class="dgrp-mh-x" @onclick="() => _deleteTarget = null">&times;</button>
            </div>
            <div class="dgrp-mb">
                <p class="dgrp-del-msg">آیا از حذف <strong>@_deleteTarget.Name</strong> اطمینان دارید؟</p>
            </div>
            <div class="dgrp-mf">
                <button class="dgrp-btn dgrp-btn-cancel" @onclick="() => _deleteTarget = null">انصراف</button>
                <button class="dgrp-btn dgrp-btn-danger" @onclick="DeleteItem">حذف</button>
            </div>
        </div>
    </div>
}
}
else
{
    <div class="dgrp-denied">
        <div class="dgrp-denied-icon">🔒</div>
        <h3>دسترسی محدود</h3>
        <p>فقط مدیران می‌توانند به این بخش دسترسی داشته باشند.</p>
        <a href="/dashboard" class="dgrp-back-link">← بازگشت به داشبورد</a>
    </div>
}

@code {
    private List<GroupItem> _items = new();
    private List<CenterItem> _centers = new();
    private bool _loading = true, _saving, _showModal, _showHelp;
    private Guid _editingId;
    private GroupForm _form = new();
    private GroupItem? _deleteTarget;

    protected override async Task OnInitializedAsync() { if (Auth.IsInRole("Admin")) await Load(); }
    private async Task Load()
    {
        _loading = true; StateHasChanged();
        try
        {
            var centersTask = Http.GetFromJsonAsync<List<CenterItem>>("api/v2/centers");
            var groupsTask = Http.GetFromJsonAsync<List<GroupItem>>("api/v2/device-groups");
            await Task.WhenAll(centersTask, groupsTask);
            _centers = centersTask.Result ?? new();
            _items = groupsTask.Result?.Select(g =>
            {
                var center = _centers.FirstOrDefault(c => c.Id == g.CenterId);
                return new GroupItem { Id = g.Id, Name = g.Name, CenterId = g.CenterId, CenterName = center?.Name ?? "---", IsActive = g.IsActive };
            }).ToList() ?? new();
        }
        catch { Toast.ShowError("خطا در دریافت اطلاعات"); }
        finally { _loading = false; StateHasChanged(); }
    }
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _showModal = true; }
    private void OpenEdit(GroupItem c) { _editingId = c.Id; _form = new GroupForm { Name = c.Name, CenterId = c.CenterId, IsActive = c.IsActive }; _showModal = true; }
    private void CloseModal() => _showModal = false;
    private void ConfirmDelete(GroupItem c) => _deleteTarget = c;
    private async Task Save()
    {
        _saving = true;
        try
        {
            HttpResponseMessage resp;
            if (_editingId == Guid.Empty) resp = await Http.PostAsJsonAsync("api/v2/device-groups", _form);
            else resp = await Http.PutAsJsonAsync($"api/v2/device-groups/{_editingId}", _form);
            if (resp.IsSuccessStatusCode) { _showModal = false; Toast.ShowSuccess("ذخیره شد"); await Load(); }
            else { var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>(); Toast.ShowError(err?.GetValueOrDefault("error") ?? "خطا"); }
        }
        catch { Toast.ShowError("خطا در ارتباط با سرور"); }
        finally { _saving = false; }
    }
    private async Task DeleteItem()
    {
        if (_deleteTarget is null) return;
        try { await Http.DeleteAsync($"api/v2/device-groups/{_deleteTarget.Id}"); _deleteTarget = null; Toast.ShowSuccess("حذف شد"); await Load(); }
        catch { Toast.ShowError("خطا در حذف"); }
    }

    public class GroupItem { public Guid Id { get; set; } public string Name { get; set; } = ""; public Guid CenterId { get; set; } public string CenterName { get; set; } = ""; public bool IsActive { get; set; } = true; }
    public class GroupForm { public string Name { get; set; } = ""; public Guid CenterId { get; set; } public bool IsActive { get; set; } = true; }
    public class CenterItem { public Guid Id { get; set; } public string Name { get; set; } = ""; public string Code { get; set; } = ""; }
}

<style>
/* ═══════════════════════════════════════════
   Device Groups page — modern card grid
   ═══════════════════════════════════════════ */
.dgrp-container{max-width:1120px;margin:0 auto;padding:24px 16px}
.dgrp-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:24px;flex-wrap:wrap}
.dgrp-top-l{display:flex;align-items:center;gap:10px}
.dgrp-icon{font-size:24px}
.dgrp-title{font-size:18px;font-weight:800;color:var(--text);margin:0}
.dgrp-top-r{display:flex;gap:8px}
.dgrp-btn{display:inline-flex;align-items:center;gap:6px;padding:10px 18px;border-radius:10px;font-size:13px;font-weight:600;border:none;cursor:pointer;transition:all .2s;font-family:var(--font);white-space:nowrap;text-decoration:none}
.dgrp-btn:active{transform:scale(.95)}
.dgrp-btn-add{background:var(--grad-blue);color:#fff}
.dgrp-btn-add:hover{box-shadow:var(--shadow-blue);transform:translateY(-1px)}
.dgrp-btn-help{background:var(--bg);color:var(--text-secondary);border:1px solid var(--border);padding:10px 12px}
.dgrp-btn-help:hover{background:var(--bg-alt);color:var(--text)}
.dgrp-btn-cancel{background:var(--bg);color:var(--text-secondary);border:1px solid var(--border)}
.dgrp-btn-cancel:hover{background:var(--bg-alt)}
.dgrp-btn-save{background:var(--grad-blue);color:#fff}
.dgrp-btn-save:hover{box-shadow:var(--shadow-blue);transform:translateY(-1px)}
.dgrp-btn-save:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none}
.dgrp-btn-danger{background:var(--red);color:#fff}
.dgrp-btn-danger:hover{box-shadow:var(--shadow-red);transform:translateY(-1px)}
.dgrp-btn-sm{padding:6px 14px;border-radius:8px;font-size:12px;font-weight:600;border:none;cursor:pointer;transition:all .2s;font-family:var(--font)}
.dgrp-btn-sm:active{transform:scale(.93)}
.dgrp-btn-edit{background:var(--blue-bg);color:var(--blue)}
.dgrp-btn-edit:hover{background:var(--blue);color:#fff}
.dgrp-btn-del{background:var(--red-bg);color:var(--red)}
.dgrp-btn-del:hover{background:var(--red);color:#fff}

/* Prereq alert */
.dgrp-prereq{display:flex;gap:14px;padding:16px 18px;background:linear-gradient(135deg,var(--gold-bg),#fffbeb);border:1px solid #fde68a;border-radius:14px;margin-bottom:20px;align-items:flex-start}
.dgrp-prereq-icon{font-size:24px;flex-shrink:0;margin-top:1px}
.dgrp-prereq-b{flex:1}
.dgrp-prereq-t{font-size:14px;font-weight:700;color:#92400e;margin-bottom:4px}
.dgrp-prereq-d{font-size:12px;color:#b45309;line-height:1.7}
.dgrp-prereq-a{display:inline-block;margin-top:8px;font-size:12px;font-weight:600;color:var(--blue-dark);text-decoration:none;transition:color .2s}
.dgrp-prereq-a:hover{text-decoration:underline}

/* Loading */
.dgrp-loading{text-align:center;padding:80px 20px}
.dgrp-spinner{width:36px;height:36px;border:3px solid var(--border);border-top-color:var(--blue);border-radius:50%;animation:dgrp-spin .7s linear infinite;margin:0 auto}
@@keyframes dgrp-spin{to{transform:rotate(360deg)}}

/* Empty state */
.dgrp-empty{text-align:center;padding:60px 20px}
.dgrp-empty-icon{font-size:48px;margin-bottom:12px;opacity:.4}
.dgrp-empty-t{font-size:16px;font-weight:700;color:var(--text);margin-bottom:6px}
.dgrp-empty-d{font-size:13px;color:var(--text-secondary)}

/* Card grid */
.dgrp-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:14px}
.dgrp-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;overflow:hidden;transition:all .25s;display:flex;flex-direction:column;position:relative}
.dgrp-card:hover{border-color:var(--blue);box-shadow:0 4px 20px rgba(59,130,246,.1);transform:translateY(-2px)}
.dgrp-card:active{transform:scale(.97)}
.dgrp-card-bar{height:4px;flex-shrink:0}
.dgrp-card--on .dgrp-card-bar{background:var(--grad-green)}
.dgrp-card--off .dgrp-card-bar{background:#d1d5db}
.dgrp-card-body{padding:16px 16px 12px;flex:1}
.dgrp-card-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
.dgrp-card-name{font-size:15px;font-weight:700;color:var(--text)}
.dgrp-card-badge{font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;white-space:nowrap}
.dgrp-badge-on{background:var(--green-bg);color:var(--green)}
.dgrp-badge-off{background:var(--red-bg);color:var(--red)}
.dgrp-card-meta{display:flex;gap:4px;font-size:12px;color:var(--text-muted);align-items:center}
.dgrp-card-meta-lbl{color:var(--text-secondary)}
.dgrp-card-meta-val{color:var(--text);font-weight:600}
.dgrp-card-acts{display:flex;gap:6px;padding:10px 16px;border-top:1px solid var(--border);background:var(--bg-alt)}

/* Overlay + modal */
.dgrp-overlay{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.2);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:16px;animation:dgrp-fade .2s ease}
@@keyframes dgrp-fade{from{opacity:0}to{opacity:1}}
.dgrp-modal{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.15);animation:dgrp-up .35s cubic-bezier(.34,1.56,.64,1)}
@@keyframes dgrp-up{from{opacity:0;transform:translateY(24px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.dgrp-modal-form{max-width:560px}
.dgrp-modal-help{max-width:500px}
.dgrp-mh{display:flex;align-items:center;gap:10px;padding:18px 20px 14px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg-card);z-index:1}
.dgrp-mh-icon{font-size:18px}
.dgrp-mh-t{flex:1;font-size:15px;font-weight:700;color:var(--text)}
.dgrp-mh-t-del{color:var(--red)}
.dgrp-mh-x{background:none;border:none;font-size:22px;color:var(--text-muted);cursor:pointer;padding:0;line-height:1;transition:color .2s;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:8px}
.dgrp-mh-x:hover{background:var(--bg);color:var(--text)}
.dgrp-mb{padding:16px 20px}
.dgrp-mb-intro{font-size:13px;line-height:1.7;color:var(--text-secondary);margin-bottom:14px}
.dgrp-mb-step{display:flex;gap:10px;align-items:flex-start;margin-bottom:10px;font-size:13px;line-height:1.6;color:var(--text)}
.dgrp-step-n{width:22px;height:22px;border-radius:50%;background:var(--grad-blue);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;margin-top:2px}
.dgrp-mb-tip{background:var(--gold-bg);border-right:3px solid var(--gold);padding:10px 14px;border-radius:10px;margin-top:12px;font-size:12px;color:#92400e;line-height:1.6}
.dgrp-mf{display:flex;gap:8px;justify-content:flex-end;padding:12px 20px 18px;border-top:1px solid var(--border)}

/* Form fields */
.dgrp-fg{margin-bottom:16px}
.dgrp-fg:last-child{margin-bottom:0}
.dgrp-fl{display:block;font-size:12px;font-weight:600;color:var(--text-secondary);margin-bottom:5px}
.dgrp-fi{width:100%;padding:10px 14px;border:1px solid var(--border);border-radius:10px;background:var(--bg-card);color:var(--text);font-size:13px;outline:none;transition:border-color .2s,box-shadow .2s;font-family:var(--font)}
.dgrp-fi:focus{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-glow)}
.dgrp-fi::placeholder{color:var(--text-muted)}
.dgrp-tgl{display:inline-flex;align-items:center;gap:10px;cursor:pointer;user-select:none}
.dgrp-tgl input{opacity:0;width:0;height:0}
.dgrp-tgl-sl{position:relative;width:42px;height:24px;background:var(--border);border-radius:24px;transition:.3s;flex-shrink:0}
.dgrp-tgl-sl::before{content:'';position:absolute;height:18px;width:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.3s}
.dgrp-tgl input:checked+.dgrp-tgl-sl{background:var(--grad-blue)}
.dgrp-tgl input:checked+.dgrp-tgl-sl::before{transform:translateX(18px)}
.dgrp-tgl-lbl{font-size:13px;font-weight:600;color:var(--text)}
.dgrp-del-msg{font-size:14px;line-height:1.7;color:var(--text)}

/* Access denied */
.dgrp-denied{text-align:center;padding:80px 20px;color:#888}
.dgrp-denied-icon{font-size:48px;margin-bottom:12px}
.dgrp-denied h3{font-size:18px;margin-bottom:8px;color:var(--text)}
.dgrp-denied p{color:var(--text-secondary);margin-bottom:16px;font-size:13px}
.dgrp-back-link{display:inline-block;padding:8px 16px;border-radius:8px;background:var(--blue-bg);color:var(--blue);font-size:13px;font-weight:600;text-decoration:none;transition:all .2s}
.dgrp-back-link:hover{background:var(--blue);color:#fff}

/* ── Responsive ── */
@@media(max-width:640px){
    .dgrp-container{padding:16px 12px}
    .dgrp-top{flex-direction:column;align-items:stretch;gap:10px}
    .dgrp-top-r{justify-content:space-between}
    .dgrp-title{font-size:16px}
    .dgrp-grid{grid-template-columns:1fr;gap:10px}
    .dgrp-card-body{padding:14px 14px 10px}
    .dgrp-card-acts{padding:8px 14px}
    .dgrp-card-name{font-size:14px}
    .dgrp-btn{padding:8px 14px;font-size:12px}
    .dgrp-modal-form,.dgrp-modal-help{margin:0;border-radius:14px;max-width:100%}
    .dgrp-mh{padding:14px 16px 12px}
    .dgrp-mb{padding:12px 16px}
    .dgrp-mf{padding:10px 16px 14px}
    .dgrp-mb-step{font-size:12px}
    .dgrp-empty{padding:40px 16px}
    .dgrp-prereq{padding:14px;border-radius:12px}
    .dgrp-prereq-t{font-size:13px}
    .dgrp-prereq-d{font-size:11px}
}
</style>
