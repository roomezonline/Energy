@page "/centers"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthService Auth
@inject ToastService Toast

@if (Auth.IsInRole("Admin"))
{
<div class="page-container">
    <div class="page-toolbar">
        <h2>مدیریت مراکز</h2>
        <button class="btn btn-primary" @onclick="OpenCreate">+ مرکز جدید</button>
    </div>

    <PrereqAlert Met="(_cities.Count > 0)"
        Title="هنوز شهری ثبت نشده"
        Text="برای ثبت مرکز، ابتدا باید یک شهر ایجاد کنید. به صفحه شهرها بروید."
        LinkText="رفتن به مدیریت شهرها"
        LinkHref="/cities" />

    <HelpBox>
        <p><strong>مرکز</strong> یک مکان فیزیکی است که دستگاه‌های اندازه‌گیری در آن نصب می‌شوند.</p>
        <div class="hlp-step"><span class="hlp-step-num">۱</span><span class="hlp-step-text">ابتدا <strong>شهر</strong> مربوطه را ایجاد کرده باشید.</span></div>
        <div class="hlp-step"><span class="hlp-step-num">۲</span><span class="hlp-step-text">نام و شهر مرکز را وارد کنید — کد به صورت خودکار تولید می‌شود.</span></div>
        <div class="hlp-step"><span class="hlp-step-num">۳</span><span class="hlp-step-text">پس از ثبت مرکز، به بخش <strong>دستگاه‌ها</strong> بروید و دستگاه را به این مرکز متصل کنید.</span></div>
        <div class="hlp-tip">💡 مراکز در فرم <strong>صورتحساب</strong> برای محاسبه قبض استفاده می‌شوند.</div>
    </HelpBox>

    @if (_loading)
    {
        <div class="loading-state"><div class="spinner"></div></div>
    }
    else if (_centers.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🏢</div>
            <div class="empty-title">مرکزی ثبت نشده</div>
            <div class="empty-hint">با کلیک روی «+ مرکز جدید» اولین مرکز را اضافه کنید.</div>
        </div>
    }
    else
    {
        <div class="card-list">
            @foreach (var c in _centers)
            {
                <div class="card-item">
                    <div class="card-hdr">
                        <strong>@c.Name</strong>
                        <span class="card-tag @(c.IsActive ? "active" : "inactive")">@(c.IsActive ? "فعال" : "غیرفعال")</span>
                    </div>
                    <div class="card-body">
                        <div class="card-row"><span>کد</span><span class="ltr">@c.Code</span></div>
                        <div class="card-row"><span>شهر</span><span>@(c.CityName ?? "---")</span></div>
                    </div>
                    <div class="card-actions">
                        <button class="card-btn primary" @onclick="() => OpenEdit(c)">ویرایش</button>
                        <button class="card-btn danger" @onclick="() => ConfirmDelete(c)">حذف</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

    @if (_showModal)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-card" @onclick:stopPropagation>
                <div class="modal-hdr">
                    <h3>@(_editingId == Guid.Empty ? "مرکز جدید" : "ویرایش مرکز")</h3>
                    <button class="modal-close" @onclick="CloseModal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="form-row"><label>نام</label><input @bind="_form.Name" class="form-input" /></div>
                    <div class="form-row"><label>کد</label><input @bind="_form.Code" class="form-input ltr" disabled /></div>
                    <div class="form-row"><label>شهر</label><select class="form-input" @bind="_form.CityId"><option value="">انتخاب کنید</option>@foreach (var ct in _cities) { <option value="@ct.Id">@ct.Name</option> }</select></div>
                    <div class="form-row"><label>فعال</label><label class="tgl"><input type="checkbox" @bind="_form.IsActive" /><span class="sl"></span></label></div>
                </div>
                <div class="modal-ftr">
                    <button class="btn btn-secondary" @onclick="CloseModal">انصراف</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@_saving">@(_saving ? "..." : "ذخیره")</button>
                </div>
            </div>
        </div>
    }

    @if (_deleteTarget is not null)
    {
        <div class="modal-overlay" @onclick="() => _deleteTarget = null">
            <div class="modal-card" @onclick:stopPropagation>
                <div class="modal-hdr"><h3>حذف مرکز</h3><button class="modal-close" @onclick="() => _deleteTarget = null">&times;</button></div>
                <div class="modal-body"><p>آیا از حذف <strong>@_deleteTarget.Name</strong> اطمینان دارید؟</p></div>
                <div class="modal-ftr">
                    <button class="btn btn-secondary" @onclick="() => _deleteTarget = null">انصراف</button>
                    <button class="btn btn-danger" @onclick="DeleteCenter">حذف</button>
                </div>
            </div>
        </div>
    }
}
else
{
    <div style="text-align:center;padding:4rem 1rem;color:#888">
        <h3>🔒 دسترسی محدود</h3>
        <p>فقط مدیران می‌توانند به این بخش دسترسی داشته باشند.</p>
        <a href="/dashboard" class="btn-link">بازگشت به داشبورد</a>
    </div>
}

@code {
    private List<CenterItem> _centers = new();
    private List<CityLookup> _cities = new();
    private bool _loading = true, _saving, _showModal;
    private Guid _editingId;
    private CenterForm _form = new();
    private CenterItem? _deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsInRole("Admin")) await Load();
    }

    private async Task Load()
    {
        _loading = true; StateHasChanged();
        try
        {
            var citiesTask = Http.GetFromJsonAsync<List<CityLookup>>("api/v2/cities");
            var centersTask = Http.GetFromJsonAsync<List<CenterItem>>("api/v2/centers");
            await Task.WhenAll(citiesTask, centersTask);
            _cities = citiesTask.Result ?? new();
            var raw = centersTask.Result ?? new();
            foreach (var c in raw)
            {
                var city = _cities.FirstOrDefault(x => x.Id == c.CityId);
                c.CityName = city?.Name ?? "---";
            }
            _centers = raw;
        }
        catch { Toast.ShowError("خطا در دریافت اطلاعات"); }
        finally { _loading = false; StateHasChanged(); }
    }

    private void OpenCreate() { _editingId = Guid.Empty; _form = new CenterForm { CityId = null, Code = NextCenterCode() }; _showModal = true; }
    private void OpenEdit(CenterItem c)
    {
        _editingId = c.Id;
        _form = new CenterForm { Name = c.Name, Code = c.Code, CityId = c.CityId, IsActive = c.IsActive };
        _showModal = true;
    }
    private void CloseModal() => _showModal = false;
    private void ConfirmDelete(CenterItem c) => _deleteTarget = c;
    private string NextCenterCode() { var m = 0; foreach (var x in _centers) { if (x.Code.StartsWith("CTR-") && int.TryParse(x.Code[4..], out var n) && n > m) m = n; } return $"CTR-{m + 1:D3}"; }

    private async Task Save()
    {
        _saving = true;
        try
        {
            HttpResponseMessage resp;
            if (_editingId == Guid.Empty)
                resp = await Http.PostAsJsonAsync("api/v2/centers", _form);
            else
                resp = await Http.PutAsJsonAsync($"api/v2/centers/{_editingId}", _form);
            if (resp.IsSuccessStatusCode)
            {
                _showModal = false;
                Toast.ShowSuccess(_editingId == Guid.Empty ? "مرکز با موفقیت ایجاد شد" : "مرکز با موفقیت ویرایش شد");
                await Load();
            }
            else
            {
                var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                Toast.ShowError(err?.GetValueOrDefault("error") ?? "خطا در ذخیره");
            }
        }
        catch { Toast.ShowError("خطا در ارتباط با سرور"); }
        finally { _saving = false; }
    }

    private async Task DeleteCenter()
    {
        if (_deleteTarget is null) return;
        try
        {
            await Http.DeleteAsync($"api/v2/centers/{_deleteTarget.Id}");
            _deleteTarget = null;
            Toast.ShowSuccess("مرکز با موفقیت حذف شد");
            await Load();
        }
        catch { Toast.ShowError("خطا در حذف مرکز"); }
    }

    public class CenterItem { public Guid Id { get; set; } public string Name { get; set; } = ""; public string Code { get; set; } = ""; public Guid? CityId { get; set; } public string? CityName { get; set; } public bool IsActive { get; set; } = true; }
    public class CenterForm { public string Name { get; set; } = ""; public string Code { get; set; } = ""; public Guid? CityId { get; set; } public bool IsActive { get; set; } = true; }
    public class CityLookup { public Guid Id { get; set; } public string Name { get; set; } = ""; }
}
