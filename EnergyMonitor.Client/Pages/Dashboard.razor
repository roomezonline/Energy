    private void ToggleMute(int alarmId)
    {
        if (!_silencedAlarms.Add(alarmId))
            _silencedAlarms.Remove(alarmId);
        if (_silencedAlarms.Count >= (_data?.ActiveAlarms?.Count ?? 0))
            _ = JS.InvokeVoidAsync("stopAlarmSound");
    }

    private void ShowPhaseAlarms(List<AlarmItemDto> alarms, string phase)
    {
        _selectedPhaseAlarms = alarms;
        _selectedPhaseName = phase;
        _showPhaseAlarms = true;
    }

    private async Task ResolveAlarm(int alarmId)
    {
        try
        {
            await Http.PostAsync($"api/alarms/{alarmId}/resolve", null);
            _silencedAlarms.Remove(alarmId);
            if (_data?.ActiveAlarms != null)
            {
                var alarm = _data.ActiveAlarms.FirstOrDefault(a => a.Id == alarmId);
                if (alarm != null) alarm.IsResolved = true;
                _data.ActiveAlarms.RemoveAll(a => a.Id == alarmId);
                if (_data.ActiveAlarms.Count == 0)
                    await JS.InvokeVoidAsync("stopAlarmSound");
            }
        }
        catch { }
    }

    private async Task StopAllAlarmSounds()
    {
        if (_data?.ActiveAlarms != null)
            foreach (var a in _data.ActiveAlarms)
                _silencedAlarms.Add(a.Id);
        await JS.InvokeVoidAsync("stopAlarmSound");
    }

    private async Task CalcBill()
    {
        try
        {
            var from = await JS.InvokeAsync<string>("getDateInput", "billFrom");
            var to = await JS.InvokeAsync<string>("getDateInput", "billTo");
            if (string.IsNullOrEmpty(from) || string.IsNullOrEmpty(to))
            {
                _billResult = "لطفا بازه تاریخ را انتخاب کنید";
                return;
            }
            if (_data?.Center?.Id == null)
            {
                _billResult = "مرکز انتخاب نشده است";
                return;
            }
            if (_selectedTariffId == Guid.Empty)
            {
                _billResult = "لطفا یک تعرفه انتخاب کنید";
                return;
            }
            _billResult = "در حال محاسبه...";
            _billData = null;
            StateHasChanged();

            var req = new
            {
                centerId = _data.Center.Id,
                fromDate = from,
                toDate = to,
                tariffId = _selectedTariffId
            };
            var resp = await Http.PostAsJsonAsync("api/v2/billing/calculate", req);
            if (resp.IsSuccessStatusCode)
            {
                _billData = await resp.Content.ReadFromJsonAsync<BillingResultDto>();
                _billResult = "";
            }
            else
            {
                var err = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                _billResult = err?.GetValueOrDefault("error") ?? "خطا در محاسبه";
            }
        }
        catch { _billResult = "خطا در ارتباط با سرور"; }
    }

