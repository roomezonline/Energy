    protected override async Task OnInitializedAsync()
    {
        await LoadCenters();
        if (_centers.Count > 0)
            await LoadDevices(selectedFirst: true);
        if (!string.IsNullOrEmpty(_selectedDeviceId))
            await LoadData();
        _refreshTimer = new Timer(async _ => await AutoRefresh(), null, 5000, 5000);
    }

    private async Task LoadCenters()
    {
        try
        {
            _centers = await Http.GetFromJsonAsync<List<CenterRef>>("api/v2/centers") ?? new();
            if (!Auth.IsInRole("SuperAdmin") && Auth.CurrentUser?.CenterIds.Count > 0)
            {
                var allowed = Auth.CurrentUser.CenterIds;
                _centers = _centers.Where(c => allowed.Contains(c.Id)).ToList();
            }
            if (_centers.Count > 0)
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "dashboard_centerId");
                if (!string.IsNullOrEmpty(saved) && Guid.TryParse(saved, out var gid) && _centers.Any(c => c.Id == gid))
                    _selectedCenterId = gid;
                else
                    _selectedCenterId = _centers[0].Id;
            }
        }
        catch { }
    }

    private async Task LoadDevices(bool selectedFirst = false)
    {
        try
        {
            if (_selectedCenterId != Guid.Empty)
            {
                _devices = await Http.GetFromJsonAsync<List<DeviceInfoDto>>($"api/v2/devices/by-center/{_selectedCenterId}") ?? new();
            }
            else
            {
                var resp = await Http.GetAsync("api/devices");
                if (resp.IsSuccessStatusCode)
                    _devices = await resp.Content.ReadFromJsonAsync<List<DeviceInfoDto>>() ?? new();
            }
            if (_devices.Count > 0)
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "dashboard_deviceId");
                if (!string.IsNullOrEmpty(saved) && _devices.Any(d => d.DeviceId == saved))
                    _selectedDeviceId = saved;
                else if (selectedFirst)
                    _selectedDeviceId = _devices[0].DeviceId;
            }
        }
        catch { }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var deviceId = _selectedDeviceId;
            if (string.IsNullOrEmpty(deviceId) && _devices.Count > 0)
                deviceId = _devices[0].DeviceId;

            if (!string.IsNullOrEmpty(deviceId))
            {
                _data = await Http.GetFromJsonAsync<DashboardDataDto>($"api/dashboard/fulldata/{Uri.EscapeDataString(deviceId)}");
                if (_data?.LatestSnapshot is not null)
                {
                    var s = _data.LatestSnapshot;
                    var pc = _data.SelectedDevice?.PhaseCount ?? 3;
                    var actCount = (s.CurrentA > 0 && s.VoltageA > 0 ? 1 : 0) + (pc >= 2 && s.CurrentB > 0 && s.VoltageB > 0 ? 1 : 0) + (pc >= 3 && s.CurrentC > 0 && s.VoltageC > 0 ? 1 : 0);
                    if (actCount == 0) actCount = 1;
                    var avgI = ((s.CurrentA > 0 && s.VoltageA > 0 ? s.CurrentA : 0) + (pc >= 2 && s.CurrentB > 0 && s.VoltageB > 0 ? s.CurrentB : 0) + (pc >= 3 && s.CurrentC > 0 && s.VoltageC > 0 ? s.CurrentC : 0)) / actCount;
                    _currPct = (decimal)Math.Clamp((double)avgI / 50.0 * 100, 0, 100);
                }
                UpdateSparklines();
            }
            _data ??= new DashboardDataDto();
        }
        catch
        {
            _data ??= new DashboardDataDto();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task AutoRefresh()
    {
        try
        {
            var oldAlarmIds = _data?.ActiveAlarms?.Select(a => a.Id).ToHashSet() ?? new();
            var soundEnabled = _data?.DeviceConfig?.AlarmSoundEnabled ?? true;
            await LoadData();
            var hasAlarms = _data?.ActiveAlarms?.Count > 0;
            var newSoundEnabled = _data?.DeviceConfig?.AlarmSoundEnabled ?? true;

            if (!hasAlarms)
            {
                try { await JS.InvokeVoidAsync("stopAlarmSound"); } catch { }
            }
            else
            {
                var newAlarms = _data!.ActiveAlarms!.Where(a =>
                    !oldAlarmIds.Contains(a.Id) && !_silencedAlarms.Contains(a.Id)).ToList();
                if (newAlarms.Count > 0 && newSoundEnabled)
                    try { await JS.InvokeVoidAsync("playAlarmSound"); } catch { }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task SelectCenter(Guid centerId)
    {
        _showCenterModal = false;
        if (centerId == _selectedCenterId) return;
        _selectedCenterId = centerId;
        _selectedDeviceId = "";
        await JS.InvokeVoidAsync("localStorage.setItem", "dashboard_centerId", centerId.ToString());
        await JS.InvokeVoidAsync("localStorage.removeItem", "dashboard_deviceId");
        _isChangingDevice = true;
        StateHasChanged();
        await LoadDevices(selectedFirst: true);
        await LoadData();
        _isChangingDevice = false;
        StateHasChanged();
    }

    private async Task SelectDevice(string deviceId)
    {
        _showDeviceModal = false;
        if (deviceId == _selectedDeviceId) return;
        _selectedDeviceId = deviceId;
        await JS.InvokeVoidAsync("localStorage.setItem", "dashboard_deviceId", deviceId);
        _isChangingDevice = true;
        StateHasChanged();
        await LoadData();
        _isChangingDevice = false;
        StateHasChanged();
    }

    private string SmartReactiveUnit(decimal v)
    {
        if (v >= 1000000) return "MVAr";
        if (v >= 1000) return "kVAr";
        return "VAr";
    }

    private string SmartPower(decimal w)
    {
        if (w >= 1000000) return (w / 1000000).ToString("F2");
        if (w >= 1000) return (w / 1000).ToString("F1");
        return w.ToString("F0");
    }

    private string SmartPowerUnit(decimal w)
    {
        if (w >= 1000000) return "MW";
        if (w >= 1000) return "kW";
        return "W";
    }

    private string SmartCurrent(decimal a)
    {
        if (a >= 1000) return (a / 1000).ToString("F2") + " kA";
        return a.ToString("F2") + " A";
    }

    private string SmartEnergy(decimal e)
    {
        if (e >= 1000) return (e / 1000).ToString("F3") + " MWh";
        if (e >= 1) return e.ToString("F3") + " kWh";
        return (e * 1000).ToString("F1") + " Wh";
    }

    private string SmartReactive(decimal v)
    {
        if (v >= 1000000) return (v / 1000000).ToString("F2");
        if (v >= 1000) return (v / 1000).ToString("F1");
        return v.ToString("F0");
    }

    private async Task RenderCharts()
    {
        if (_data?.ChartSnapshots == null || _data.ChartSnapshots.Count == 0) return;
        try
        {
            var ready = await JS.InvokeAsync<bool>("eval", "!!window._chartReady");
            if (!ready) return;
            var maxPoints = 50;
            var snapshots = _data.ChartSnapshots.TakeLast(maxPoints).ToList();
            var labels = snapshots.Select(s => s.Timestamp.ToLocalTime().ToString("HH:mm")).ToArray();
            var pc = _data.SelectedDevice?.PhaseCount ?? 3;
            var vA = snapshots.Select(s => s.VoltageA).ToArray();
            var cA = snapshots.Select(s => s.CurrentA).ToArray();
            var pA = snapshots.Select(s => s.PowerA).ToArray();
            var pfA = snapshots.Select(s => s.PfA).ToArray();

            var volDs = new List<object> { new { label = "فاز A", data = vA } };
            var curDs = new List<object> { new { label = "فاز A", data = cA } };
            var pwrDs = new List<object> { new { label = "فاز A", data = pA } };
            var pfDs = new List<object> { new { label = "فاز A", data = pfA } };

            if (pc >= 2)
            {
                volDs.Add(new { label = "فاز B", data = snapshots.Select(s => s.VoltageB).ToArray() });
                curDs.Add(new { label = "فاز B", data = snapshots.Select(s => s.CurrentB).ToArray() });
                pwrDs.Add(new { label = "فاز B", data = snapshots.Select(s => s.PowerB).ToArray() });
                pfDs.Add(new { label = "فاز B", data = snapshots.Select(s => s.PfB).ToArray() });
            }
            if (pc >= 3)
            {
                volDs.Add(new { label = "فاز C", data = snapshots.Select(s => s.VoltageC).ToArray() });
                curDs.Add(new { label = "فاز C", data = snapshots.Select(s => s.CurrentC).ToArray() });
                pwrDs.Add(new { label = "فاز C", data = snapshots.Select(s => s.PowerC).ToArray() });
                pfDs.Add(new { label = "فاز C", data = snapshots.Select(s => s.PfC).ToArray() });
            }

            await JS.InvokeVoidAsync("createOrUpdateChart", "chartVoltage", labels, volDs, "V");
            await JS.InvokeVoidAsync("createOrUpdateChart", "chartCurrent", labels, curDs, "A");
            await JS.InvokeVoidAsync("createOrUpdateChart", "chartPower", labels, pwrDs, "W");
            await JS.InvokeVoidAsync("createOrUpdateChart", "chartPf", labels, pfDs, "");
        }
        catch { }
    }

    private bool _scriptsLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_scriptsLoaded)
        {
            await JS.InvokeVoidAsync("eval", @"
                function loadScript(src){return new Promise(function(r,j){var s=document.createElement('script');s.src=src;s.onload=r;s.onerror=j;document.head.appendChild(s)})}
                loadScript('js/chart.umd.min.js').then(function(){return loadScript('js/charts.js')}).then(function(){window._chartReady=true}).catch(function(){});
            ");
            _scriptsLoaded = true;
            await Task.Delay(500);
        }

        if (_data?.ChartSnapshots?.Count > 0)
        {
            await RenderCharts();
        }

        try { await JS.InvokeVoidAsync("initJalaliDatepicker"); } catch { }
    }

