@code {
    private DashboardDataDto? _data;
    private List<CenterRef> _centers = new();
    private Guid _selectedCenterId;
    private List<DeviceInfoDto> _devices = new();
    private string _selectedDeviceId = "";
    private bool _showCenterModal;
    private bool _showDeviceModal;
    private bool _isLoading;
    private bool _isChangingDevice;
    private decimal _currPct;
    private Timer? _refreshTimer;
    private bool _showSummary;
    private bool _summaryLoading;
    private ConsumptionDto? _sumData;
    private List<TariffRef> _tariffs = new();
    private Guid _selectedTariffId = Guid.Empty;
    private HashSet<int> _silencedAlarms = new();
    private string _billResult = "";
    private BillingResultDto? _billData;
    private bool _showPhaseAlarms;
    private List<AlarmItemDto> _selectedPhaseAlarms = new();
    private string _selectedPhaseName = "";

    private bool _expandPhaseStatus;
    private bool _expandPhaseInfo;
    private bool _expandEnergy;
    private bool _expandCharts;
    private bool _expandAlarms;
    private bool _expandResolved;
    private bool _expandQuickActions;

    private SparklineData? _sparklinePower;
    private SparklineData? _sparklineReactive;
    private SparklineData? _sparklineVoltage;
    private SparklineData? _sparklineCurrent;
    private SparklineData? _sparklinePf;
    private SparklineData? _sparklineTemp;

    private class SparklineData
    {
        public string Line { get; set; } = "";
        public string Area { get; set; } = "";
    }

    private SparklineData? BuildSparkline(Func<SnapshotDto, decimal> valueFn, decimal minRef, decimal maxRef, int maxPoints = 20)
    {
        var snaps = _data?.ChartSnapshots;
        if (snaps == null || snaps.Count < 1) return null;
        var vals = snaps.Select(valueFn).TakeLast(maxPoints).ToArray();
        if (vals.Length < 1) return null;
        var lo = minRef < maxRef ? minRef : vals.Min();
        var hi = minRef < maxRef ? maxRef : vals.Max();
        var range = hi - lo;
        if (range < 1e-9m) range = 0;
        var w = 100m; var h = 20m; var m = h - 2;
        var count = vals.Length;
        decimal LineY(decimal v) => range > 0 ? h - Math.Clamp((v - lo) / range, 0, 1) * m - 1 : h / 2;
        if (count == 1)
        {
            var y = LineY(vals[0]);
            var line = $"M0,{y:F1} L{w},{y:F1}";
            var area = $"{line} L{w},{h} L0,{h} Z";
            return new SparklineData { Line = line, Area = area };
        }
        var step = (decimal)(w - 0) / (count - 1);
        var pts = vals.Select((v, i) => $"{i * step:F1},{LineY(v):F1}").ToArray();
        var lineSvg = "M" + string.Join(" L", pts);
        var areaSvg = $"{lineSvg} L{w:F1},{h} L0,{h} Z";
        return new SparklineData { Line = lineSvg, Area = areaSvg };
    }

    private void UpdateSparklines()
    {
        var snaps = _data?.ChartSnapshots;
        if (snaps == null || snaps.Count < 1) return;
        var pc = _data?.SelectedDevice?.PhaseCount ?? 3;
        _sparklinePower = BuildSparkline(s => s.TotalPower, 0, 10000);
        _sparklineReactive = BuildSparkline(s =>
        {
            var sA = (decimal)s.VoltageA * (decimal)s.CurrentA;
            var qA = sA > 0 ? (decimal)Math.Sqrt((double)Math.Max(0, sA * sA - (decimal)s.PowerA * (decimal)s.PowerA)) : 0;
            var sB = pc >= 2 ? (decimal)s.VoltageB * (decimal)s.CurrentB : 0;
            var qB = sB > 0 ? (decimal)Math.Sqrt((double)Math.Max(0, sB * sB - (decimal)s.PowerB * (decimal)s.PowerB)) : 0;
            var sC = pc >= 3 ? (decimal)s.VoltageC * (decimal)s.CurrentC : 0;
            var qC = sC > 0 ? (decimal)Math.Sqrt((double)Math.Max(0, sC * sC - (decimal)s.PowerC * (decimal)s.PowerC)) : 0;
            var cnt = (qA > 0 ? 1 : 0) + (qB > 0 ? 1 : 0) + (qC > 0 ? 1 : 0);
            return cnt > 0 ? (qA + qB + qC) / cnt : 0;
        }, 0, 10000);
        _sparklineVoltage = BuildSparkline(s => s.VoltageA, 180, 260);
        _sparklineCurrent = BuildSparkline(s => s.CurrentA, 0, 50);
        _sparklinePf = BuildSparkline(s => s.PfA, 0.5m, 1);
        _sparklineTemp = BuildSparkline(s => s.Temperature, -10m, 50m);
    }


