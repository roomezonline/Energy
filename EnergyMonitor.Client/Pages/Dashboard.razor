@page "/dashboard"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthService Auth
@inject ToastService Toast

<div class="dash-container">
    @* ── Welcome Header ── *@
    <div class="dash-welcome">
        <div class="dash-welcome-bg"></div>
        <div class="dash-welcome-content">
            <div class="dash-welcome-avatar">@(Auth.CurrentUser?.FullName is { Length: >0 } n ? n[..1].ToUpper() : "?")</div>
            <div class="dash-welcome-text">
                <h1 class="dash-welcome-title">خوش آمدید، @(Auth.CurrentUser?.FullName ?? Auth.CurrentUser?.Username ?? "کاربر")</h1>
                <p class="dash-welcome-sub">به سامانه هوشمند مدیریت انرژی <strong>انرژی‌کال</strong> خوش آمدید. از طریق کارت‌های زیر به بخش‌های مختلف دسترسی پیدا کنید.</p>
            </div>
            <div class="dash-welcome-role">
                <span class="dash-role-badge">@(Auth.CurrentUser?.Role ?? "—")</span>
            </div>
        </div>
    </div>

    @* ── Quick Stats ── *@
    <div class="dash-stats">
        <div class="dash-stat">
            <div class="dash-stat-icon dash-stat-icon--blue">📟</div>
            <div class="dash-stat-body">
                <div class="dash-stat-val">@_deviceCount</div>
                <div class="dash-stat-lbl">دستگاه فعال</div>
            </div>
        </div>
        <div class="dash-stat">
            <div class="dash-stat-icon dash-stat-icon--green">🏢</div>
            <div class="dash-stat-body">
                <div class="dash-stat-val">@_centerCount</div>
                <div class="dash-stat-lbl">مرکز فعال</div>
            </div>
        </div>
        <div class="dash-stat">
            <div class="dash-stat-icon dash-stat-icon--gold">🔔</div>
            <div class="dash-stat-body">
                <div class="dash-stat-val">@_alarmCount</div>
                <div class="dash-stat-lbl">هشدار فعال</div>
            </div>
        </div>
        <div class="dash-stat">
            <div class="dash-stat-icon dash-stat-icon--purple">👥</div>
            <div class="dash-stat-body">
                <div class="dash-stat-val">@_userCount</div>
                <div class="dash-stat-lbl">کاربران</div>
            </div>
        </div>
    </div>

    @* ── Hero: Energy Monitoring ── *@
    <div class="dash-hero" @onclick="GoToMonitoring" role="button" tabindex="0">
        <div class="dash-hero-bg"></div>
        <div class="dash-hero-content">
            <div class="dash-hero-icon">📊</div>
            <div class="dash-hero-text">
                <h2 class="dash-hero-title">پایش انرژی</h2>
                <p class="dash-hero-desc">مشاهده لحظه‌ای مصرف، صورتحساب، نمودارهای تحلیلی و گزارش‌های دوره‌ای</p>
            </div>
            <div class="dash-hero-action">
                <span class="dash-hero-btn">ورود به پایش انرژی</span>
                <span class="dash-hero-arrow">←</span>
            </div>
        </div>
    </div>

    @* ── Feature Grid ── *@
    <div class="dash-feat-title">
        <span class="dash-feat-title-icon">🚀</span>
        <span>سایر بخش‌های مدیریتی</span>
    </div>
    <div class="dash-feats">
        @foreach (var f in _features)
        {
            <a href="@f.Href" class="dash-feat @f.CssClass">
                <div class="dash-feat-icon">@f.Icon</div>
                <div class="dash-feat-body">
                    <div class="dash-feat-name">@f.Name</div>
                    <div class="dash-feat-desc">@f.Desc</div>
                </div>
                <div class="dash-feat-arrow">←</div>
            </a>
        }
    </div>
</div>

@code {
    private int _deviceCount, _centerCount, _alarmCount, _userCount;

    private record DashFeature(string Icon, string Name, string Desc, string Href, string CssClass);

    private List<DashFeature> _features => new()
    {
        new("🗺️", "مناطق", "مدیریت مناطق جغرافیایی", "/regions", "dash-feat--blue"),
        new("📍", "استان‌ها", "مدیریت استان‌های هر منطقه", "/provinces", "dash-feat--coral"),
        new("🏙️", "شهرها", "مدیریت شهرهای هر استان", "/cities", "dash-feat--purple"),
        new("🏢", "مراکز", "ثبت و مدیریت مراکز مصرف", "/centers", "dash-feat--green"),
        new("📁", "گروه دستگاه", "دسته‌بندی دستگاه‌های اندازه‌گیری", "/device-groups", "dash-feat--gold"),
        new("📟", "دستگاه‌ها", "مدیریت دستگاه‌های متصل", "/devices", "dash-feat--blue"),
        new("⚙", "تنظیمات", "پیکربندی پارامترهای دستگاه", "/config", "dash-feat--coral"),
        new("🔔", "هشدارها", "رویدادها و آلارم‌های ثبت‌شده", "/alarms", "dash-feat--red"),
        new("💰", "تعرفه‌ها", "مدیریت نرخ‌ها و تعرفه‌های انرژی", "/billing/tariffs", "dash-feat--gold"),
        new("🧾", "صورتحساب", "محاسبه و صدور صورتحساب", "/billing", "dash-feat--green"),
        new("📈", "گزارش مصرف", "تحلیل و مقایسه مصرف انرژی", "/reports", "dash-feat--purple"),
        new("⛔", "محدودیت مصرف", "تعیین سقف مصرف مجاز", "/limits", "dash-feat--red"),
        new("📰", "اخبار", "مدیریت اخبار و اطلاعیه‌ها", "/news/manage", "dash-feat--blue"),
        new("🖼", "اسلایدر", "مدیریت تصاویر صفحه اصلی", "/sliders/manage", "dash-feat--green"),
    };

    private void GoToMonitoring() => Nav.NavigateTo("/monitoring");

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsLoggedIn) await LoadStats();
    }

    private async Task LoadStats()
    {
        try
        {
            var devTask = Http.GetFromJsonAsync<List<System.Text.Json.JsonElement>>("api/v2/devices");
            var centTask = Http.GetFromJsonAsync<List<System.Text.Json.JsonElement>>("api/v2/centers");
            var alarmTask = Http.GetFromJsonAsync<List<System.Text.Json.JsonElement>>("api/v2/alarms");
            var userTask = Http.GetFromJsonAsync<List<System.Text.Json.JsonElement>>("api/v2/users");

            await Task.WhenAll(devTask, centTask, alarmTask, userTask);

            if (devTask.Result is { } d) _deviceCount = d.Count(x => x.TryGetProperty("isActive", out var a) && a.GetBoolean());
            if (centTask.Result is { } c) _centerCount = c.Count(x => x.TryGetProperty("isActive", out var a) && a.GetBoolean());
            if (alarmTask.Result is { } a) _alarmCount = a.Count(x => x.TryGetProperty("isResolved", out var r) && !r.GetBoolean());
            if (userTask.Result is { } u) _userCount = u.Count;
        }
        catch { }
        StateHasChanged();
    }
}

<style>
/* ═══════════════════════════════════════════
   Landing Dashboard
   ═══════════════════════════════════════════ */
.dash-container{max-width:1100px;margin:0 auto;padding:24px 16px;font-family:var(--font)}
.dash-welcome{position:relative;border-radius:20px;overflow:hidden;margin-bottom:24px}
.dash-welcome-bg{position:absolute;inset:0;background:linear-gradient(135deg,#1e293b,#334155,#0f172a);z-index:0}
.dash-welcome-bg::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 80% 20%,rgba(59,130,246,.15),transparent 60%)}
.dash-welcome-content{position:relative;z-index:1;display:flex;align-items:center;gap:18px;padding:28px 32px;flex-wrap:wrap}
.dash-welcome-avatar{width:56px;height:56px;border-radius:16px;background:var(--grad-blue);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;flex-shrink:0;box-shadow:0 4px 16px rgba(59,130,246,.4)}
.dash-welcome-text{flex:1;min-width:200px}
.dash-welcome-title{font-size:22px;font-weight:800;color:#fff;margin:0;line-height:1.3}
.dash-welcome-sub{font-size:13px;color:rgba(255,255,255,.7);margin:4px 0 0;line-height:1.6}
.dash-welcome-sub strong{color:#fbbf24}
.dash-welcome-role{flex-shrink:0}
.dash-role-badge{display:inline-block;padding:4px 16px;border-radius:20px;background:rgba(255,255,255,.1);color:rgba(255,255,255,.85);font-size:11px;font-weight:700;border:1px solid rgba(255,255,255,.15);backdrop-filter:blur(4px)}
.dash-stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:24px}
.dash-stat{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:16px;display:flex;align-items:center;gap:14px;transition:all .25s}
.dash-stat:hover{border-color:var(--blue);box-shadow:0 4px 20px rgba(59,130,246,.08);transform:translateY(-2px)}
.dash-stat-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.dash-stat-icon--blue{background:var(--blue-bg);color:var(--blue)}
.dash-stat-icon--green{background:var(--green-bg);color:var(--green)}
.dash-stat-icon--gold{background:var(--gold-bg);color:var(--gold)}
.dash-stat-icon--purple{background:#f0f0ff;color:var(--purple)}
.dash-stat-body{flex:1}
.dash-stat-val{font-size:26px;font-weight:800;color:var(--text);line-height:1.1}
.dash-stat-lbl{font-size:12px;color:var(--text-secondary);margin-top:2px}
.dash-hero{position:relative;border-radius:20px;overflow:hidden;margin-bottom:28px;cursor:pointer;transition:all .3s}
.dash-hero:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(59,130,246,.25)}
.dash-hero:active{transform:scale(.98)}
.dash-hero-bg{position:absolute;inset:0;background:linear-gradient(135deg,#2563eb,#7c3aed,#1e40af);z-index:0}
.dash-hero-bg::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 20% 80%,rgba(255,255,255,.1),transparent 50%)}
.dash-hero-content{position:relative;z-index:1;display:flex;align-items:center;gap:20px;padding:32px 36px;flex-wrap:wrap}
.dash-hero-icon{width:64px;height:64px;border-radius:18px;background:rgba(255,255,255,.15);color:#fff;display:flex;align-items:center;justify-content:center;font-size:32px;flex-shrink:0;backdrop-filter:blur(4px);box-shadow:0 4px 12px rgba(0,0,0,.15)}
.dash-hero-text{flex:1;min-width:200px}
.dash-hero-title{font-size:26px;font-weight:800;color:#fff;margin:0;text-shadow:0 2px 8px rgba(0,0,0,.15)}
.dash-hero-desc{font-size:14px;color:rgba(255,255,255,.8);margin:6px 0 0;line-height:1.6}
.dash-hero-action{display:flex;align-items:center;gap:12px;flex-shrink:0}
.dash-hero-btn{display:inline-block;padding:12px 24px;border-radius:12px;background:#fff;color:#2563eb;font-size:14px;font-weight:700;white-space:nowrap;transition:all .2s;box-shadow:0 4px 12px rgba(0,0,0,.15)}
.dash-hero:hover .dash-hero-btn{background:#f0f9ff;transform:translateX(-4px)}
.dash-hero-arrow{font-size:20px;color:rgba(255,255,255,.6);transition:transform .3s}
.dash-hero:hover .dash-hero-arrow{transform:translateX(-6px)}
.dash-feat-title{display:flex;align-items:center;gap:8px;font-size:16px;font-weight:700;color:var(--text);margin-bottom:16px}
.dash-feat-title-icon{font-size:18px}
.dash-feats{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.dash-feat{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:14px;border:1px solid var(--border);background:var(--bg-card);text-decoration:none;transition:all .25s;position:relative;overflow:hidden}
.dash-feat:hover{border-color:var(--blue);box-shadow:0 4px 20px rgba(59,130,246,.1);transform:translateY(-2px)}
.dash-feat:active{transform:scale(.97)}
.dash-feat-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;transition:all .3s}
.dash-feat:hover .dash-feat-icon{transform:scale(1.1) rotate(-5deg)}
.dash-feat-body{flex:1;min-width:0}
.dash-feat-name{font-size:13px;font-weight:700;color:var(--text);margin-bottom:2px}
.dash-feat-desc{font-size:11px;color:var(--text-muted);line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dash-feat-arrow{font-size:14px;color:var(--text-muted);transition:all .3s;flex-shrink:0;opacity:0}
.dash-feat:hover .dash-feat-arrow{opacity:1;color:var(--blue);transform:translateX(-4px)}
.dash-feat--blue .dash-feat-icon{background:var(--blue-bg);color:var(--blue)}
.dash-feat--green .dash-feat-icon{background:var(--green-bg);color:var(--green)}
.dash-feat--gold .dash-feat-icon{background:var(--gold-bg);color:var(--gold)}
.dash-feat--red .dash-feat-icon{background:var(--red-bg);color:var(--red)}
.dash-feat--purple .dash-feat-icon{background:#f0f0ff;color:var(--purple)}
.dash-feat--coral .dash-feat-icon{background:#fff7ed;color:var(--coral)}
@@media(max-width:768px){
    .dash-welcome-content{padding:24px 20px;flex-direction:column;text-align:center}
    .dash-welcome-role{align-self:center}
    .dash-hero-content{padding:24px 20px;flex-direction:column;text-align:center}
    .dash-hero-action{width:100%;justify-content:center}
    .dash-hero-btn{width:100%;text-align:center}
    .dash-hero-arrow{display:none}
    .dash-feats{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
}
@@media(max-width:640px){
    .dash-container{padding:16px 12px}
    .dash-welcome-title{font-size:18px}
    .dash-welcome-sub{font-size:12px}
    .dash-stats{grid-template-columns:repeat(2,1fr);gap:8px}
    .dash-stat{padding:12px}
    .dash-stat-val{font-size:20px}
    .dash-hero-title{font-size:20px}
    .dash-hero-desc{font-size:13px}
    .dash-feats{grid-template-columns:1fr;gap:8px}
    .dash-feat{padding:12px 14px}
}
</style>
