@page "/dashboard"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Rendering
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthService Auth

<div class="dashboard">
    <div class="loading-bar @(_isLoading ? "active" : "")"></div>

    @if (_showCenterModal)
    {
        <div class="modal-overlay" @onclick="() => _showCenterModal = false">
            <div class="selector-modal" @onclick:stopPropagation>
                <div class="selector-modal-header">
                    <h2>انتخاب مرکز</h2>
                    <button class="modal-close" @onclick="() => _showCenterModal = false">✕</button>
                </div>
                <div class="selector-modal-list">
                    @foreach (var c in _centers)
                    {
                        <div class="selector-modal-item @(c.Id == _selectedCenterId ? "selected" : "")"
                             @onclick="() => SelectCenter(c.Id)">
                            <div class="sel-item-icon">
                                <span class="sel-icon-center">🏢</span>
                            </div>
                            <div class="sel-item-info">
                                <div class="sel-item-name">@c.Name</div>
                                <div class="sel-item-meta">
                                    <span class="sel-tag">@c.Id.ToString()[..8]</span>
                                </div>
                            </div>
                            @if (c.Id == _selectedCenterId)
                            { <span class="sel-check">✓</span> }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (_showDeviceModal)
    {
        <div class="modal-overlay" @onclick="() => _showDeviceModal = false">
            <div class="selector-modal" @onclick:stopPropagation>
                <div class="selector-modal-header">
                    <h2>انتخاب کارگاه</h2>
                    <button class="modal-close" @onclick="() => _showDeviceModal = false">✕</button>
                </div>
                <div class="selector-modal-list">
                    @foreach (var d in _devices)
                    {
                        <div class="selector-modal-item @(d.DeviceId == _selectedDeviceId ? "selected" : "")"
                             @onclick="() => SelectDevice(d.DeviceId)">
                            <div class="sel-item-icon">
                                <span class="sel-dot @(d.LastSeenAt.HasValue && (DateTime.UtcNow - d.LastSeenAt.Value).TotalMinutes < 2 ? "online" : "")"></span>
                            </div>
                            <div class="sel-item-info">
                                <div class="sel-item-name">@d.DisplayName</div>
                                <div class="sel-item-meta">
                                    <span class="sel-tag">@d.DeviceId</span>
                                    @if (!string.IsNullOrEmpty(d.MacAddress))
                                    { <span class="sel-tag outline">@d.MacAddress</span> }
                                    @if (!string.IsNullOrEmpty(d.Location))
                                    { <span class="sel-tag outline">📍 @d.Location</span> }
                                </div>
                            </div>
                            @if (d.DeviceId == _selectedDeviceId)
                            { <span class="sel-check">✓</span> }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* Full-page loading overlay when changing center/device *@
    @if (_isChangingDevice)
    {
        <div class="dash-loader-overlay">
            <div class="dash-loader-box">
                <div class="dash-loader-spinner"></div>
                <div class="dash-loader-text">در حال بروزرسانی...</div>
            </div>
        </div>
    }

    @if (_data is null)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>در حال بارگذاری اطلاعات...</p>
        </div>
    }
    else
    {
        <div class="info-card @(_data.Connected ? "online" : "offline")">
            <div class="ht-bar">
                <div class="ht-left">
                    <span class="ht-date" id="date-display"></span>
                    <span class="status-spinner @(_data.Connected ? "online" : "offline")"></span>
                </div>
                <div class="ht-right">
                    <span class="status-dot"></span>
                    <span class="ht-status-text">@(_data.Connected ? "متصل" : "قطع")</span>
                </div>
            </div>
            <div class="ht-main">
                <div class="ht-info">
                    <div class="ht-selectors">
                        <div class="sel-chip sel-chip-center @(_centers.Count <= 1 ? "disabled" : "")"
                             @onclick="() => { if (_centers.Count > 1) _showCenterModal = true; }">
                            <span class="sel-chip-icon">🏢</span>
                            <span class="sel-chip-label">@(_centers.FirstOrDefault(c => c.Id == _selectedCenterId)?.Name ?? "انتخاب مرکز")</span>
                            <span class="sel-chip-arrow">▾</span>
                        </div>
                        <div class="sel-chip sel-chip-device @(_devices.Count == 0 ? "disabled" : "")"
                             @onclick="() => { if (_devices.Count > 0) _showDeviceModal = true; }">
                            <span class="sel-chip-icon">📟</span>
                            <span class="sel-chip-label">@(_devices.FirstOrDefault(d => d.DeviceId == _selectedDeviceId)?.DisplayName ?? "انتخاب کارگاه")</span>
                            <span class="sel-chip-arrow">▾</span>
                        </div>
                    </div>
                    <div class="ht-meta">
                        @if (!string.IsNullOrEmpty(_data.Center?.Code))
                        { <span class="badge">@_data.Center.Code</span> }
                        @if (!string.IsNullOrEmpty(_data.Center?.Province))
                        { <span class="badge outline">@_data.Center.Province</span> }
                    </div>
                </div>
                <div class="ht-avatar">
                    @if (!string.IsNullOrEmpty(_data.Center?.ImageFileName))
                    { <img src="/uploads/@_data.Center.ImageFileName" class="center-avatar-img" alt="" /> }
                    else
                    {
                        var _initial = _data.Center?.Name?[..1] ?? "🏭";
                        <div class="center-avatar-fallback">@_initial</div>
                    }
                </div>
            </div>
            <div class="ht-footer">
                @{
                    var _updClass = !_data.Connected ? "upd-red" :
                        (DateTime.UtcNow - (_data.LatestSnapshot?.Timestamp ?? DateTime.UtcNow)).TotalSeconds > 60 ? "upd-orange" : "upd-green";
                }
                <span class="ht-update @_updClass">🕐 آخرین بروزرسانی: @_data.LastUpdateText</span>
            </div>
        </div>

        var s = _data.LatestSnapshot;
        var isOnline = _data.Connected && s is not null;
        var pc = _data.SelectedDevice?.PhaseCount ?? 3;

        var phaseAOn = isOnline && s!.VoltageA > 0;
        var phaseBOn = pc >= 2 && isOnline && s!.VoltageB > 0;
        var phaseCOn = pc >= 3 && isOnline && s!.VoltageC > 0;

        var phaseAlarmsA = _data.ActiveAlarms?.Where(a => a.Phase == "A").ToList() ?? new();
        var phaseAlarmsB = _data.ActiveAlarms?.Where(a => a.Phase == "B").ToList() ?? new();
        var phaseAlarmsC = _data.ActiveAlarms?.Where(a => a.Phase == "C").ToList() ?? new();
        var alarmA = phaseAlarmsA.Count > 0;
        var alarmB = phaseAlarmsB.Count > 0;
        var alarmC = phaseAlarmsC.Count > 0;
        var criticalA = phaseAlarmsA.Any(a => a.Severity == "Critical");
        var criticalB = phaseAlarmsB.Any(a => a.Severity == "Critical");
        var criticalC = phaseAlarmsC.Any(a => a.Severity == "Critical");

        var hasVoltA = phaseAOn || (isOnline && s!.VoltageA > 0);
        var hasVoltB = phaseBOn || (pc >= 2 && isOnline && s!.VoltageB > 0);
        var hasVoltC = phaseCOn || (pc >= 3 && isOnline && s!.VoltageC > 0);
        var voltCount = (hasVoltA ? 1 : 0) + (hasVoltB ? 1 : 0) + (hasVoltC ? 1 : 0);
        if (voltCount == 0) voltCount = 1;

        var hasLoadA = phaseAOn && s!.CurrentA > 0;
        var hasLoadB = phaseBOn && s!.CurrentB > 0;
        var hasLoadC = phaseCOn && s!.CurrentC > 0;
        var loadCount = (hasLoadA ? 1 : 0) + (hasLoadB ? 1 : 0) + (hasLoadC ? 1 : 0);
        if (loadCount == 0) loadCount = 1;

        var avgV = isOnline ? ((hasVoltA ? s.VoltageA : 0) + (hasVoltB ? s.VoltageB : 0) + (hasVoltC ? s.VoltageC : 0)) / voltCount : 0;
        var avgI = isOnline ? ((hasLoadA ? (decimal)s.CurrentA : 0) + (hasLoadB ? (decimal)s.CurrentB : 0) + (hasLoadC ? (decimal)s.CurrentC : 0)) / loadCount : 0;
        var avgP = isOnline ? ((hasLoadA ? (decimal)s.PowerA : 0) + (hasLoadB ? (decimal)s.PowerB : 0) + (hasLoadC ? (decimal)s.PowerC : 0)) / loadCount : 0;
        decimal Nz(decimal v) => v;
        var sA = isOnline ? Nz((decimal)s.VoltageA * (decimal)s.CurrentA) : 0;
        var sB = isOnline ? Nz((decimal)s.VoltageB * (decimal)s.CurrentB) : 0;
        var sC = isOnline ? Nz((decimal)s.VoltageC * (decimal)s.CurrentC) : 0;
        var qA = isOnline ? (decimal)Math.Sqrt((double)Math.Max(0, Nz(sA * sA) - Nz((decimal)s.PowerA * (decimal)s.PowerA))) : 0;
        var qB = isOnline ? (decimal)Math.Sqrt((double)Math.Max(0, Nz(sB * sB) - Nz((decimal)s.PowerB * (decimal)s.PowerB))) : 0;
        var qC = isOnline ? (decimal)Math.Sqrt((double)Math.Max(0, Nz(sC * sC) - Nz((decimal)s.PowerC * (decimal)s.PowerC))) : 0;
        var avgQ = ((hasLoadA ? qA : 0) + (hasLoadB ? qB : 0) + (hasLoadC ? qC : 0)) / loadCount;
        var totalP = (hasLoadA ? (decimal)s.PowerA : 0) + (hasLoadB ? (decimal)s.PowerB : 0) + (hasLoadC ? (decimal)s.PowerC : 0);
        var totalS = (hasLoadA ? sA : 0) + (hasLoadB ? sB : 0) + (hasLoadC ? sC : 0);
        var avgPf = totalS > 0 ? Math.Clamp(totalP / totalS, 0, 1) : 0;

        var ambientTemp = isOnline && s.Temperature > -50 && s.Temperature < 100 ? (decimal)s.Temperature : (decimal?)null;
        var tempPct = ambientTemp is null
            ? 0 : Math.Clamp(((double)ambientTemp.Value - (-10)) / 50.0 * 100, 0, 100);

        decimal SafePct(decimal val, decimal scale) => val / scale * 100;
        var voltPct = SafePct(avgV - 180, 80);
        var powerPct = SafePct(avgP, 10000);
        var reactivePct = SafePct(avgQ, 10000);

        @if (!isOnline)
        {
            <div class="offline-banner">
                <span class="offline-icon">⚠</span>
                <span>دستگاه آفلاین است — آخرین ارتباط: @_data.LastUpdateText</span>
            </div>
        }

            <svg style="position:absolute;width:0;height:0" aria-hidden="true">
                <defs>
                    <linearGradient id="grad-red" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#ef4444" stop-opacity=".9"/>
                        <stop offset="40%" stop-color="#f97316" stop-opacity=".4"/>
                        <stop offset="100%" stop-color="#f97316" stop-opacity="0"/>
                    </linearGradient>
                    <linearGradient id="grad-gold" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#f59e0b" stop-opacity=".9"/>
                        <stop offset="40%" stop-color="#ea580c" stop-opacity=".4"/>
                        <stop offset="100%" stop-color="#ea580c" stop-opacity="0"/>
                    </linearGradient>
                    <linearGradient id="grad-blue" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#3b82f6" stop-opacity=".9"/>
                        <stop offset="40%" stop-color="#8b5cf6" stop-opacity=".4"/>
                        <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0"/>
                    </linearGradient>
                    <linearGradient id="grad-green" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#06b6d4" stop-opacity=".9"/>
                        <stop offset="40%" stop-color="#10b981" stop-opacity=".4"/>
                        <stop offset="100%" stop-color="#10b981" stop-opacity="0"/>
                    </linearGradient>
                    <linearGradient id="grad-purple" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#8b5cf6" stop-opacity=".9"/>
                        <stop offset="40%" stop-color="#ec4899" stop-opacity=".4"/>
                        <stop offset="100%" stop-color="#ec4899" stop-opacity="0"/>
                    </linearGradient>
                    <linearGradient id="grad-pink" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#ec4899" stop-opacity=".9"/>
                        <stop offset="40%" stop-color="#f472b6" stop-opacity=".4"/>
                        <stop offset="100%" stop-color="#f472b6" stop-opacity="0"/>
                    </linearGradient>
                    <linearGradient id="gauge-fill-a" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#f97316"/>
                        <stop offset="100%" stop-color="#ea580c"/>
                    </linearGradient>
                    <linearGradient id="gauge-fill-b" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#3b82f6"/>
                        <stop offset="100%" stop-color="#3b82f6"/>
                    </linearGradient>
                    <linearGradient id="gauge-fill-c" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#ef4444"/>
                        <stop offset="100%" stop-color="#ef4444"/>
                    </linearGradient>
                    <linearGradient id="gauge-bg-c" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#fef2f2"/>
                        <stop offset="100%" stop-color="#fef2f2"/>
                    </linearGradient>
                    <linearGradient id="gauge-bg-a" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#fff7ed"/>
                        <stop offset="100%" stop-color="#fff7ed"/>
                    </linearGradient>
                    <linearGradient id="gauge-bg-b" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#dbeafe"/>
                        <stop offset="100%" stop-color="#dbeafe"/>
                    </linearGradient>
                    <linearGradient id="gauge-bg-c" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#d1fae5"/>
                        <stop offset="100%" stop-color="#d1fae5"/>
                    </linearGradient>
                </defs>
            </svg>

            <div class="cards @(isOnline ? "" : "offline")">
                <div class="card power">
                    <svg class="progress-ring" viewBox="0 0 108 108" width="120" height="120">
                        <circle class="ring-track" cx="54" cy="54" r="42"/>
                        <circle class="ring-fill" cx="54" cy="54" r="42"
                            stroke-dasharray="263.9" stroke-dashoffset="@(263.9m * (1 - powerPct / 100))" />
                        <text x="54" y="48" text-anchor="middle" fill="var(--text)" font-size="20" font-weight="700">@SmartPower(avgP)</text>
                        <text x="54" y="68" text-anchor="middle" fill="var(--text-light)" font-size="10">@SmartPowerUnit(avgP)</text>
                    </svg>
                    <svg class="card-sparkline" viewBox="0 0 100 20" preserveAspectRatio="none">
                        @if (_sparklinePower is not null) { <path d="@_sparklinePower.Area" fill="url(#grad-red)" /> <path d="@_sparklinePower.Line" class="sp-line" /> }
                    </svg>
                    <div class="card-label">توان میانگین</div>
                </div>
                <div class="card reactive">
                    <svg class="progress-ring" viewBox="0 0 108 108" width="120" height="120">
                        <circle class="ring-track" cx="54" cy="54" r="42"/>
                        <circle class="ring-fill" cx="54" cy="54" r="42"
                            stroke-dasharray="263.9" stroke-dashoffset="@(263.9m * (1 - reactivePct / 100))" />
                        <text x="54" y="48" text-anchor="middle" fill="var(--text)" font-size="20" font-weight="700">@SmartReactive(avgQ)</text>
                        <text x="54" y="68" text-anchor="middle" fill="var(--text-light)" font-size="10">@SmartReactiveUnit(avgQ)</text>
                    </svg>
                    <svg class="card-sparkline" viewBox="0 0 100 20" preserveAspectRatio="none">
                        @if (_sparklineReactive is not null) { <path d="@_sparklineReactive.Area" fill="url(#grad-gold)" /> <path d="@_sparklineReactive.Line" class="sp-line" /> }
                    </svg>
                    <div class="card-label">راکتیو میانگین</div>
                </div>
                <div class="card voltage">
                    <svg class="progress-ring" viewBox="0 0 108 108" width="120" height="120">
                        <circle class="ring-track" cx="54" cy="54" r="42"/>
                        <circle class="ring-fill" cx="54" cy="54" r="42"
                            stroke-dasharray="263.9" stroke-dashoffset="@(263.9m * (1 - voltPct / 100))" />
                        <text x="54" y="48" text-anchor="middle" fill="var(--text)" font-size="20" font-weight="700">@avgV.ToString("F1")</text>
                        <text x="54" y="68" text-anchor="middle" fill="var(--text-light)" font-size="10">V</text>
                    </svg>
                    <svg class="card-sparkline" viewBox="0 0 100 20" preserveAspectRatio="none">
                        @if (_sparklineVoltage is not null) { <path d="@_sparklineVoltage.Area" fill="url(#grad-blue)" /> <path d="@_sparklineVoltage.Line" class="sp-line" /> }
                    </svg>
                    <div class="card-label">ولتاژ میانگین</div>
                </div>
                <div class="card current">
                    <svg class="progress-ring" viewBox="0 0 108 108" width="120" height="120">
                        <circle class="ring-track" cx="54" cy="54" r="42"/>
                        <circle class="ring-fill" cx="54" cy="54" r="42"
                            stroke-dasharray="263.9" stroke-dashoffset="@(263.9m * (1 - (_currPct) / 100))" />
                        <text x="54" y="48" text-anchor="middle" fill="var(--text)" font-size="20" font-weight="700">@avgI.ToString("F2")</text>
                        <text x="54" y="68" text-anchor="middle" fill="var(--text-light)" font-size="10">A</text>
                    </svg>
                    <svg class="card-sparkline" viewBox="0 0 100 20" preserveAspectRatio="none">
                        @if (_sparklineCurrent is not null) { <path d="@_sparklineCurrent.Area" fill="url(#grad-green)" /> <path d="@_sparklineCurrent.Line" class="sp-line" /> }
                    </svg>
                    <div class="card-label">جریان میانگین</div>
                </div>
                <div class="card pf">
                    <svg class="progress-ring" viewBox="0 0 108 108" width="120" height="120">
                        <circle class="ring-track" cx="54" cy="54" r="42"/>
                        <circle class="ring-fill" cx="54" cy="54" r="42"
                            stroke-dasharray="263.9" stroke-dashoffset="@(263.9m * (1 - Math.Clamp((avgPf - 0.5m) / 0.5m * 100, 0, 100) / 100))" />
                        <text x="54" y="48" text-anchor="middle" fill="var(--text)" font-size="20" font-weight="700">@avgPf.ToString("F2")</text>
                        <text x="54" y="68" text-anchor="middle" fill="var(--text-light)" font-size="10">PF</text>
                    </svg>
                    <svg class="card-sparkline" viewBox="0 0 100 20" preserveAspectRatio="none">
                        @if (_sparklinePf is not null) { <path d="@_sparklinePf.Area" fill="url(#grad-purple)" /> <path d="@_sparklinePf.Line" class="sp-line" /> }
                    </svg>
                    <div class="card-label">ضریب توان</div>
                </div>
                <div class="card temperature">
                    <svg class="progress-ring" viewBox="0 0 108 108" width="120" height="120">
                        <circle class="ring-track" cx="54" cy="54" r="42"/>
                        <circle class="ring-fill" cx="54" cy="54" r="42"
                            stroke-dasharray="263.9"                             stroke-dashoffset="@(263.9m * (1 - (decimal)tempPct / 100))" />
                        <text x="54" y="48" text-anchor="middle" fill="var(--text)" font-size="20" font-weight="700">@(ambientTemp is null ? "—" : ambientTemp.Value.ToString("F1"))</text>
                        <text x="54" y="68" text-anchor="middle" fill="var(--text-light)" font-size="10">°C</text>
                    </svg>
                    <svg class="card-sparkline" viewBox="0 0 100 20" preserveAspectRatio="none">
                        @if (_sparklineTemp is not null) { <path d="@_sparklineTemp.Area" fill="url(#grad-pink)" /> <path d="@_sparklineTemp.Line" class="sp-line" /> }
                    </svg>
                    <div class="card-label">دمای محیط</div>
                </div>
            </div>

            <div class="collapse-section @(_expandPhaseStatus ? "expanded" : "")">
                <button class="collapse-hdr" @onclick="() => _expandPhaseStatus = !_expandPhaseStatus">
                    <h2 class="section-title">وضعیت فازها</h2>
                    <span class="collapse-arrow">▾</span>
                </button>
                @if (_expandPhaseStatus)
                {
                    <div class="collapse-body">
                        <div class="gauges-layout">
                            <div class="gauges-row">
                                @RenderGauge("A", phaseAOn, s, hasLoadA, avgPf)
                                @if (pc >= 2) { @RenderGauge("B", phaseBOn, s, hasLoadB, avgPf) }
                                @if (pc >= 3) { @RenderGauge("C", phaseCOn, s, hasLoadC, avgPf) }
                            </div>
                            <div class="chart-panel">
                                <h3>نمودار ولتاژ (V)</h3>
                                <div class="chart-panel-wrap">
                                    @if (_data.ChartSnapshots != null && _data.ChartSnapshots.Count > 0)
                                    {
                                        <canvas id="chartVoltage"></canvas>
                                    }
                                    else
                                    {
                                        <div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-muted);font-size:12px;">داده‌ای موجود نیست</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="collapse-section @(_expandPhaseInfo ? "expanded" : "")">
                <button class="collapse-hdr" @onclick="() => _expandPhaseInfo = !_expandPhaseInfo">
                    <h2 class="section-title">اطلاعات فازها</h2>
                    <span class="collapse-arrow">▾</span>
                </button>
                @if (_expandPhaseInfo)
                {
                    <div class="collapse-body">
                        <div class="phase-grid">
                            @RenderPhase("A", phaseAOn, alarmA, criticalA, phaseAlarmsA, s, qA, pc)
                            @if (pc >= 2)
                            {
                                @RenderPhase("B", phaseBOn, alarmB, criticalB, phaseAlarmsB, s, qB, pc)
                            }
                            @if (pc >= 3)
                            {
                                @RenderPhase("C", phaseCOn, alarmC, criticalC, phaseAlarmsC, s, qC, pc)
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="collapse-section @(_expandEnergy ? "expanded" : "")">
                <button class="collapse-hdr" @onclick="() => _expandEnergy = !_expandEnergy">
                    <h2 class="section-title">مصرف انرژی</h2>
                    <span class="collapse-arrow">▾</span>
                </button>
                @if (_expandEnergy)
                {
                    <div class="collapse-body">
                        <div class="cons-grid">
                            <div class="cons-card"><div class="cons-lbl">امروز</div><div class="cons-val">@SmartEnergy(_data.Consumption?.TodayKWh ?? 0)</div></div>
                            <div class="cons-card"><div class="cons-lbl">ماه جاری</div><div class="cons-val">@SmartEnergy(_data.Consumption?.MonthKWh ?? 0)</div></div>
                            <div class="cons-card"><div class="cons-lbl">پیک جریان A</div><div class="cons-sub">@SmartCurrent(_data.Consumption?.PeakCurrentA ?? 0)</div></div>
                            @if (pc >= 2)
                            {
                            <div class="cons-card"><div class="cons-lbl">پیک جریان B</div><div class="cons-sub">@SmartCurrent(_data.Consumption?.PeakCurrentB ?? 0)</div></div>
                            }
                            @if (pc >= 3)
                            {
                            <div class="cons-card"><div class="cons-lbl">پیک جریان C</div><div class="cons-sub">@SmartCurrent(_data.Consumption?.PeakCurrentC ?? 0)</div></div>
                            }
