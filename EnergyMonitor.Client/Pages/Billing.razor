    private void ConfirmDelete(TariffItem t) { _deleteTarget = t; }
    private void CloseModal() { _showModal = false; _deleteTarget = null; }

    private async Task SaveTariff()
    {
        _saving = true;
        try
        {
            HttpResponseMessage res;
            if (_editingId == Guid.Empty) res = await Http.PostAsJsonAsync("/api/v2/tariffs", _form);
            else res = await Http.PutAsJsonAsync($"/api/v2/tariffs/{_editingId}", _form);
            if (res.IsSuccessStatusCode) { _billResult = _editingId == Guid.Empty ? "تعرفه ساخته شد" : "تعرفه ویرایش شد"; _showModal = false; await Load(); }
            else { var err = await res.Content.ReadAsStringAsync(); _billResult = $"خطا: {err}"; }
        }
        catch (Exception ex) { _billResult = $"خطا در ذخیره: {ex.Message}"; }
        _saving = false;
    }

    private async Task DeleteTariff()
