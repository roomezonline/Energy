    private string P(decimal? value, string format = "N0") =>
        value.HasValue ? ToPersian(value.Value.ToString(format)) : "";
    private string P(decimal value, string format = "N0") =>
        ToPersian(value.ToString(format));
    private string P(int? value, string format = "N0") =>
        value.HasValue ? ToPersian(value.Value.ToString(format)) : "";
    private string P(int value, string format = "N0") =>
        ToPersian(value.ToString(format));
    private string P(DateTime? value, string format = "yyyy/MM/dd HH:mm") =>
        value.HasValue ? ToPersian(value.Value.ToString(format)) : "";
    private string P(DateTime value, string format = "yyyy/MM/dd HH:mm") =>
        ToPersian(value.ToString(format));
    private static string ToPersian(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (var c in s)
        {
            if (c >= '0' && c <= '9') sb.Append((char)('۰' + (c - '0')));
            else sb.Append(c);
        }
        return sb.ToString();
    }

    protected override async Task OnInitializedAsync()
    {
        _authorized = Auth.IsInRole("Admin") || Auth.IsInRole("SuperAdmin");
        if (_authorized) await Load();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var pc = new System.Globalization.PersianCalendar();
            var iranTz = TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran");
            var iranNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, iranTz);
            _billTo = $"{pc.GetYear(iranNow):D4}/{pc.GetMonth(iranNow):D2}/{pc.GetDayOfMonth(iranNow):D2}";
            var from = iranNow.AddDays(-30);
            _billFrom = $"{pc.GetYear(from):D4}/{pc.GetMonth(from):D2}/{pc.GetDayOfMonth(from):D2}";
            StateHasChanged();
        }
    }

    private async Task Load()
    {
        _loading = true;
        try
        {
            _tariffs = await Http.GetFromJsonAsync<List<TariffItem>>("/api/v2/tariffs") ?? new();
            _centers = await Http.GetFromJsonAsync<List<CenterRef>>("/api/v2/centers") ?? new();
            _consumerTypes = await Http.GetFromJsonAsync<List<ConsumerTypeItem>>("/api/v2/consumer-types") ?? new();
            _yearlyRates = await Http.GetFromJsonAsync<List<YearlyRateItem>>("/api/v2/yearly-base-rates") ?? new();
        }
        catch (Exception ex) { _billResult = $"خطا در بارگذاری: {ex.Message}"; }
        _loading = false;
    }

    private void SwitchTab(string tab) { _activeTab = tab; StateHasChanged(); }
    private void ShowCalc() { SwitchTab("calc"); }
    private void ShowTariffs() { SwitchTab("tariffs"); }
    private void ShowConsumerTypes() { SwitchTab("consumerTypes"); }
    private void ShowYearlyRates() { SwitchTab("yearlyRates"); }

    private async Task Calculate()
    {
        if (_selectedCenterId == Guid.Empty) { _billResult = "مرکز را انتخاب کنید"; return; }
        if (string.IsNullOrEmpty(_billFrom) || string.IsNullOrEmpty(_billTo)) { _billResult = "بازه تاریخ را انتخاب کنید"; return; }
        _calculating = true;
        _billData = null;
        try
        {
            var req = new BillingCalculationRequest
            {
                CenterId = _selectedCenterId,
                FromDate = _billFrom,
                ToDate = _billTo,
                TariffId = _selectedTariffId == Guid.Empty ? null : _selectedTariffId
            };
            var res = await Http.PostAsJsonAsync("/api/v2/billing/calculate", req);
            if (res.IsSuccessStatusCode)
            {
                _billData = await res.Content.ReadFromJsonAsync<BillingResultDto>();
                _saveInvoice = false;
                _lastCalcFrom = _billFrom; _lastCalcTo = _billTo;
            }
            else { var err = await res.Content.ReadAsStringAsync(); _billResult = $"خطا: {err}"; }
        }
        catch (Exception ex) { _billResult = $"خطا در محاسبه: {ex.Message}"; }
        _calculating = false;
    }

    private async Task SaveInvoice()
    {
        if (_billData is null) return;
        _savingInvoice = true;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/v2/billing/save-invoice", _billData);
            if (res.IsSuccessStatusCode) { _billResult = "صورتحساب ذخیره شد"; _saveInvoice = true; await Load(); }
            else { var err = await res.Content.ReadAsStringAsync(); _billResult = $"خطا: {err}"; }
        }
        catch (Exception ex) { _billResult = $"خطا در ذخیره: {ex.Message}"; }
        _savingInvoice = false;
    }

