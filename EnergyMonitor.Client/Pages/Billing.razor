    private List<TieredRateItem> _bmTiers = new();
    private bool _bmSaving;
    private string? _bmMessage;
    private bool _bmMessageOk;

    private async Task LoadBillingModelTiers()
    {
        _bmMessage = null;
        _bmTiers.Clear();
        if (string.IsNullOrEmpty(_bmConsumerTypeCode) || _bmYear <= 0) return;
        try
        {
            var tiers = await Http.GetFromJsonAsync<List<TieredRateItem>>($"/api/v2/consumer-types/{_bmConsumerTypeCode}/tiers/{_bmYear}");
            _bmTiers = tiers ?? new();
        }
        catch { _bmMessage = "خطا در بارگذاری پله‌ها"; _bmMessageOk = false; }
    }

    private void AddBillingModelTier()
    {
        _bmTiers.Add(new TieredRateItem
        {
            TierFrom = _bmTiers.Count > 0 ? _bmTiers.Last().TierTo : 0,
            TierTo = _bmTiers.Count > 0 ? _bmTiers.Last().TierTo + 100 : 100,
            Coefficient = 1,
            RatePerKwh = 0,
            SortOrder = _bmTiers.Count + 1
        });
    }

    private void RemoveBillingModelTier(TieredRateItem item) { _bmTiers.Remove(item); }

    private async Task SaveBillingModelTiers()
    {
        _bmMessage = null;
        _bmMessageOk = false;

        // Frontend validation
        var errors = ValidateBillingModelTiers();
        if (errors.Count > 0)
        {
            _bmMessage = string.Join(" | ", errors);
            _bmSaving = false;
            return;
        }

        _bmSaving = true;
        try
        {
            for (int i = 0; i < _bmTiers.Count; i++) _bmTiers[i].SortOrder = i + 1;
            var res = await Http.PutAsJsonAsync($"/api/v2/consumer-types/{_bmConsumerTypeCode}/tiers/{_bmYear}", _bmTiers);
            if (res.IsSuccessStatusCode)
            {
                _bmMessage = "مدل محاسبه ذخیره شد";
                _bmMessageOk = true;
                var saved = await res.Content.ReadFromJsonAsync<List<TieredRateItem>>();
                if (saved is not null) _bmTiers = saved;
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                _bmMessage = $"خطا: {err}";
                _bmMessageOk = false;
            }
        }
        catch (Exception ex) { _bmMessage = $"خطا: {ex.Message}"; _bmMessageOk = false; }
        _bmSaving = false;
    }

    private List<string> ValidateBillingModelTiers()
    {
        var errs = new List<string>();
        if (_bmTiers.Count == 0) { errs.Add("حداقل یک پله باید تعریف شود."); return errs; }

        var sorted = _bmTiers.OrderBy(t => t.SortOrder).ToList();
        for (int i = 0; i < sorted.Count; i++)
        {
            var t = sorted[i];
            if (t.TierFrom < 0) errs.Add($"پله {i + 1}: «از» نمی‌تواند منفی باشد.");
            if (t.TierTo < 0) errs.Add($"پله {i + 1}: «تا» نمی‌تواند منفی باشد.");
            if (t.TierTo > 0 && t.TierTo <= t.TierFrom) errs.Add($"پله {i + 1}: «تا» ({t.TierTo}) باید بزرگ‌تر از «از» ({t.TierFrom}) باشد.");
            if (t.Coefficient < 0) errs.Add($"پله {i + 1}: ضریب نمی‌تواند منفی باشد.");
            if (t.RatePerKwh < 0) errs.Add($"پله {i + 1}: نرخ نمی‌تواند منفی باشد.");
            if (i > 0 && t.TierFrom < sorted[i - 1].TierTo)
                errs.Add($"تداخل پله {i} و {i + 1}: پله {i} تا {sorted[i - 1].TierTo} تعریف شده ولی پله {i + 1} از {t.TierFrom} شروع می‌شود.");
        }
        return errs;
    }

    private async Task Calculate()
    {
        if (_selectedCenterId == Guid.Empty) { _billResult = "مرکز را انتخاب کنید"; return; }
        if (string.IsNullOrEmpty(_billFrom) || string.IsNullOrEmpty(_billTo)) { _billResult = "بازه تاریخ را انتخاب کنید"; return; }
        _calculating = true; _billData = null;
        try
        {
            var req = new BillingCalculationRequest { CenterId = _selectedCenterId, DeviceId = string.IsNullOrEmpty(_selectedDeviceId) ? null : _selectedDeviceId, FromDate = _billFrom, ToDate = _billTo, TariffId = _selectedTariffId == Guid.Empty ? null : _selectedTariffId };
            var res = await Http.PostAsJsonAsync("/api/v2/billing/calculate", req);
            if (res.IsSuccessStatusCode) { _billData = await res.Content.ReadFromJsonAsync<BillingResultDto>(); _saveInvoice = false; _lastCalcFrom = _billFrom; _lastCalcTo = _billTo; }
            else { var err = await res.Content.ReadAsStringAsync(); _billResult = $"خطا: {err}"; }
        }
        catch (Exception ex) { _billResult = $"خطا در محاسبه: {ex.Message}"; }
        _calculating = false;
    }

    private async Task SaveInvoice()
    {
        if (_billData is null) return; _savingInvoice = true;
        try { var res = await Http.PostAsJsonAsync("/api/v2/billing/save-invoice", _billData); if (res.IsSuccessStatusCode) { _billResult = "صورتحساب ذخیره شد"; _saveInvoice = true; await Load(); } else { var err = await res.Content.ReadAsStringAsync(); _billResult = $"خطا: {err}"; } }
        catch (Exception ex) { _billResult = $"خطا در ذخیره: {ex.Message}"; }
        _savingInvoice = false;
    }

