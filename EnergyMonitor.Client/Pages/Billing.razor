    private decimal GetDerivedBaseRate(TariffItem t)
    {
        var rate = _yearlyRates.FirstOrDefault(r => t.Year.HasValue && r.Year == t.Year.Value)
                   ?? _yearlyRates.OrderByDescending(r => r.Year).FirstOrDefault();
        if (rate is null) return 0;
        var ct = _consumerTypes.FirstOrDefault(c => c.Code == t.ConsumerTypeCode);
        var coeff = ct?.EcaCoefficient ?? 1m;
        return rate.BaseRatePerKwh * coeff;
    }

    private string GetBaseRateDisplay()
    {
        if (_form.RateDerivationMode != "Automatic" || string.IsNullOrEmpty(_form.ConsumerTypeCode) || !_form.Year.HasValue) return "—";
        var rate = _yearlyRates.FirstOrDefault(r => r.Year == _form.Year.Value)
                   ?? _yearlyRates.OrderByDescending(r => r.Year).FirstOrDefault(r => r.Year <= GetCurrentPersianYear());
        return rate != null ? $"{rate.BaseRatePerKwh:N0} ریال ({rate.Year})" : "—";
    }

