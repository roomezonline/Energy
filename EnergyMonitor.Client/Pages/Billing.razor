.bll-bm-example{font-size:11px;color:#075985;background:rgba(255,255,255,.7);padding:5px 8px;border-radius:6px;border:1px dashed #7dd3fc;line-height:1.5}

/* ── Tabs ── */
.bll-tabs{display:flex;gap:2px;margin-bottom:20px;background:var(--bg);padding:4px;border-radius:12px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.bll-tabs::-webkit-scrollbar{display:none}
.bll-tab{flex:0 0 auto;padding:10px 16px;font-size:13px;font-weight:600;color:var(--text-secondary);background:none;border:none;border-radius:9px;cursor:pointer;white-space:nowrap;transition:all .2s;font-family:var(--font)}
.bll-tab:hover{color:var(--text);background:var(--bg-alt)}
.bll-tab--on{color:#fff;background:var(--grad-blue)}
.bll-tab--help{padding:10px 12px;margin-right:auto}
.bll-tab--help.bll-tab--on{background:var(--bg-alt);color:var(--text)}

/* ── Filter bar (calc tab) ── */
.bll-filter-bar{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin-bottom:18px;padding:14px;background:var(--bg-card);border:1px solid var(--border);border-radius:14px}
.bll-fg{min-width:0}
.bll-fg-act{display:flex;align-items:flex-end}
.bll-fl{display:block;font-size:11px;font-weight:600;color:var(--text-secondary);margin-bottom:4px}
.bll-fi{width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:9px;background:var(--bg-card);color:var(--text);font-size:12px;outline:none;transition:border-color .2s,box-shadow .2s;font-family:var(--font)}
.bll-fi:focus{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-glow)}
.bll-fi-ltr{direction:ltr}
.bll-fi[disabled]{background:var(--bg);color:var(--text-muted);cursor:not-allowed}

/* ── Shared buttons ── */
.bll-btn{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:9px;font-size:12px;font-weight:600;border:none;cursor:pointer;transition:all .2s;font-family:var(--font);white-space:nowrap}
.bll-btn:active{transform:scale(.95)}
.bll-btn-blue{background:var(--grad-blue);color:#fff}
.bll-btn-blue:hover{box-shadow:var(--shadow-blue);transform:translateY(-1px)}
.bll-btn-blue:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none}
.bll-btn-green{background:var(--grad-green);color:#fff}
.bll-btn-green:hover{box-shadow:0 2px 10px rgba(16,185,129,.3);transform:translateY(-1px)}
.bll-btn-amber{background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff}
.bll-btn-amber:hover{box-shadow:0 2px 10px rgba(245,158,11,.3);transform:translateY(-1px)}
.bll-btn-outline{background:var(--bg);color:var(--text-secondary);border:1px solid var(--border)}
.bll-btn-outline:hover{background:var(--bg-alt);color:var(--text)}
.bll-btn-red{background:var(--red);color:#fff}
.bll-btn-red:hover{box-shadow:var(--shadow-red);transform:translateY(-1px)}
.bll-btn-sm{padding:6px 12px;border-radius:7px;font-size:11px;font-weight:600;border:none;cursor:pointer;transition:all .2s;font-family:var(--font)}
.bll-btn-sm:active{transform:scale(.93)}
.bll-btn-sm-edit{background:var(--blue-bg);color:var(--blue)}
.bll-btn-sm-edit:hover{background:var(--blue);color:#fff}
.bll-btn-sm-del{background:var(--red-bg);color:var(--red)}
.bll-btn-sm-del:hover{background:var(--red);color:#fff}

/* ── Toolbar bar ── */
.bll-bar{margin-bottom:16px}
.inv-toolbar{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap}

/* ── Empty ── */
.bll-empty{text-align:center;padding:50px 20px}
.bll-empty-i{font-size:40px;margin-bottom:10px;opacity:.4}
.bll-empty-t{font-size:15px;font-weight:700;color:var(--text);margin-bottom:4px}
.bll-empty-d{font-size:12px;color:var(--text-secondary)}

/* ── Card grid (tariffs, consumer types, yearly rates) ── */
.bll-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px}
.bll-card{display:flex;overflow:hidden;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;transition:all .2s}
.bll-card:hover{border-color:var(--blue);box-shadow:0 2px 12px rgba(59,130,246,.08);transform:translateY(-1px)}
.bll-card-bar{width:4px;flex-shrink:0}
.bll-card-bar--on{background:var(--grad-green)}
.bll-card-bar--off{background:#d1d5db}
.bll-card-bar--info{background:linear-gradient(135deg,#3b82f6,#6366f1)}
.bll-card-b{padding:14px;flex:1;display:flex;flex-direction:column}
.bll-card-top{display:flex;justify-content:space-between;gap:8px;margin-bottom:8px}
.bll-card-t{font-size:14px;font-weight:700;color:var(--text)}
.bll-card-d{font-size:11px;color:var(--text-muted);margin-top:2px}
.bll-card-body{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px}
.bll-card-meta{font-size:11px;color:var(--text-secondary);margin-bottom:6px}
.bll-card-acts{display:flex;gap:6px;margin-top:auto;padding-top:10px;border-top:1px solid var(--border)}
.bll-card-rates{display:flex;flex-direction:column;gap:4px;margin-bottom:8px}
.bll-tr{display:flex;align-items:center;gap:6px;font-size:12px}
.bll-tr-l{color:var(--text-secondary);min-width:45px}
.bll-tr-v{font-weight:700;color:var(--text);direction:ltr}

/* ── Billing model (tiered rates) ── */
.bll-panel .bll-fi[type=number]{direction:ltr;text-align:right;font-family:var(--font-mono)}
.bll-bm-example{font-size:12px;color:var(--text-secondary);background:var(--bg-alt);padding:8px 12px;border-radius:8px}
.bll-toast{padding:6px 14px;border-radius:8px;font-size:12px;font-weight:600}
.bll-toast-ok{background:var(--green-bg);color:var(--green)}
.bll-toast-er{background:var(--red-bg);color:var(--red)}
.bll-bar-info{font-size:13px;color:var(--text-secondary)}
.bll-tr-tm{font-size:10px;color:var(--text-muted);background:var(--bg);padding:1px 6px;border-radius:4px}
.bll-badge{font-size:10px;font-weight:700;padding:2px 9px;border-radius:20px;white-space:nowrap;display:inline-flex;align-items:center;line-height:1.4}
.bll-badge-on{background:var(--green-bg);color:var(--green)}
.bll-badge-off{background:var(--red-bg);color:var(--red)}
.bll-badge-info{background:var(--blue-bg);color:var(--blue)}
.bll-code{font-size:11px;color:var(--blue);background:var(--blue-bg);padding:0 6px;border-radius:4px;font-weight:600}
.bll-chip{font-size:11px;padding:3px 8px;border-radius:6px;font-weight:600}
.bll-chip-on{background:var(--green-bg);color:var(--green)}
.bll-chip-off{background:var(--bg-alt);color:var(--text-muted)}
.bll-eca{font-size:11px;color:var(--text-secondary)}
.bll-rate-val{font-size:22px;font-weight:800;color:var(--blue);direction:ltr}
.bll-rate-unit{font-size:12px;font-weight:500;color:var(--text-muted)}

/* ── Invoice display ── */
.inv-area{margin-top:8px}
.inv-bill{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:24px 20px;box-shadow:0 1px 4px rgba(0,0,0,.04)}
.inv-hdr{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}
.inv-hdr-left{display:flex;flex-direction:column;align-items:flex-start;gap:4px;min-width:0}
.inv-consumer-type{font-size:11px;font-weight:600;color:#64748b;white-space:nowrap}
.inv-hdr-center{text-align:center;flex:1}
.inv-logo{display:flex;align-items:center;gap:8px;flex-shrink:0}
.inv-logo-icon{font-size:32px}
.inv-logo-t{font-size:15px;font-weight:800;color:#1e293b}
.inv-logo-s{font-size:10px;color:#94a3b8}
.inv-title{font-size:18px;font-weight:800;color:#1e293b}
.inv-badge{font-size:11px;font-weight:700;color:var(--blue);background:var(--blue-bg);padding:3px 12px;border-radius:20px;display:inline-block}
.inv-meta{display:flex;gap:16px;margin-bottom:16px;flex-wrap:nowrap}
.inv-meta-c{display:flex;align-items:flex-start;gap:8px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;flex:1 1 0;min-width:0}
.inv-meta-duo{display:flex;gap:16px;flex:2 1 0;min-width:0}
.inv-meta-i{font-size:18px;margin-top:2px;flex-shrink:0}
.inv-meta-l{font-size:10px;color:#94a3b8;white-space:nowrap}
.inv-meta-v{font-size:13px;font-weight:600;color:#1e293b}
.inv-section{margin-bottom:14px}
.inv-section-t{font-size:13px;font-weight:700;color:#334155;margin-bottom:8px;padding-right:10px;border-right:3px solid var(--blue)}
.inv-tariff-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px}
.inv-tariff-row{display:flex;gap:20px;flex-wrap:wrap;margin-bottom:8px}
.inv-tariff-i{display:flex;gap:6px;font-size:12px}
.inv-tariff-l{color:#64748b}
.inv-tariff-v{font-weight:600;color:#1e293b}
.inv-tariff-formula{display:flex;align-items:center;gap:8px;font-size:12px;color:#475569;margin-bottom:8px;flex-wrap:wrap}
.inv-formula-op{color:#94a3b8;font-weight:700}
.inv-tariff-rates{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:8px}
.inv-rate{display:flex;align-items:center;gap:6px;font-size:12px;color:#475569;padding:5px 10px;border-radius:8px;background:#fff;border:1px solid #e2e8f0}
.inv-rate-op .inv-rate-d{width:8px;height:8px;border-radius:50%;background:var(--green)}
.inv-rate-mp .inv-rate-d{width:8px;height:8px;border-radius:50%;background:var(--gold)}
.inv-rate-p .inv-rate-d{width:8px;height:8px;border-radius:50%;background:var(--red)}
.inv-tou{font-size:11px;color:#64748b;margin-top:4px}
.inv-table-wr{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:8px;border:1px solid #e2e8f0;width:100%}
.inv-table{width:100%;table-layout:fixed;border-collapse:separate;border-spacing:0;font-size:12px;display:table}
.inv-table th{padding:8px 10px;text-align:center;background:#f8fafc;color:#64748b;font-weight:600;font-size:11px;white-space:nowrap;border-bottom:1px solid #e2e8f0}
.inv-table td{padding:7px 10px;text-align:center;color:#334155;border-bottom:1px solid #f1f5f9}
.inv-table tfoot td{padding:8px 10px;background:#f8fafc;border-top:1px solid #e2e8f0}
.inv-table-sm td,.inv-table-sm th{padding:5px 8px;font-size:11px}
.inv-table-xs td,.inv-table-xs th{padding:4px 6px;font-size:10px}
.inv-total{font-weight:600;color:var(--blue)}
.inv-grand{font-weight:800;color:#1e293b}
.inv-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-left:4px}
.inv-sep td{height:6px;background:#f8fafc}
.inv-highlight td{background:#f0fdf4;font-weight:700;color:#166534}
.inv-penalty td{color:var(--red);font-weight:600}
.inv-discount td{color:var(--green);font-weight:600}
.inv-pf{display:flex;gap:16px;flex-wrap:wrap}
.inv-pf-i{display:flex;align-items:center;gap:4px;font-size:12px;color:#475569}
.inv-pf-v{font-size:14px}
.inv-pf-avg{font-weight:700;color:#1e293b;margin-right:8px}
.inv-scroll{max-height:260px;overflow:auto;border-radius:8px;border:1px solid #e2e8f0;width:100%}
.inv-saved{display:flex;flex-wrap:wrap;gap:6px}
.inv-saved-c{display:flex;gap:6px;align-items:center;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:6px 10px;font-size:11px}
.inv-saved-b{font-size:10px;font-weight:700;padding:1px 7px;border-radius:12px;background:#e2e8f0;color:#64748b}
.inv-saved-b--on{background:var(--green-bg);color:var(--green)}
.inv-saved-p{font-weight:600;color:#1e293b}
.inv-summary{border-top:2px solid #1e293b;padding-top:12px;margin-top:14px;max-width:360px;margin-right:auto}
.inv-sum-r{display:flex;justify-content:space-between;font-size:12px;padding:4px 0;color:#475569}
.inv-sum-grand{font-size:15px;font-weight:800;color:#1e293b;padding-top:6px;border-top:1px solid #e2e8f0;margin-top:4px}
.inv-ftr{display:flex;justify-content:space-between;font-size:10px;color:#94a3b8;margin-top:16px;padding-top:10px;border-top:1px solid #e2e8f0}
.inv-override{background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:14px;margin-bottom:14px}
.inv-override-t{font-size:13px;font-weight:700;color:#92400e;margin-bottom:8px}
.inv-override-r{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:6px}
.inv-override-l{min-width:120px;font-size:12px;color:#475569}
.inv-override-a{font-size:11px;color:#94a3b8}
.inv-override-n{font-size:11px;color:#92400e;margin-top:6px}

/* ── Saved invoice cards ── */
.bll-invoices{margin-top:20px}
.bll-invoices-t{font-size:14px;font-weight:700;color:var(--text);margin-bottom:10px}
.bll-invoices-g{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px}
.bll-inv-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.bll-inv-top{padding:8px 12px;background:var(--bg-alt);border-bottom:1px solid var(--border)}
.bll-inv-b{padding:10px 12px;display:flex;flex-direction:column;gap:5px}
.bll-inv-r{display:flex;justify-content:space-between;font-size:12px;color:var(--text-secondary)}
.bll-inv-grand{font-weight:700;color:var(--text);padding-top:4px;border-top:1px solid var(--border);margin-top:2px}

/* ── Overlay + Modal ── */
.bll-overlay{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.2);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:16px;animation:bll-fade .2s ease}
@@keyframes bll-fade{from{opacity:0}to{opacity:1}}
.bll-modal{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;width:100%;max-width:600px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.15);animation:bll-up .35s cubic-bezier(.34,1.56,.64,1)}
@@keyframes bll-up{from{opacity:0;transform:translateY(24px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.bll-modal--wide{max-width:800px}
.bll-mh{display:flex;align-items:center;gap:10px;padding:16px 18px 12px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg-card);z-index:1}
.bll-mh-i{font-size:18px}
.bll-mh-t{flex:1;font-size:14px;font-weight:700;color:var(--text)}
.bll-mh-x{background:none;border:none;font-size:20px;color:var(--text-muted);cursor:pointer;padding:0;width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:7px;transition:color .2s}
.bll-mh-x:hover{background:var(--bg);color:var(--text)}
.bll-mb{padding:14px 18px}
.bll-mb p{font-size:13px;line-height:1.7;color:var(--text-secondary);margin-bottom:14px}
.bll-mf{display:flex;gap:8px;justify-content:flex-end;padding:12px 18px 16px;border-top:1px solid var(--border)}
.bll-modal-sub{font-size:12px;font-weight:700;color:var(--text);margin:14px 0 8px;padding-right:8px;border-right:3px solid var(--blue)}
.bll-modal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px}
.bll-modal-grid--6{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
.bll-hlp-step{display:flex;gap:10px;align-items:flex-start;margin-bottom:10px;font-size:13px;line-height:1.6;color:var(--text)}
.bll-hlp-n{width:22px;height:22px;border-radius:50%;background:var(--grad-blue);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;margin-top:2px}
.bll-hlp-tip{background:var(--gold-bg);border-right:3px solid var(--gold);padding:10px 14px;border-radius:10px;margin-top:12px;font-size:12px;color:#92400e;line-height:1.6}
.bll-hlp-sep{border-top:1px dashed var(--border);margin:16px 0}
.bll-hlp-tab-t{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:700;color:var(--text);margin-bottom:10px;padding-bottom:6px;border-bottom:2px solid var(--blue)}
.bll-hlp-tab-i{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
.bll-hlp-sub{margin:0 0 10px 32px;padding:10px 14px;background:var(--bg-alt);border-radius:10px;font-size:12px;line-height:2;color:var(--text-secondary)}
.bll-hlp-sub strong{color:var(--text)}

/* ── Responsive ── */
@@media(max-width:768px){
    .bll-wrap{padding:14px 10px}
    .bll-tabs{gap:2px;padding:3px;border-radius:10px}
    .bll-tab{padding:8px 12px;font-size:12px}
    .bll-filter-bar{gap:8px;padding:10px;grid-template-columns:repeat(auto-fill,minmax(140px,1fr))}
    .bll-grid{grid-template-columns:1fr;gap:8px}
    .bll-card-b{padding:12px}
    .bll-modal{border-radius:14px;max-width:100%!important;margin:0}
    .bll-modal--wide{max-width:100%!important}
    .bll-mh{padding:14px 16px 10px}
    .bll-mb{padding:12px 16px}
    .bll-mf{padding:10px 16px 14px}
    .bll-modal-grid{grid-template-columns:1fr 1fr;gap:8px}
    .bll-modal-grid--6{grid-template-columns:1fr 1fr}
    .inv-bill{width:100%!important;padding:14px 10px;border-radius:10px;overflow:hidden}
    .inv-hdr{flex-direction:row;flex-wrap:wrap;gap:6px}
    .inv-meta{flex-direction:column;gap:6px}
    .inv-meta-duo{flex-direction:row;gap:6px}
    .inv-meta-c{padding:6px 8px}
    .inv-section{width:100%!important}
    .inv-table-wr{width:100%!important;overflow-x:auto;border-radius:6px;border:1px solid #e2e8f0}
    .inv-table{width:100%!important;table-layout:fixed;min-width:0!important;border-collapse:separate;border-spacing:0;display:table}
    .inv-table td,.inv-table th{padding:4px 5px;white-space:normal;word-break:keep-all}
    .inv-table-sm td,.inv-table-sm th{padding:3px 4px;font-size:10px}
    .inv-table-xs td,.inv-table-xs th{padding:2px 3px;font-size:9px}
    .inv-scroll{width:100%!important;overflow:auto;border:1px solid #e2e8f0;border-radius:6px}
    .inv-summary{width:100%!important;max-width:none!important}
    .inv-override-r{flex-direction:column;align-items:stretch}
    .inv-override-l{min-width:auto}
    .inv-override .bll-fi{width:100%!important}
    .bll-invoices-g{grid-template-columns:1fr}
    .bll-empty{padding:40px 16px}
    .bll-inv-card{border-radius:10px}
    .inv-rate{font-size:11px;padding:4px 8px}
    .inv-pf{width:100%!important}
    .inv-saved{width:100%!important}
}

@@media(max-width:480px){
    .bll-filter-bar{grid-template-columns:1fr 1fr}
    .bll-filter-bar .bll-fg-act{grid-column:1/-1}
    .bll-modal-grid{grid-template-columns:1fr}
    .bll-modal-grid--6{grid-template-columns:1fr 1fr}
    .inv-table{width:100%!important;table-layout:fixed;min-width:0!important;font-size:10px;display:table}
    .inv-table td,.inv-table th{padding:2px 4px;white-space:normal;word-break:keep-all}
    .inv-table-sm td,.inv-table-sm th{padding:2px 3px;font-size:9px}
    .inv-table-xs td,.inv-table-xs th{padding:1px 2px;font-size:8px}
    .inv-title{font-size:14px}
    .inv-meta-v{font-size:12px}
    .bll-tab{padding:7px 10px;font-size:11px}
    .bll-bm-desc{flex-direction:column;gap:6px;padding:8px 10px}
    .bll-bm-icon{font-size:22px}
    .bll-bm-title{font-size:11px}
    .bll-bm-text{font-size:10px}
    .bll-bm-tbl{overflow-x:auto;font-size:10px}
    .bll-bm-tr{grid-template-columns:0.8fr 1.4fr 0.6fr 1fr;padding:2px 4px}
    .bll-bm-example{font-size:10px;padding:4px 6px}
}

@@media(max-width:480px){
    .bll-filter-bar{grid-template-columns:1fr 1fr}
    .bll-filter-bar .bll-fg-act{grid-column:1/-1}
    .bll-modal-grid{grid-template-columns:1fr}
    .bll-modal-grid--6{grid-template-columns:1fr 1fr}
