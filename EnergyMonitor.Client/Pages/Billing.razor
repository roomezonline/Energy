    private string GetBaseRateDisplay()
    {
        if (_form.RateDerivationMode != "ECA" || string.IsNullOrEmpty(_form.ConsumerTypeCode) || !_form.Year.HasValue) return "—";
        var rate = _yearlyRates.FirstOrDefault(r => r.Year == _form.Year.Value);
        if (rate != null) return rate.BaseRatePerKwh.ToString("N0") + " ریال";
        return "—";
    }

