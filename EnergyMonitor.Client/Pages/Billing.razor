@* Consumer Type Modal *@
@if (_showConsumerTypeModal)
{
    <div class="bll-overlay" @onclick="() => _showConsumerTypeModal = false">
        <div class="bll-modal" @onclick:stopPropagation>
            <div class="bll-mh"><span class="bll-mh-t">@(_editingConsumerTypeCode == null ? "نوع مصرف‌کننده جدید" : "ویرایش نوع مصرف‌کننده")</span><button class="bll-mh-x" @onclick="() => _showConsumerTypeModal = false">&times;</button></div>
            <div class="bll-mb">
                <div class="bll-modal-grid">
                    <div class="bll-fg"><label class="bll-fl">کد</label><input class="bll-fi" @bind="_consumerTypeForm.Code" /></div>
                    <div class="bll-fg"><label class="bll-fl">نام</label><input class="bll-fi" @bind="_consumerTypeForm.Name" /></div>
                    <div class="bll-fg"><label class="bll-fl">دسته‌بندی</label><select class="bll-fi" @bind="_consumerTypeForm.Category"><option value="Residential">خانگی</option><option value="Commercial">تجاری</option><option value="Industrial">صنعتی</option><option value="Agricultural">کشاورزی</option><option value="Other">سایر</option></select></div>
                    <div class="bll-fg"><label class="bll-fl">مدل محاسبه</label><select class="bll-fi" @bind="_consumerTypeForm.BillingModel"><option value="TOU">سه‌زمانه (TOU)</option><option value="Tiered">پلکانی</option><option value="Flat">تخت</option><option value="TOU_Tiered">TOU + پلکانی</option></select></div>
                    <div class="bll-bm-desc">
                        <div class="bll-bm-icon">@GetBillingModelIcon()</div>
                        <div class="bll-bm-body">
                            <div class="bll-bm-title">@GetBillingModelTitle()</div>
                            @if (_consumerTypeForm.BillingModel == "Tiered")
                            {
                                <div class="bll-bm-text">مصرف خانگی به <strong>۵ پله</strong> تقسیم می‌شود. نرخ هر پله = ضریب پله × قیمت تمام‌شده (<strong>۹,۵۳۷ ریال</strong>). الگوی مصرف عادی <strong>۲۰۰ kWh</strong> در ماه است.</div>
                                <div class="bll-bm-tbl">
                                    <div class="bll-bm-tr bll-bm-th"><span>پله</span><span>محدوده (kWh)</span><span>ضریب</span><span>نرخ (ریال)</span></div>
                                    <div class="bll-bm-tr"><span>۱</span><span>۰ — ۱۰۰</span><span>۰.۱۴۶</span><span>۱,۳۹۲</span></div>
                                    <div class="bll-bm-tr"><span>۲</span><span>۱۰۰ — ۲۰۰</span><span>۰.۱۷</span><span>۱,۶۲۱</span></div>
                                    <div class="bll-bm-tr"><span>۳</span><span>۲۰۰ — ۳۰۰</span><span>۰.۳۶۵</span><span>۳,۴۸۱</span></div>
                                    <div class="bll-bm-tr"><span>۴</span><span>۳۰۰ — ۵۰۰</span><span>۲.۵</span><span>۲۳,۸۴۳</span></div>
                                    <div class="bll-bm-tr"><span>۵</span><span>بالای ۵۰۰</span><span>۵.۰</span><span>۴۷,۶۸۵</span></div>
                                </div>
                                <div class="bll-bm-example">💡 مصرف ۲۵۰ kWh در ماه: پله ۱ (۱۰۰×۱,۳۹۲) + پله ۲ (۱۰۰×۱,۶۲۱) + پله ۳ (۵۰×۳,۴۸۱) = <strong>۴۷۶,۱۵۰ ریال</strong></div>
                            }
                            else if (_consumerTypeForm.BillingModel == "TOU")
                            {
                                <div class="bll-bm-text">شبانه‌روز به <strong>۳ بازه زمانی</strong> با ضرایب متفاوت تقسیم می‌شود. نرخ نهایی = نرخ پایه ECA (<strong>۱۴,۴۲۰ ریال</strong>) × ضریب ECA × ضریب TOU.</div>
                                <div class="bll-bm-tbl">
                                    <div class="bll-bm-tr bll-bm-th"><span>بازه</span><span>ساعت تابستان</span><span>ساعت زمستان</span><span>ضریب</span></div>
                                    <div class="bll-bm-tr bll-bm-td-green"><span>کم‌باری</span><span>۲۳ — ۶</span><span>۲۳ — ۶</span><span>۰.۵</span></div>
                                    <div class="bll-bm-tr bll-bm-td-blue"><span>میان‌باری</span><span>۶ — ۱۲</span><span>۶ — ۱۷</span><span>۱.۰</span></div>
                                    <div class="bll-bm-tr bll-bm-td-red"><span>اوج‌باری</span><span>۱۲ — ۲۳</span><span>۱۷ — ۲۳</span><span>۲.۰</span></div>
                                </div>
                                <div class="bll-bm-example">💡 مصرف ۱۰۰ kWh در اوج‌باری تابستان با ضریب ECA ۱.۲: ۱۰۰ × (۱۴,۴۲۰ × ۱.۲ × ۲.۰) = <strong>۳,۴۶۰,۸۰۰ ریال</strong></div>
                            }
                            else if (_consumerTypeForm.BillingModel == "Flat")
                            {
                                <div class="bll-bm-text">کل مصرف با <strong>یک نرخ ثابت</strong> محاسبه می‌شود. ساده‌ترین روش، مناسب برای مصرف‌کنندگان خاص (سایر).</div>
                                <div class="bll-bm-example">💡 نرخ ۱۲,۰۰۰ ریال با مصرف ۵۰۰ kWh: ۵۰۰ × ۱۲,۰۰۰ = <strong>۶,۰۰۰,۰۰۰ ریال</strong></div>
                            }
                            else if (_consumerTypeForm.BillingModel == "TOU_Tiered")
                            {
                                <div class="bll-bm-text">ترکیب <strong>TOU</strong> و <strong>پلکانی</strong>: نرخ پایه با ضریب ECA و ضرایب TOU (کم‌باری <strong>۰.۵</strong>، میان‌باری <strong>۱.۰</strong>، اوج‌باری <strong>۲.۰</strong>) محاسبه می‌شود، سپس پله‌های مصرف روی کل مصرف اعمال می‌شود. هزینه بین بازه‌ها به نسبت سهم هر بازه توزیع می‌شود.</div>
                                <div class="bll-bm-tbl">
                                    <div class="bll-bm-tr bll-bm-th"><span>پله</span><span>محدوده (kWh)</span><span>ضریب</span><span>نرخ پایه (ریال)</span></div>
                                    <div class="bll-bm-tr"><span>۱</span><span>۰ — ۱۰۰</span><span>۰.۱۴۶</span><span>۱,۳۹۲</span></div>
                                    <div class="bll-bm-tr"><span>۲</span><span>۱۰۰ — ۲۰۰</span><span>۰.۱۷</span><span>۱,۶۲۱</span></div>
                                    <div class="bll-bm-tr"><span>۳</span><span>۲۰۰ — ۳۰۰</span><span>۰.۳۶۵</span><span>۳,۴۸۱</span></div>
                                    <div class="bll-bm-tr"><span>۴</span><span>۳۰۰ — ۵۰۰</span><span>۲.۵</span><span>۲۳,۸۴۳</span></div>
                                    <div class="bll-bm-tr"><span>۵</span><span>بالای ۵۰۰</span><span>۵.۰</span><span>۴۷,۶۸۵</span></div>
                                </div>
                                <div class="bll-bm-example">💡 مثال: مصرف ۳۰۰ kWh در تابستان با ضریب ECA ۱.۰ — هزینه با پله‌ها محاسبه و به نسبت سهم هر بازه توزیع می‌شود. سهم اوج‌باری با ضریب ۲.۰ در نرخ پله‌ها لحاظ می‌شود.</div>
                            }
                        </div>
                    </div>
                    <div class="bll-fg"><label class="bll-fl">ضریب ECA</label><input class="bll-fi" type="number" step="0.0001" @bind="_consumerTypeForm.EcaCoefficient" /></div>
                    <div class="bll-fg"><label class="bll-fl">ترتیب نمایش</label><input class="bll-fi" type="number" @bind="_consumerTypeForm.SortOrder" /></div>
                    <div class="bll-fg"><label class="bll-fl">توضیحات</label><input class="bll-fi" @bind="_consumerTypeForm.Description" /></div>
                </div>
            </div>
            <div class="bll-mf">
                <button class="bll-btn bll-btn-outline" @onclick="() => _showConsumerTypeModal = false">انصراف</button>
                <button class="bll-btn bll-btn-blue" @onclick="SaveConsumerType">ذخیره</button>
            </div>
        </div>
    </div>
}

