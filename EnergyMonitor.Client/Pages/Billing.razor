@page "/billing/tariffs"
@page "/billing"
@page "/billing/consumer-types"
@page "/billing/yearly-rates"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using EnergyMonitor.Shared
@using EnergyMonitor.Client.Services
@using System.Net.Http.Json
@inject HttpClient Http
@inject AuthService Auth
@inject IJSRuntime JSRuntime

<div class="bll-wrap">
    @* Tabs *@
    <div class="bll-tabs">
        <button class="bll-tab @(_activeTab == "calc" ? "bll-tab--on" : "")" @onclick="ShowCalc">💰 محاسبه صورتحساب</button>
        <button class="bll-tab @(_activeTab == "tariffs" ? "bll-tab--on" : "")" @onclick="ShowTariffs">⚙️ تعرفه‌ها</button>
        <button class="bll-tab @(_activeTab == "consumerTypes" ? "bll-tab--on" : "")" @onclick="ShowConsumerTypes">🏭 انواع مصرف‌کننده</button>
        <button class="bll-tab @(_activeTab == "billingModels" ? "bll-tab--on" : "")" @onclick="ShowBillingModels">📐 مدل محاسبه</button>
        <button class="bll-tab @(_activeTab == "yearlyRates" ? "bll-tab--on" : "")" @onclick="ShowYearlyRates">📅 نرخ پایه سالانه</button>
        <button class="bll-tab bll-tab--help" @onclick="() => _showHelp = true">❓</button>
    </div>

    @if (_activeTab == "calc")
    {
        <div class="bll-panel">
            <div class="bll-filter-bar">
                <div class="bll-fg"><label class="bll-fl">مرکز</label><select class="bll-fi" @bind="_selectedCenterId"><option value="@Guid.Empty">انتخاب کنید</option>@foreach (var c in _centers) { <option value="@c.Id">@c.Name</option> }</select></div>
                <div class="bll-fg"><label class="bll-fl">دستگاه</label><select class="bll-fi" @bind="_selectedDeviceId"><option value="">همه دستگاه‌ها</option>@foreach (var d in _devices) { <option value="@d.DeviceId">@d.Name</option> }</select></div>
                <div class="bll-fg"><label class="bll-fl">از تاریخ</label><input class="bll-fi bll-fi-ltr" @bind="_billFrom" placeholder="۱۴۰۴/۰۱/۰۱" /></div>
                <div class="bll-fg"><label class="bll-fl">تا تاریخ</label><input class="bll-fi bll-fi-ltr" @bind="_billTo" placeholder="۱۴۰۴/۰۳/۳۱" /></div>
                <div class="bll-fg"><label class="bll-fl">تعرفه</label><select class="bll-fi" @bind="_selectedTariffId"><option value="@Guid.Empty">انتخاب کنید</option>@foreach (var t in _tariffs) { <option value="@t.Id">@t.Name</option> }</select></div>
                <div class="bll-fg bll-fg-act">
                    <button class="bll-btn bll-btn-blue" disabled="@_calculating" @onclick="Calculate">@(_calculating ? "⏳ محاسبه..." : "🔍 محاسبه و ذخیره")</button>
                </div>
            </div>

            @if (_billData is not null)
            {
                <div class="inv-area">
                    <div class="inv-toolbar">
                        <button class="bll-btn bll-btn-outline" @onclick="() => PrintInvoice()">📥 PDF</button>
                        @if (!_saveInvoice) { <button class="bll-btn bll-btn-green" @onclick="SaveInvoice" disabled="@_savingInvoice">@(_savingInvoice ? "..." : "💾 ذخیره")</button> }
                        @if (_billData?.EditableItems is not null && _billData.EditableItems.Count > 0)
                        {
                            <button class="bll-btn bll-btn-amber" @onclick="ToggleOverrideMode">✏️ @(_showOverrideEditor ? "بستن ویرایش" : "ویرایش مقادیر")</button>
                        }
                    </div>

                    @if (_showOverrideEditor && _billData?.EditableItems is not null)
                    {
                        <div class="inv-override">
                            <div class="inv-override-t">ویرایش دستی صورتحساب</div>
                            @foreach (var item in _billData.EditableItems)
                            {
                                <div class="inv-override-r">
                                    <span class="inv-override-l">@item.Label</span>
                                    <span class="inv-override-a">(خودکار: @P(item.AutoValue, "N0"))</span>
                                    <input type="number" class="bll-fi" style="width:120px" value="@(item.OverrideValue ?? item.AutoValue)" @onchange="(e) => OnOverrideChange(item.FieldName, decimal.Parse(e.Value?.ToString() ?? item.AutoValue.ToString()))" />
                                    <input class="bll-fi" style="width:180px" placeholder="دلیل تغییر" value="@item.OverrideReason" @onchange="(e) => OnOverrideReasonChange(item.FieldName, e.Value?.ToString())" />
                                    </div>
                                }
                                <div class="inv-override-n">مقادیر ویرایش شده پس از ذخیره در صورتحساب ثبت می‌شوند.</div>
                        </div>
                    }

                    <div class="inv-bill" id="invoiceArea">
                        <div class="inv-hdr">
                            <div class="inv-hdr-left">
                                @if (!string.IsNullOrEmpty(_billData.ConsumerTypeName))
                                {
                                    <div class="inv-consumer-type">@_billData.ConsumerTypeName</div>
                                }
                                <div class="inv-badge">@_billData.TariffName</div>
                            </div>
                            <div class="inv-hdr-center">
                                <div class="inv-title">صورتحساب مصرف انرژی</div>
                            </div>
                            <div class="inv-logo">
                                <span class="inv-logo-icon">⚡</span>
                                <div><div class="inv-logo-t">انرژی‌کال</div><div class="inv-logo-s">سامانه پایش هوشمند انرژی</div></div>
                            </div>
                        </div>
                        <div class="inv-meta">
                            <div class="inv-meta-c"><span class="inv-meta-i">🏢</span><div><div class="inv-meta-l">مشترک</div><div class="inv-meta-v">@_billData.CenterName</div></div></div>
                            <div class="inv-meta-duo">
                                <div class="inv-meta-c"><span class="inv-meta-i">📅</span><div><div class="inv-meta-l">دوره صورتحساب</div><div class="inv-meta-v">@_billData.FromDate لغایت @_billData.ToDate</div></div></div>
                                <div class="inv-meta-c"><span class="inv-meta-i">⏳</span><div><div class="inv-meta-l">مدت</div><div class="inv-meta-v">@P(_billData.Days) روز — @P(_billData.Months) ماه</div></div></div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_billData.ConsumerTypeName))
                        {
                            <div class="inv-section">
                                <div class="inv-section-t">اطلاعات تعرفه</div>
                                <div class="inv-tariff-card">
                                    <div class="inv-tariff-row">
                                        @if (_billData.Year.HasValue) { <div class="inv-tariff-i"><span class="inv-tariff-l">سال</span><span class="inv-tariff-v">@P(_billData.Year)</span></div> }
                                    </div>
                                    @if (_billData.EcaCoefficient.HasValue)
                                    {
                                        <div class="inv-tariff-formula">
                                            <span>نرخ پایه <strong>@P(_billData.BaseEcaRate, "N0")</strong> ریال/kWh</span>
                                            <span class="inv-formula-op">×</span>
                                            <span>ECA <strong>@P(_billData.EcaCoefficient, "F4")</strong></span>
                                        </div>
                                    }
                                    @if (_billData.TouOffPeakMultiplier.HasValue)
                                    {
                                        <div class="inv-tariff-rates">
                                            <div class="inv-rate inv-rate-op"><span class="inv-rate-d"></span>کم‌باری <strong>@P(_billData.EffectiveOffPeakRate, "N0")</strong></div>
                                            <div class="inv-rate inv-rate-mp"><span class="inv-rate-d"></span>میان‌باری <strong>@P(_billData.EffectiveMidPeakRate, "N0")</strong></div>
                                            <div class="inv-rate inv-rate-p"><span class="inv-rate-d"></span>اوج‌باری <strong>@P(_billData.EffectivePeakRate, "N0")</strong></div>
                                        </div>
                                    }
                                    else if (_billData.SupplyCostPerKwh.HasValue)
                                    {
                                        <div class="inv-tariff-rates"><div class="inv-rate">نرخ تأمین برق <strong>@P(_billData.SupplyCostPerKwh, "N0")</strong> ریال/kWh</div></div>
                                    }
                                    @if (_billData.TouOffPeakMultiplier.HasValue)
                                    {
                                        <div class="inv-tou">ضرایب TOU: کم‌باری <strong>@P(_billData.TouOffPeakMultiplier, "F1")</strong> | میان‌باری <strong>@P(_billData.TouMidPeakMultiplier, "F1")</strong> | اوج‌باری <strong>@P(_billData.TouPeakMultiplier, "F1")</strong></div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="inv-section">
                            <div class="inv-section-t">مصرف انرژی (kWh)</div>
                            <div class="inv-table-wr">
                                <table class="inv-table">
                                    <thead><tr><th>فاز</th><th>کم‌باری</th><th>میان‌باری</th><th>اوج‌باری</th><th>جمع</th></tr></thead>
                                    <tbody>
                                        <tr><td><span class="inv-dot" style="background:#f97316"></span>فاز A</td><td>@P(_billData.PhaseA.OffPeak, "N3")</td><td>@P(_billData.PhaseA.MidPeak, "N3")</td><td>@P(_billData.PhaseA.Peak, "N3")</td><td class="inv-total">@P(_billData.PhaseA.Total, "N3")</td></tr>
                                        <tr><td><span class="inv-dot" style="background:#3b82f6"></span>فاز B</td><td>@P(_billData.PhaseB.OffPeak, "N3")</td><td>@P(_billData.PhaseB.MidPeak, "N3")</td><td>@P(_billData.PhaseB.Peak, "N3")</td><td class="inv-total">@P(_billData.PhaseB.Total, "N3")</td></tr>
                                        <tr><td><span class="inv-dot" style="background:#ef4444"></span>فاز C</td><td>@P(_billData.PhaseC.OffPeak, "N3")</td><td>@P(_billData.PhaseC.MidPeak, "N3")</td><td>@P(_billData.PhaseC.Peak, "N3")</td><td class="inv-total">@P(_billData.PhaseC.Total, "N3")</td></tr>
                                    </tbody>
                                    <tfoot><tr><td><strong>جمع کل</strong></td><td><strong>@P(_billData.OffPeakKWh, "N3")</strong></td><td><strong>@P(_billData.MidPeakKWh, "N3")</strong></td><td><strong>@P(_billData.PeakKWh, "N3")</strong></td><td class="inv-grand">@P(_billData.TotalKWh, "N3")</td></tr></tfoot>
                                </table>
                            </div>
                        </div>

                        <div class="inv-section">
                            <div class="inv-section-t">هزینه مصرف (ریال)</div>
                            <div class="inv-table-wr">
                                <table class="inv-table inv-table-sm">
                                    <thead><tr><th>#</th><th>شرح</th><th>نرخ</th><th>مبلغ</th></tr></thead>
                                    <tbody>
                                        @{ int rIdx = 1; }
                                        @if (_billData.PhaseACost > 0 || _billData.PhaseBCost > 0 || _billData.PhaseCCost > 0)
                                        {
                                            <tr><td>@(rIdx++)</td><td>هزینه فاز A</td><td>@P(_billData.PhaseA.Total, "N3") kWh</td><td>@P(_billData.PhaseACost, "N0")</td></tr>
                                            <tr><td>@(rIdx++)</td><td>هزینه فاز B</td><td>@P(_billData.PhaseB.Total, "N3") kWh</td><td>@P(_billData.PhaseBCost, "N0")</td></tr>
                                            <tr><td>@(rIdx++)</td><td>هزینه فاز C</td><td>@P(_billData.PhaseC.Total, "N3") kWh</td><td>@P(_billData.PhaseCCost, "N0")</td></tr>
                                            <tr class="inv-sep"><td colspan="4"></td></tr>
                                        }
                                        @if (_billData.HasTieredRates)
                                        {
                                            if (_billData.Tier1KWh > 0 || _billData.Tier1Cost > 0) { <tr><td>@(rIdx++)</td><td>پله اول</td><td>@P(_billData.Tier1Rate, "N0") ریال/kWh</td><td>@P(_billData.Tier1Cost, "N0")</td></tr> }
                                            if (_billData.Tier2KWh > 0 || _billData.Tier2Cost > 0) { <tr><td>@(rIdx++)</td><td>پله دوم</td><td>@P(_billData.Tier2Rate, "N0") ریال/kWh</td><td>@P(_billData.Tier2Cost, "N0")</td></tr> }
                                            if (_billData.Tier3KWh > 0 || _billData.Tier3Cost > 0) { <tr><td>@(rIdx++)</td><td>پله سوم</td><td>@P(_billData.Tier3Rate, "N0") ریال/kWh</td><td>@P(_billData.Tier3Cost, "N0")</td></tr> }
                                        }
                                        else
                                        {
                                            <tr><td>@(rIdx++)</td><td>مصرف کم‌باری</td><td>@P(_billData.EffectiveOffPeakRate, "N0") ریال/kWh</td><td>@P(_billData.OffPeakCost, "N0")</td></tr>
                                            <tr><td>@(rIdx++)</td><td>مصرف میان‌باری</td><td>@P(_billData.EffectiveMidPeakRate, "N0") ریال/kWh</td><td>@P(_billData.MidPeakCost, "N0")</td></tr>
                                            <tr><td>@(rIdx++)</td><td>مصرف اوج‌باری</td><td>@P(_billData.EffectivePeakRate, "N0") ریال/kWh</td><td>@P(_billData.PeakCost, "N0")</td></tr>
                                        }
                                        <tr class="inv-highlight"><td>@(rIdx++)</td><td>جمع هزینه انرژی</td><td>—</td><td>@P(_billData.EnergyCost, "N0")</td></tr>
                                        @if (_billData.MonthlyFixedFee > 0) { <tr><td>@(rIdx++)</td><td>آبونمان (@P(_billData.Months) ماه)</td><td>@P(_billData.MonthlyFixedFee, "N0") ریال/ماه</td><td>@P(_billData.MonthlyFixedFeeTotal, "N0")</td></tr> }
                                        @if (_billData.DemandCost > 0) { <tr><td>@(rIdx++)</td><td>هزینه دیماند</td><td>@P(_billData.MaxDemandKW, "N0") kW</td><td>@P(_billData.DemandCost, "N0")</td></tr> }
                                        @if (_billData.PeakPenalty > 0) { <tr class="inv-penalty"><td>@(rIdx++)</td><td>جریمه اوج مصرف</td><td>—</td><td>@P(_billData.PeakPenalty, "N0")</td></tr> }
                                        @if (_billData.OffPeakDiscount > 0) { <tr class="inv-discount"><td>@(rIdx++)</td><td>تخفیف کم‌باری</td><td>—</td><td>-@P(_billData.OffPeakDiscount, "N0")</td></tr> }
                                        @if (_billData.Article16Cost > 0 || _billData.HasArticle16) { <tr><td>@(rIdx++)</td><td>قانون ماده ۱۶</td><td>—</td><td>@P(_billData.Article16Cost, "N0")</td></tr> }
                                        @if (_billData.TollAmount > 0) { <tr><td>@(rIdx++)</td><td>عوارض</td><td>—</td><td>@P(_billData.TollAmount, "N0")</td></tr> }
                                        @if (_billData.HasReactivePenalty) { <tr class="inv-penalty"><td>@(rIdx++)</td><td>جریمه راکتیو (PF: @P(_billData.AveragePfA, "F3"))</td><td>@P(_billData.ReactivePenaltyMultiplier, "F1")×</td><td>@P(_billData.ReactivePenalty, "N0")</td></tr> }
                                        @if (_billData.HasReactiveBonus) { <tr class="inv-discount"><td>@(rIdx++)</td><td>پاداش راکتیو</td><td>—</td><td>@P(_billData.ReactiveBonus, "N0")</td></tr> }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        @if (_billData.AveragePfA > 0 || _billData.AveragePfB > 0 || _billData.AveragePfC > 0)
                        {
                            <div class="inv-section">
                                <div class="inv-section-t">ضریب توان (PF)</div>
                                <div class="inv-pf">
                                    <div class="inv-pf-i"><span class="inv-dot" style="background:#f97316"></span>A: <strong class="inv-pf-v">@P(_billData.AveragePfA, "F3")</strong></div>
                                    <div class="inv-pf-i"><span class="inv-dot" style="background:#3b82f6"></span>B: <strong class="inv-pf-v">@P(_billData.AveragePfB, "F3")</strong></div>
                                    <div class="inv-pf-i"><span class="inv-dot" style="background:#ef4444"></span>C: <strong class="inv-pf-v">@P(_billData.AveragePfC, "F3")</strong></div>
                                    <div class="inv-pf-i inv-pf-avg">میانگین: <strong class="inv-pf-v">@P(_billData.AveragePf, "F3")</strong></div>
                                </div>
                            </div>
                        }

                        @if (_billData.PeriodDetails is not null && _billData.PeriodDetails.Count > 0)
                        {
                            <div class="inv-section">
                                <div class="inv-section-t">جزئیات روزانه مصرف</div>
                                <div class="inv-scroll">
                                    <table class="inv-table inv-table-xs">
                                        <thead><tr><th>تاریخ</th><th>کم‌باری</th><th>میان‌باری</th><th>اوج‌باری</th><th>جمع</th></tr></thead>
                                        <tbody>@foreach (var day in _billData.PeriodDetails) { <tr><td>@day.PersianDate</td><td>@P(day.OffPeakKWh, "N3")</td><td>@P(day.MidPeakKWh, "N3")</td><td>@P(day.PeakKWh, "N3")</td><td class="inv-total">@P(day.TotalKWh, "N3")</td></tr> }</tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        @if (_invoices.Count > 0)
                        {
                            <div class="inv-section">
                                <div class="inv-section-t">صورتحساب‌های ذخیره شده</div>
                                <div class="inv-saved">@foreach (var inv in _invoices) { <div class="inv-saved-c"><span class="inv-saved-b @(inv.Status == "Final" ? "inv-saved-b--on" : "")">@(inv.Status == "Final" ? "نهایی" : "پیش‌نویس")</span><span>@inv.FromDate → @inv.ToDate</span><span class="inv-saved-p">@P(inv.GrandTotal, "N0") ریال</span></div> }</div>
                            </div>
                        }

                        <div class="inv-summary">
                            <div class="inv-sum-r"><span>قبل از مالیات</span><span>@P(_billData.SubTotal, "N0") ریال</span></div>
                            <div class="inv-sum-r"><span>مالیات (@P(_billData.TaxPercent)%)</span><span>@P(_billData.TaxAmount, "N0") ریال</span></div>
                            <div class="inv-sum-r inv-sum-grand"><span>قابل پرداخت</span><span>@P(_billData.GrandTotal, "N0") <small>ریال</small></span></div>
                        </div>
                        <div class="inv-ftr">
                            <span>صادر شده توسط سامانه انرژی‌کال</span>
                            <span>@P(DateTime.Now, "yyyy/MM/dd HH:mm")</span>
                        </div>
                    </div>
                </div>
            }

            @if (_invoices.Count > 0)
            {
                <div class="bll-invoices">
                    <div class="bll-invoices-t">صورتحساب‌های ذخیره شده</div>
                    <div class="bll-invoices-g">
                        @foreach (var inv in _invoices)
                        {
                            <div class="bll-inv-card">
                                <div class="bll-inv-top"><span class="inv-saved-b @(inv.Status == "Final" ? "inv-saved-b--on" : "")">@(inv.Status == "Final" ? "نهایی" : "پیش‌نویس")</span></div>
                                <div class="bll-inv-b">
                                    <div class="bll-inv-r"><span>دوره</span><span>@inv.FromDate تا @inv.ToDate</span></div>
                                    <div class="bll-inv-r"><span>مدت</span><span>@P(inv.Days) روز</span></div>
                                    <div class="bll-inv-r"><span>مصرف</span><span>@P(inv.TotalKWh, "N3") kWh</span></div>
                                    <div class="bll-inv-r"><span>هزینه</span><span>@P(inv.EnergyCost, "N0") ریال</span></div>
                                    @if (inv.ReactivePenalty > 0) { <div class="bll-inv-r"><span>جریمه</span><span>@P(inv.ReactivePenalty, "N0") ریال</span></div> }
                                    <div class="bll-inv-r bll-inv-grand"><span>قابل پرداخت</span><span>@P(inv.GrandTotal, "N0") ریال</span></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (_activeTab == "tariffs")
    {
        <div class="bll-panel">
            <div class="bll-bar"><button class="bll-btn bll-btn-blue" @onclick="OpenCreateTariff">+ تعرفه جدید</button></div>
            @if (_tariffs.Count == 0)
            {
                <div class="bll-empty"><div class="bll-empty-i">⚙️</div><div class="bll-empty-t">هیچ تعرفه‌ای تعریف نشده</div><div class="bll-empty-d">روی دکمه بالا کلیک کنید تا اولین تعرفه را ایجاد کنید.</div></div>
            }
            else
            {
                <div class="bll-grid">
                    @foreach (var t in _tariffs)
                    {
                        <div class="bll-card">
                            <div class="bll-card-bar @(t.IsActive ? "bll-card-bar--on" : "bll-card-bar--off")"></div>
                            <div class="bll-card-b">
                                <div class="bll-card-top">
                                    <div><div class="bll-card-t">@t.Name</div>@if (!string.IsNullOrEmpty(t.Description)) { <div class="bll-card-d">@t.Description</div> }</div>
                                    <span class="bll-badge @(t.IsActive ? "bll-badge-on" : "bll-badge-off")">@(t.IsActive ? "فعال" : "غیرفعال")</span>
                                </div>
                                <div class="bll-card-rates">
                                    @if (t.RateDerivationMode == "Automatic")
                                    {
                                        <div class="bll-tr"><span class="bll-tr-l">نوع مصرف</span><span class="bll-tr-v">@(_consumerTypes.FirstOrDefault(c => c.Code == t.ConsumerTypeCode)?.Name ?? t.ConsumerTypeCode ?? "—")</span></div>
                                        <div class="bll-tr"><span class="bll-tr-l">سال</span><span class="bll-tr-v">@(t.Year?.ToString() ?? "—")</span></div>
                                        <div class="bll-tr"><span class="bll-tr-l">نرخ پایه</span><span class="bll-tr-v">@P(GetDerivedBaseRate(t), "N0") ریال</span></div>
                                    }
                                    else
                                    {
                                        <div class="bll-tr"><span class="bll-tr-l">کم‌باری</span><span class="bll-tr-v">@P(t.OffPeakRate, "N0")</span>@if(!string.IsNullOrEmpty(t.SummerOffPeakStart)){<span class="bll-tr-tm">@t.SummerOffPeakStart-@t.SummerOffPeakEnd</span>}</div>
                                        <div class="bll-tr"><span class="bll-tr-l">میان‌باری</span><span class="bll-tr-v">@P(t.MidPeakRate, "N0")</span>@if(!string.IsNullOrEmpty(t.SummerMidPeakStart)){<span class="bll-tr-tm">@t.SummerMidPeakStart-@t.SummerMidPeakEnd</span>}</div>
                                        <div class="bll-tr"><span class="bll-tr-l">اوج‌باری</span><span class="bll-tr-v">@P(t.PeakRate, "N0")</span>@if(!string.IsNullOrEmpty(t.SummerPeakStart)){<span class="bll-tr-tm">@t.SummerPeakStart-@t.SummerPeakEnd</span>}</div>
                                    }
                                </div>
                                <div class="bll-card-meta">
                                    <span>@(t.RateDerivationMode == "Automatic" ? "خودکار" : "ثابت")</span>
                                    <span>|</span>
                                    <span>آبونمان: @P(t.MonthlyFixedFee, "N0")</span>
                                    @if (t.ReactivePenaltyThreshold > 0) { <span>| PF &lt; @t.ReactivePenaltyThreshold</span> }
                                </div>
                                <div class="bll-card-acts">
                                    <button class="bll-btn-sm bll-btn-sm-edit" @onclick="() => EditTariff(t)">ویرایش</button>
                                    <button class="bll-btn-sm bll-btn-sm-del" @onclick="() => ConfirmDelete(t)">حذف</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (_activeTab == "consumerTypes")
    {
        <div class="bll-panel">
            <div class="bll-bar"><button class="bll-btn bll-btn-blue" @onclick="OpenCreateConsumerType">+ نوع مصرف‌کننده جدید</button></div>
            @if (_consumerTypes.Count == 0)
            {
                <div class="bll-empty"><div class="bll-empty-i">🏭</div><div class="bll-empty-t">هیچ نوع مصرف‌کننده‌ای تعریف نشده</div><div class="bll-empty-d">روی دکمه بالا کلیک کنید.</div></div>
            }
            else
            {
                <div class="bll-grid">
                    @foreach (var ct in _consumerTypes)
                    {
                        <div class="bll-card">
                            <div class="bll-card-bar bll-card-bar--info"></div>
                            <div class="bll-card-b">
                                <div class="bll-card-top">
                                    <div><div class="bll-card-t">@ct.Name <span class="bll-code">@ct.Code</span></div><div class="bll-card-d">@ct.Category</div></div>
                                    <span class="bll-badge bll-badge-info">@GetBillingModelLabel(ct.BillingModel)</span>
                                </div>
                                <div class="bll-card-body">
                                    <div class="bll-chip @(ct.HasTOU ? "bll-chip-on" : "bll-chip-off")">@(ct.HasTOU ? "✅ TOU" : "❌ TOU")</div>
                                    <div class="bll-chip @(ct.HasTieredRates ? "bll-chip-on" : "bll-chip-off")">@(ct.HasTieredRates ? "✅ پلکانی" : "❌ پلکانی")</div>
                                    <span class="bll-eca">ECA: @ct.EcaCoefficient</span>
                                </div>
                                <div class="bll-card-acts">
                                    <button class="bll-btn-sm bll-btn-sm-edit" @onclick="() => EditConsumerType(ct)">ویرایش</button>
                                    <button class="bll-btn-sm bll-btn-sm-del" @onclick="() => DeleteConsumerType(ct.Code)">حذف</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (_activeTab == "yearlyRates")
    {
        <div class="bll-panel">
            <div class="bll-bar"><button class="bll-btn bll-btn-blue" @onclick="OpenCreateYearlyRate">+ نرخ پایه جدید</button></div>
            @if (_yearlyRates.Count == 0)
            {
                <div class="bll-empty"><div class="bll-empty-i">📅</div><div class="bll-empty-t">هیچ نرخ پایه‌ای تعریف نشده</div><div class="bll-empty-d">روی دکمه بالا کلیک کنید.</div></div>
            }
            else
            {
                <div class="bll-grid">
                    @foreach (var yr in _yearlyRates)
                    {
                        <div class="bll-card">
                            <div class="bll-card-bar" style="background:linear-gradient(135deg,#7c3aed,#a78bfa)"></div>
                            <div class="bll-card-b">
                                <div class="bll-card-top">
                                    <div><div class="bll-card-t">سال @P(yr.Year)</div>@if (!string.IsNullOrEmpty(yr.SourceDocument)) { <div class="bll-card-d">@yr.SourceDocument</div> }</div>
                                </div>
                                <div class="bll-card-body">
                                    <div class="bll-rate-val">@P(yr.BaseRatePerKwh, "N0") <span class="bll-rate-unit">ریال/kWh</span></div>
                                    @if (!string.IsNullOrEmpty(yr.Description)) { <div class="bll-card-meta" style="margin-top:8px">@yr.Description</div> }
                                </div>
                                <div class="bll-card-acts">
                                    <button class="bll-btn-sm bll-btn-sm-edit" @onclick="() => EditYearlyRate(yr)">ویرایش</button>
                                    <button class="bll-btn-sm bll-btn-sm-del" @onclick="() => DeleteYearlyRate(yr.Year)">حذف</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    @if (_activeTab == "billingModels")
    {
        <div class="bll-panel">
            <div class="bll-filter-bar" style="grid-template-columns:1fr 1fr">
                <div class="bll-fg"><label class="bll-fl">نوع مصرف‌کننده</label><select class="bll-fi" @bind="_bmConsumerTypeCode" @bind:after="LoadBillingModelTiers"><option value="">انتخاب کنید</option>@foreach (var ct in _consumerTypes) { <option value="@ct.Code">@ct.Name (@ct.Code)</option> }</select></div>
                <div class="bll-fg"><label class="bll-fl">سال</label><select class="bll-fi" @bind="_bmYear" @bind:after="LoadBillingModelTiers"><option value="0">انتخاب کنید</option>@foreach (var yr in _yearlyRates) { <option value="@yr.Year">@yr.Year</option> }</select></div>
            </div>

            @if (_bmConsumerTypeCode != "" && _bmYear > 0)
            {
                <div style="margin-top:16px">
                    <div class="bll-bar" style="justify-content:space-between">
                        <span class="bll-bar-info">تعریف پله‌های مصرف برای <strong>@_consumerTypes.FirstOrDefault(c => c.Code == _bmConsumerTypeCode)?.Name</strong> — سال <strong>@_bmYear</strong></span>
                        <button class="bll-btn bll-btn-sm bll-btn-blue" @onclick="AddBillingModelTier">+ پله جدید</button>
                    </div>
                    @if (_bmTiers.Count == 0)
                    {
                        <div class="bll-empty"><div class="bll-empty-i">📐</div><div class="bll-empty-t">هیچ پله‌ای تعریف نشده</div><div class="bll-empty-d">روی دکمه "پله جدید" کلیک کنید.</div></div>
                    }
                    else
                    {
                        <div class="bll-tbl-wr" style="margin-top:12px">
                            <table class="bll-tbl">
                                <thead><tr><th>ترتیب</th><th>از (kWh)</th><th>تا (kWh)</th><th>ضریب</th><th>نرخ (ریال/kWh)</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var t in _bmTiers)
                                    {
                                        <tr>
                                            <td>@(_bmTiers.IndexOf(t) + 1)</td>
                                            <td><input class="bll-fi" type="number" style="width:80px" @bind="t.TierFrom" /></td>
                                            <td><input class="bll-fi" type="number" style="width:80px" @bind="t.TierTo" /></td>
                                            <td><input class="bll-fi" type="number" step="0.001" style="width:90px" @bind="t.Coefficient" /></td>
                                            <td><input class="bll-fi" type="number" step="1" style="width:110px" @bind="t.RatePerKwh" /></td>
                                            <td><button class="bll-btn-sm bll-btn-sm-del" @onclick="() => RemoveBillingModelTier(t)">✕</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="bll-bm-example" style="margin-top:12px">💡 مقدار صفر در «تا» به معنی بی‌نهایت است. اگر ضریب دارد، نرخ نهایی = ضریب × قیمت تمام‌شده (SupplyCost). اگر ضریب صفر باشد، «نرخ» مستقیماً استفاده می‌شود.</div>
                    }
                    <div class="bll-bar" style="margin-top:12px">
                        <button class="bll-btn bll-btn-blue" @onclick="SaveBillingModelTiers" disabled="@_bmSaving">@(_bmSaving ? "در حال ذخیره..." : "💾 ذخیره مدل محاسبه")</button>
                        @if (!string.IsNullOrEmpty(_bmMessage)) { <span class="bll-toast bll-toast-@(_bmMessageOk ? "ok" : "er")">@_bmMessage</span> }
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Help Modal *@
@if (_showHelp)
{
    <div class="bll-overlay" @onclick="() => _showHelp = false">
        <div class="bll-modal" @onclick:stopPropagation>
            <div class="bll-mh">
                <span class="bll-mh-i">📘</span>
                <span class="bll-mh-t">راهنمای جامع تعرفه‌ها و صورتحساب</span>
                <button class="bll-mh-x" @onclick="() => _showHelp = false">&times;</button>
            </div>
            <div class="bll-mb">
                <p>سیستم صورتحساب انرژی‌کال از <strong>۴ بخش</strong> تشکیل شده که در تب‌های بالا قابل دسترسی هستند. هر تب توضیح داده می‌شود:</p>

                <div class="bll-hlp-sep"></div>
                <div class="bll-hlp-tab-t">
                    <span class="bll-hlp-tab-i" style="background:#e8f5e9;color:#2e7d32">💰</span>
                    تب اول: محاسبه صورتحساب
                </div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">۱</span><span><strong>انتخاب مرکز و دستگاه</strong> — مرکز مصرف‌کننده و دستگاه دلخواه را انتخاب کنید. اگر دستگاهی انتخاب نکنید، مجموع همه دستگاه‌های آن مرکز محاسبه می‌شود.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">۲</span><span><strong>بازه صورتحساب</strong> — از تاریخ و تا تاریخ را به صورت شمسی (مثال ۱۴۰۴/۰۱/۰۱) وارد کنید. طول دوره حداقل یک روز و حداکثر یک سال می‌تواند باشد.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">۳</span><span><strong>انتخاب تعرفه</strong> — تعرفه مورد نظر را انتخاب کنید. تعرفه مشخص می‌کند نرخ‌ها چگونه محاسبه شوند (دستی یا خودکار ECA).</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">۴</span><span><strong>مشاهده نتایج</strong> — پس از محاسبه، صورتحساب شامل: جدول مصرف تفکیک فازها (A, B, C) و بازه‌ها (کم‌باری، میان‌باری، اوج‌باری)، هزینه انرژی (پله‌ای یا TOU)، آبونمان، دیماند، جریمه راکتیو، تخفیف کم‌باری، ماده ۱۶، عوارض، مالیات و جمع کل قابل پرداخت نمایش داده می‌شود.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">۵</span><span><strong>ویرایش دستی</strong> — دکمه "ویرایش مقادیر" به شما اجازه می‌دهد موارد خاص را دستی تغییر دهید و دلیل آن را ثبت کنید (مثلاً اعمال تخفیف یا اصلاح نرخ).</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">۶</span><span><strong>PDF و ذخیره</strong> — صورتحساب را می‌توانید به صورت PDF رنگی دریافت کنید یا در بانک اطلاعاتی ذخیره نمایید.</span></div>

                <div class="bll-hlp-sep"></div>
                <div class="bll-hlp-tab-t">
                    <span class="bll-hlp-tab-i" style="background:#fff3e0;color:#e65100">⚙️</span>
                    تب دوم: تعرفه‌ها
                </div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>تعریف تعرفه:</strong> هر تعرفه شامل یک نام، روش محاسبه (دستی یا خودکار ECA)، ساعت‌های TOU در تابستان و زمستان، و تنظیمات آبونمان و جریمه راکتیو است.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>روش دستی (ثابت):</strong> نرخ کم‌باری، میان‌باری و اوج‌باری را مستقیماً وارد می‌کنید. برای تعرفه‌های ساده یا قدیمی مناسب است.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>روش خودکار (ECA):</strong> نرخ‌ها به صورت خودکار محاسبه می‌شوند: <strong>نرخ پایه سالانه × ضریب ECA نوع مصرف‌کننده × ضریب TOU</strong>. ضرایب TOU ثابت هستند: کم‌باری ۰.۵، میان‌باری ۱.۰، اوج‌باری ۲.۰. نرخ پایه از "نرخ پایه سالانه" و ضریب ECA از "نوع مصرف‌کننده" خوانده می‌شود.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>ساعت‌های TOU:</strong> تابستان (ماه ۴ تا ۹) و زمستان (ماه ۱ تا ۳ و ۱۰ تا ۱۲) ساعت‌های متفاوتی دارند. مثلاً اوج‌باری تابستان ۱۲ تا ۲۳ و زمستان ۱۷ تا ۲۳ است.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>آبونمان:</strong> مبلغ ثابت ماهانه که به هر صورتحساب اضافه می‌شود.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>جریمه راکتیو:</strong> اگر ضریب توان (PF) از آستانه تعیین‌شده کمتر باشد، درصدی از هزینه انرژی به عنوان جریمه محاسبه می‌شود. همچنین اگر PF از حد بالاتر باشد، پاداش راکتیو تعلق می‌گیرد.</span></div>

                <div class="bll-hlp-sep"></div>
                <div class="bll-hlp-tab-t">
                    <span class="bll-hlp-tab-i" style="background:#e3f2fd;color:#1565c0">🏭</span>
                    تب سوم: انواع مصرف‌کننده
                </div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>دسته‌بندی:</strong> هر نوع مصرف‌کننده در یکی از دسته‌های خانگی، تجاری، صنعتی، کشاورزی یا سایر قرار می‌گیرد.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>مدل محاسبه:</strong> چهار مدل پشتیبانی می‌شود:</span></div>
                <div class="bll-hlp-sub">
                    <div><strong>پلکانی (Tiered):</strong> مصرف به پله‌هایی با ضرایب فزاینده تقسیم می‌شود. هرچه مصرف بیشتر باشد، نرخ هر پله بالاتر می‌رود (۵ پله با ضرایب ۰.۱۴۶ تا ۵.۰). مناسب مصرف‌کنندگان خانگی و تجاری کوچک.</div>
                    <div><strong>سه‌زمانه (TOU):</strong> شبانه‌روز به سه بازه کم‌باری، میان‌باری و اوج‌باری با ضرایب ۰.۵، ۱.۰ و ۲.۰ تقسیم می‌شود. نرخ نهایی = نرخ پایه ECA × ضریب ECA × ضریب TOU. مناسب صنایع و مراکز بزرگ.</div>
                    <div><strong>تخت (Flat):</strong> یک نرخ ثابت برای تمام kWhها. ساده‌ترین روش.</div>
                    <div><strong>ترکیبی (TOU+Tiered):</strong> دقیق‌ترین روش. ابتدا نرخ پایه با ضریب ECA و ضرایب TOU محاسبه می‌شود، سپس پله‌های مصرف اعمال و هزینه بین بازه‌های TOU به نسبت سهم هر بازه توزیع می‌شود. مناسب مراکز صنعتی بزرگ.</div>
                </div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>ضریب ECA:</strong> ضریب مخصوص هر نوع مصرف‌کننده که در روش خودکار (ECA) در فرمول نرخ‌دهی استفاده می‌شود. این ضریب توسط وزارت نیرو برای هر دسته از مشترکین تعیین می‌شود و نشان‌دهنده سوبسید یا هزینه اضافی هر دسته است. مقادیر معمول بین ۰.۵ تا ۱.۵ است.</span></div>

                <div class="bll-hlp-sep"></div>
                <div class="bll-hlp-tab-t">
                    <span class="bll-hlp-tab-i" style="background:#fce4ec;color:#c62828">📅</span>
                    تب چهارم: نرخ پایه سالانه
                </div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>نرخ پایه برق</strong> مبلغ پایه (به ریال بر kWh) است که هر سال توسط وزارت نیرو ابلاغ و در سامانه ثبت می‌شود. مأخذ (سند) مربوطه را می‌توان ثبت کرد.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>کاربرد:</strong> نرخ پایه در روش خودکار (ECA) به عنوان مبنا استفاده می‌شود. هنگام محاسبه صورتحساب، اگر تعرفه در سال خاصی تعریف شده باشد از نرخ پایه همان سال استفاده می‌کند. در غیر این صورت ابتدا سال جاری شمسی و در نهایت آخرین سال ثبت‌شده به کار می‌رود.</span></div>

                <div class="bll-hlp-sep"></div>
                <div class="bll-hlp-tab-t">
                    <span class="bll-hlp-tab-i" style="background:#f3e5f5;color:#6a1b9a">📐</span>
                    مفاهیم پیشرفته
                </div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>ضریب ECA چیست؟</strong> ضریب ECA (Energy Cost Adjustment) یک ضریب اصلاحی است که توسط وزارت نیرو برای تعدیل نرخ برق بر اساس هزینه واقعی تأمین انرژی تعیین می‌شود. این ضریب به صورت ماهانه یا فصلی ابلاغ می‌شود و در روش خودکار (ECA) در محاسبه نرخ نهایی ضرب می‌شود: <strong>نرخ نهایی = نرخ پایه × ضریب ECA × ضریب TOU</strong>.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>جریمه اوج مصرف:</strong> درصدی از مصرف در ساعات اوج‌باری که به عنوان جریمه به صورتحساب اضافه می‌شود. این جریمه برای تشویق به انتقال مصرف به ساعات کم‌باری طراحی شده است.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>تخفیف کم‌باری:</strong> درصدی از مصرف در ساعات کم‌باری که به عنوان تخفیف از صورتحساب کسر می‌شود. مشوقی برای مصرف در ساعات غیر اوج.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>قانون ماده ۱۶:</strong> درصدی از مبلغ صورتحساب (معمولاً ۱٪) که به منظور توسعه صنعت برق کشور طبق قانون بودجه اخذ می‌شود.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>عوارض:</strong> درصدی از مبلغ صورتحساب (معمولاً ۵٪) که تحت عنوان عوارض برق توسط شرکت توزیع دریافت می‌شود.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>جریمه و پاداش راکتیو:</strong> ضریب توان (Power Factor یا PF) نشان‌دهنده بهره‌وری مصرف انرژی است. PF نزدیک به ۱ نشان‌دهنده مصرف بهینه است. اگر PF از آستانه تعیین‌شده در تعرفه کمتر باشد (مثلاً کمتر از ۰.۹)، جریمه راکتیو محاسبه می‌شود. اگر PF بالاتر از آستانه باشد، پاداش راکتیو تعلق می‌گیرد.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>دیماند:</strong> حداکثر توان مصرفی (بر حسب کیلووات) در دوره صورتحساب. برخی تعرفه‌ها (به ویژه صنعتی) دارای هزینه دیماند هستند که بر اساس حداکثر توان مصرفی محاسبه می‌شود.</span></div>
                <div class="bll-hlp-step"><span class="bll-hlp-n">▸</span><span><strong>خودکار شدن سال:</strong> اگر تعرفه در حالت ECA باشد ولی سال آن مشخص نباشد (تعرفه دستی)، سامانه ابتدا سال جاری شمسی را برای نرخ پایه جستجو می‌کند. اگر نرخ پایه‌ای برای سال جاری ثبت نشده باشد، آخرین سال ثبت‌شده در بانک اطلاعاتی را به کار می‌گیرد. این مکانیزم باعث می‌شود تعرفه‌های ECA بدون نیاز به به‌روزرسانی سالانه کار کنند.</span></div>
                <div class="bll-hlp-tip">💡 نکته: صورت‌حساب محاسبه‌شده در تب اول، نتیجه نهایی اعمال همه این مفاهیم است. پیشنهاد می‌شود ابتدا "نوع مصرف‌کننده" و "نرخ پایه سالانه" را تنظیم کنید، سپس "تعرفه" را تعریف کنید و در نهایت صورتحساب را محاسبه نمایید.</div>
            </div>
            <div class="bll-mf"><button class="bll-btn bll-btn-outline" @onclick="() => _showHelp = false">متوجه شدم</button></div>
        </div>
    </div>
}

@* Tariff Modal *@
@if (_showModal)
{
    <div class="bll-overlay" @onclick="CloseModal">
        <div class="bll-modal bll-modal--wide" @onclick:stopPropagation>
            <div class="bll-mh">
                <span class="bll-mh-t">@(_editingId == Guid.Empty ? "تعرفه جدید" : "ویرایش تعرفه")</span>
                <button class="bll-mh-x" @onclick="CloseModal">&times;</button>
            </div>
            <div class="bll-mb">
                <div class="bll-modal-grid">
                    <div class="bll-fg"><label class="bll-fl">نام تعرفه</label><input class="bll-fi" @bind="_form.Name" /></div>
                    <div class="bll-fg"><label class="bll-fl">وضعیت</label><select class="bll-fi" @bind="_form.IsActive"><option value="@true">فعال</option><option value="@false">غیرفعال</option></select></div>
                    <div class="bll-fg"><label class="bll-fl">توضیحات</label><input class="bll-fi" @bind="_form.Description" /></div>
                    <div class="bll-fg"><label class="bll-fl">روش محاسبه</label><select class="bll-fi" @bind="_form.RateDerivationMode"><option value="Manual">دستی (ثابت)</option><option value="Automatic">خودکار (ECA)</option></select></div>
                    @if (_form.RateDerivationMode == "Automatic")
                    {
                        <div class="bll-fg"><label class="bll-fl">نوع مصرف‌کننده</label><select class="bll-fi" @bind="_form.ConsumerTypeCode"><option value="">انتخاب کنید</option>@foreach (var ct in _consumerTypes) { <option value="@ct.Code">@ct.Name</option> }</select></div>
                        <div class="bll-fg"><label class="bll-fl">سال</label><select class="bll-fi" @bind="_form.Year"><option value="">انتخاب کنید</option>@foreach (var yr in _yearlyRates) { <option value="@yr.Year">@yr.Year</option> }</select></div>
                    }

                </div>

                <div class="bll-modal-sub">تابستان (ماه ۴ تا ۹)</div>
                <div class="bll-modal-grid bll-modal-grid--6">
                    <div class="bll-fg"><label class="bll-fl">کم‌باری از</label><input class="bll-fi" @bind="_form.SummerOffPeakStart" /></div>
                    <div class="bll-fg"><label class="bll-fl">کم‌باری تا</label><input class="bll-fi" @bind="_form.SummerOffPeakEnd" /></div>
                    <div class="bll-fg"><label class="bll-fl">میان‌باری از</label><input class="bll-fi" @bind="_form.SummerMidPeakStart" /></div>
                    <div class="bll-fg"><label class="bll-fl">میان‌باری تا</label><input class="bll-fi" @bind="_form.SummerMidPeakEnd" /></div>
                    <div class="bll-fg"><label class="bll-fl">اوج‌باری از</label><input class="bll-fi" @bind="_form.SummerPeakStart" /></div>
                    <div class="bll-fg"><label class="bll-fl">اوج‌باری تا</label><input class="bll-fi" @bind="_form.SummerPeakEnd" /></div>
                </div>

                <div class="bll-modal-sub">زمستان (ماه ۱ تا ۳ و ۱۰ تا ۱۲)</div>
                <div class="bll-modal-grid bll-modal-grid--6">
                    <div class="bll-fg"><label class="bll-fl">کم‌باری از</label><input class="bll-fi" @bind="_form.WinterOffPeakStart" /></div>
                    <div class="bll-fg"><label class="bll-fl">کم‌باری تا</label><input class="bll-fi" @bind="_form.WinterOffPeakEnd" /></div>
                    <div class="bll-fg"><label class="bll-fl">میان‌باری از</label><input class="bll-fi" @bind="_form.WinterMidPeakStart" /></div>
                    <div class="bll-fg"><label class="bll-fl">میان‌باری تا</label><input class="bll-fi" @bind="_form.WinterMidPeakEnd" /></div>
                    <div class="bll-fg"><label class="bll-fl">اوج‌باری از</label><input class="bll-fi" @bind="_form.WinterPeakStart" /></div>
                    <div class="bll-fg"><label class="bll-fl">اوج‌باری تا</label><input class="bll-fi" @bind="_form.WinterPeakEnd" /></div>
                </div>

                @if (_form.RateDerivationMode == "Manual")
                {
                    <div class="bll-modal-sub">نرخ‌ها (دستی)</div>
                    <div class="bll-modal-grid">
                        <div class="bll-fg"><label class="bll-fl">کم‌باری (ریال)</label><input class="bll-fi" type="number" @bind="_form.OffPeakRate" /></div>
                        <div class="bll-fg"><label class="bll-fl">میان‌باری (ریال)</label><input class="bll-fi" type="number" @bind="_form.MidPeakRate" /></div>
                        <div class="bll-fg"><label class="bll-fl">اوج‌باری (ریال)</label><input class="bll-fi" type="number" @bind="_form.PeakRate" /></div>
                    </div>
                }
                else
                {
                    <div class="bll-modal-sub">نرخ‌ها (محاسبه خودکار — نمایش)</div>
                    <div class="bll-modal-grid">
                        <div class="bll-fg"><label class="bll-fl">نرخ پایه ECA</label><input class="bll-fi" disabled="disabled" value="@GetBaseRateDisplay()" /></div>
                        <div class="bll-fg"><label class="bll-fl">ضریب TOU کم‌باری</label><input class="bll-fi" disabled="disabled" value="0.5" /></div>
                        <div class="bll-fg"><label class="bll-fl">ضریب TOU میان‌باری</label><input class="bll-fi" disabled="disabled" value="1.0" /></div>
                        <div class="bll-fg"><label class="bll-fl">ضریب TOU اوج‌باری</label><input class="bll-fi" disabled="disabled" value="2.0" /></div>
                    </div>
                }

                <div class="bll-modal-sub">سایر تنظیمات</div>
                <div class="bll-modal-grid">
                    <div class="bll-fg"><label class="bll-fl">آبونمان ماهانه</label><input class="bll-fi" type="number" @bind="_form.MonthlyFixedFee" /></div>
                    <div class="bll-fg"><label class="bll-fl">آستانه جریمه PF</label><input class="bll-fi" type="number" step="0.01" @bind="_form.ReactivePenaltyThreshold" /></div>
                    <div class="bll-fg"><label class="bll-fl">ضریب جریمه</label><input class="bll-fi" type="number" step="0.1" @bind="_form.ReactivePenaltyMultiplier" /></div>
                </div>
            </div>
            <div class="bll-mf">
                <button class="bll-btn bll-btn-outline" @onclick="CloseModal">انصراف</button>
                <button class="bll-btn bll-btn-blue" @onclick="SaveTariff">@(_saving ? "ذخیره..." : "ذخیره")</button>
            </div>
        </div>
    </div>
}

@* Delete Confirmation *@
@if (_deleteTarget is not null)
