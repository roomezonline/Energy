    private void ToggleOverrideMode() => _showOverrideEditor = !_showOverrideEditor;

    private void OnOverrideChange(string field, decimal value)
    {
        var item = _billData?.EditableItems?.FirstOrDefault(i => i.FieldName == field);
        if (item is not null) item.OverrideValue = value;
    }

    private void OnOverrideReasonChange(string field, string? reason)
    {
        var item = _billData?.EditableItems?.FirstOrDefault(i => i.FieldName == field);
        if (item is not null) item.OverrideReason = reason ?? "";
    }

    // Tariff CRUD
