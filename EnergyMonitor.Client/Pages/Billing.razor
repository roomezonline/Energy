    private int GetCurrentPersianYear()
    {
        var pc = new System.Globalization.PersianCalendar();
        var iranTz = TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran");
        var iranNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, iranTz);
        return pc.GetYear(iranNow);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var pc = new System.Globalization.PersianCalendar();
            var iranTz = TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran");
            var iranNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, iranTz);
            _billTo = $"{pc.GetYear(iranNow):D4}/{pc.GetMonth(iranNow):D2}/{pc.GetDayOfMonth(iranNow):D2}";
            var from = iranNow.AddDays(-30);
            _billFrom = $"{pc.GetYear(from):D4}/{pc.GetMonth(from):D2}/{pc.GetDayOfMonth(from):D2}";
            StateHasChanged();
        }
    }

