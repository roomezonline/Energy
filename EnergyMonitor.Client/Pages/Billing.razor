    private string P(decimal? value, string format = "N0") => value.HasValue ? ToPersian(value.Value.ToString(format)) : "";
    private string P(decimal value, string format = "N0") => ToPersian(value.ToString(format));
    private string P(int? value, string format = "N0") => value.HasValue ? ToPersian(value.Value.ToString(format)) : "";
    private string P(int value, string format = "N0") => ToPersian(value.ToString(format));
    private string P(DateTime? value, string format = "yyyy/MM/dd HH:mm") => value.HasValue ? ToPersian(value.Value.ToString(format)) : "";
    private string P(DateTime value, string format = "yyyy/MM/dd HH:mm") => ToPersian(value.ToString(format));
    private static string ToPersian(string s)
    {
        if (string.IsNullOrEmpty(s)) return s;
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (var c in s) { if (c >= '0' && c <= '9') sb.Append((char)('۰' + (c - '0'))); else sb.Append(c); }
        return sb.ToString();
    }

